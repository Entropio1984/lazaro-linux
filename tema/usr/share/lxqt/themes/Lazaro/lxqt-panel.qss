/*
 * Barra de LXQt con los colores de Lázaro: azul noche, texto claro y
 * detalles celestes. Lo que no está aquí lo dibuja el estilo de Qt.
 */

LXQtPanel #BackgroundWidget {
    background: #0a1f36;
}

QToolTip {
    border: 1px solid #29b6f6;
    background: #12324f;
    color: #eef4fb;
    padding: 3px;
}

Plugin, LXQtPanelPlugin {
    padding: 0;
    qproperty-moveMarkerColor: #29b6f6;
}

Plugin > QWidget,
Plugin > QWidget > QWidget {
    color: #e6eef8;
}

Plugin > QToolButton,
Plugin > QWidget > QToolButton,
Plugin > QWidget > QToolButton > QWidget > QToolButton,
LXQtPanelPlugin > QToolButton {
    margin: 0;
    border: 1px solid transparent;
    border-radius: 4px;
    color: #e6eef8;
}

Plugin > QToolButton:hover,
Plugin > QWidget > QToolButton:hover,
LXQtPanelPlugin > QToolButton:hover {
    background: rgba(41, 182, 246, 25%);
}

Plugin > QToolButton:pressed,
Plugin > QWidget > QToolButton:pressed,
LXQtPanelPlugin > QToolButton:pressed {
    background: rgba(41, 182, 246, 40%);
}

/* Botón del menú de aplicaciones: el pulso de Lázaro. */
#MainMenu {
    qproperty-icon: url(mainmenu.svg);
    margin: 2px;
    padding: 2px;
}

/* Ventanas abiertas: la activa con una raya celeste abajo. */
LXQtTaskButton {
    color: #e6eef8;
    border: none;
    border-radius: 4px;
    padding: 2px 6px;
}
LXQtTaskButton:hover {
    background: rgba(41, 182, 246, 20%);
}
LXQtTaskButton:checked {
    background: rgba(41, 182, 246, 30%);
    border-bottom: 3px solid #29b6f6;
}

/* Escritorios virtuales. */
#DesktopSwitch QToolButton {
    color: #e6eef8;
    border-radius: 3px;
}
#DesktopSwitch QToolButton:checked {
    background: #1a7fd0;
}

/* Menús. */
QMenu {
    background: #0f2742;
    border: 1px solid #12324f;
    color: #eef4fb;
    padding: 3px;
}
QMenu::item {
    padding: 6px 30px 6px 24px;
    background: transparent;
    color: #eef4fb;
}
QMenu::item:selected {
    background: #1a7fd0;
    color: #ffffff;
    border-radius: 3px;
}
QMenu::item:disabled {
    color: #7d8ea3;
}
QMenu::separator {
    background: #1d3d60;
    height: 1px;
    margin: 3px 6px;
}
QMenu QLineEdit {
    background: #0b1f36;
    color: #eef4fb;
    border: 1px solid #1d3d60;
    border-radius: 3px;
    padding: 3px;
}

/* Reloj y calendario. */
#WorldClock, #WorldClockContent {
    color: #e6eef8;
}
