#!/bin/sh
# lazaro-instalar-texto: instalador de Lázaro Linux en modo texto, para
# cuando la sesión gráfica no abre (por ejemplo en equipos con poca
# memoria o con una tarjeta gráfica sin controlador). Hace las mismas
# preguntas que Calamares con menús de "dialog" (flechas, espacio y
# Enter) y luego llama a "lazaro-instalar texto", que borra el disco
# elegido y hace la misma instalación que el instalador gráfico.
#
# Uso (como root, o con doas):
#   lazaro-instalar-texto

set -eu

if [ "$(id -u)" -ne 0 ]; then
	exec doas "$0" "$@"
fi

export LANG="${LANG:-es_ES.UTF-8}"
case "$LANG" in C|C.*|POSIX) LANG=es_ES.UTF-8 ;; esac
# Textos en el idioma de la sesión (idiomas/*.po); sin traducción, español.
if [ -r "${LAZARO_TEXTO_DIR:-/usr/share/lazaro}/texto.sh" ]; then . "${LAZARO_TEXTO_DIR:-/usr/share/lazaro}/texto.sh"; else _() { printf '%b' "$1"; }; fi
TITULO="$(_ 'Instalar Lázaro Linux')"
# Edición de la ISO (ligera o completa), que deja build.sh.
LAZARO_EDICION=ligera
. /usr/share/lazaro/version.env 2>/dev/null || true

# dialog con los botones en el idioma de la sesión.
dlg() {
	dialog --backtitle "$TITULO" --ok-label "$(_ Aceptar)" --cancel-label "$(_ Cancelar)" \
		--yes-label "$(_ Sí)" --no-label "$(_ No)" "$@"
}

# dialog dibuja en la pantalla y escribe la respuesta en la salida de
# errores, que aquí pasa a ser la salida normal para guardarla.
pedir() {
	# shellcheck disable=SC2069
	dlg "$@" 2>&1 >/dev/tty
}

cancelar() {
	clear
	_ 'Instalación cancelada. No se cambió nada en el disco.'; echo
	_ 'Para empezar de nuevo, escribe: doas lazaro-instalar-texto'; echo
	exit 1
}

command -v dialog >/dev/null 2>&1 || {
	echo "Falta el programa dialog; no se puede mostrar el instalador." >&2
	exit 1
}

dlg --title "$(_ 'Bienvenida')" --msgbox \
"$(_ 'Este instalador funciona sin escritorio, desde esta pantalla.

Se maneja con el teclado:
  - flechas arriba y abajo para moverte,
  - barra espaciadora para marcar o desmarcar,
  - Tab para pasar a los botones,
  - Enter para aceptar.

Al final verás un resumen y nada se borra hasta que confirmes.')" 16 64 || cancelar

# --- Disco ---------------------------------------------------------------
# Discos donde se puede instalar: ni el USB o DVD de la live (tiene algo
# montado) ni discos virtuales del sistema.
discos() {
	for b in /sys/block/*; do
		n="${b##*/}"
		case "$n" in loop*|ram*|zram*|sr*|fd*|dm-*|md*|nbd*|mmcblk*boot*|mmcblk*rpmb) continue ;; esac
		[ -r "$b/size" ] || continue
		if awk -v d="/dev/$n" 'index($1, d) == 1 && substr($1, length(d) + 1) ~ /^(p?[0-9]+)?$/ { f = 1 } END { exit !f }' /proc/mounts; then
			continue
		fi
		gb=$(awk -v s="$(cat "$b/size")" 'BEGIN { printf "%d", s * 512 / 1000000000 + 0.5 }')
		[ "$gb" -ge 8 ] || continue
		modelo=$(cat "$b/device/model" 2>/dev/null | sed 's/ *$//')
		printf '/dev/%s\n%s GB %s\n' "$n" "$gb" "${modelo:-disco}"
	done
}
lista=$(discos)
if [ -z "$lista" ]; then
	dlg --title "$(_ 'Sin discos')" --msgbox \
"$(_ 'No encontré ningún disco de 8 GB o más donde instalar (el USB de Lázaro no cuenta).

Revisa que el disco esté conectado y vuelve a intentarlo.')" 10 60
	cancelar
fi
# Una entrada por disco: "/dev/sda" "120 GB modelo".
set --
while IFS= read -r dev && IFS= read -r desc; do
	set -- "$@" "$dev" "$desc"
done <<EOF
$lista
EOF
disco=$(pedir --title "$(_ 'Disco')" --menu \
"$(_ '¿En qué disco instalo Lázaro Linux?

ATENCIÓN: se borrará TODO lo que tenga ese disco (otros sistemas, fotos, documentos).')" \
	16 64 6 "$@") || cancelar

# --- Escritorio ------------------------------------------------------------
rec=xfce
[ -r /run/lazaro/recomendacion ] && rec=$(sed -n 's/^ESCRITORIO=//p' /run/lazaro/recomendacion)
marca() { [ "$1" = "$rec" ] && echo on || echo off; }
sufijo() { [ "$1" = "$rec" ] && echo " $(_ '(recomendado)')" || true; }
pregunta="$(_ '¿Qué escritorio quieres? GNOME y Plasma se descargan de internet; los demás vienen en el USB.')"
[ "$LAZARO_EDICION" != completa ] || pregunta="$(_ '¿Qué escritorio quieres? Todos vienen en el USB: no hace falta internet.')"
# ISO de 32 bits: solo XFCE y LXQt, los dos en el USB.
bits32=no
[ "$(apk --print-arch 2>/dev/null)" != x86 ] || bits32=si
while :; do
	if [ "$bits32" = si ]; then
		escritorio=$(pedir --title "$(_ 'Escritorio')" --radiolist "$(_ '¿Qué escritorio quieres? Todos vienen en el USB: no hace falta internet.')" \
			12 70 3 \
			xfce "$(_ 'XFCE: liviano y clásico')$(sufijo xfce)" "$(marca xfce)" \
			lxqt "$(_ 'LXQt: el más liviano, para poca memoria')$(sufijo lxqt)" "$(marca lxqt)" \
			ninguno "$(_ 'Sin escritorio: solo la consola')$(sufijo ninguno)" "$(marca ninguno)") || cancelar
		break
	fi
	escritorio=$(pedir --title "$(_ 'Escritorio')" --radiolist "$pregunta" \
		18 70 8 \
		xfce "$(_ 'XFCE: liviano y clásico')$(sufijo xfce)" "$(marca xfce)" \
		lxqt "$(_ 'LXQt: el más liviano, para poca memoria')$(sufijo lxqt)" "$(marca lxqt)" \
		mate "$(_ 'MATE: clásico, sencillo')$(sufijo mate)" "$(marca mate)" \
		gnome "$(_ 'GNOME: moderno, pide 4 GB y gráfica con 3D')$(sufijo gnome)" "$(marca gnome)" \
		plasma "$(_ 'Plasma (KDE): completo, pide 4 GB')$(sufijo plasma)" "$(marca plasma)" \
		sway "$(_ 'Sway: ventanas en mosaico, con teclado')$(sufijo sway)" "$(marca sway)" \
		xfce-wayland "$(_ 'XFCE Wayland (experimental)')$(sufijo xfce-wayland)" "$(marca xfce-wayland)" \
		ninguno "$(_ 'Sin escritorio: solo la consola')$(sufijo ninguno)" "$(marca ninguno)") || cancelar
	case "$escritorio" in xfce|mate|lxqt|sway|xfce-wayland|ninguno) break ;; esac
	[ "$LAZARO_EDICION" != completa ] || break
	dlg --infobox "$(_ 'Revisando la conexión a internet...')" 5 50
	lazaro-instalar red >/dev/null 2>&1 && break
	dlg --title "$(_ 'Sin internet')" --msgbox \
"$(_ 'Ese escritorio se descarga de internet y no hay conexión.

Conecta el cable de red, o elige otro escritorio: todos menos
GNOME y Plasma se instalan sin internet.

Para usar wifi: cancela, escribe
  nmcli device wifi connect "NOMBRE DE LA RED" password "CLAVE"
(con las comillas)
y vuelve a abrir el instalador.')" 14 70
done

# --- Programas adicionales ------------------------------------------------
extras="base"
if [ "$escritorio" = ninguno ]; then
	# Sin escritorio solo sirven los programas de consola.
	elegidos=$(pedir --title "$(_ 'Software adicional')" --separate-output --checklist \
"$(_ 'Marca con la barra espaciadora lo que quieras instalar.')" \
		11 72 2 \
		fastfetch "$(_ 'Fastfetch: resumen del equipo en la terminal')" off \
		btop "$(_ 'Btop: monitor de recursos')" off) || cancelar
elif [ "$bits32" = si ]; then
	# Sin Flatpak (Flathub no tiene aplicaciones de 32 bits). NetSurf va
	# siempre; Firefox es opcional.
	elegidos=$(pedir --title "$(_ 'Software adicional')" --separate-output --checklist \
"$(_ 'Marca con la barra espaciadora lo que quieras instalar.')" \
		16 76 6 \
		firefox "Firefox" on \
		fastfetch "$(_ 'Fastfetch: resumen del equipo en la terminal')" off \
		btop "$(_ 'Btop: monitor de recursos')" off \
		vlc "$(_ 'VLC: reproductor de video y música')" off \
		youtube "$(_ 'YouTube ligero: videos sin navegador (480p)')" on \
		libreoffice "$(_ 'LibreOffice: oficina (documentos, hojas de cálculo)')" off) || cancelar
else
	flat=on
	fp_usb=", $(_ 'necesita internet')"
	[ "$LAZARO_EDICION" != completa ] || fp_usb=", $(_ 'viene en el USB')"
	[ -r /run/lazaro/recomendacion ] && grep -qx 'DISCO_PEQUENO=si' /run/lazaro/recomendacion && flat=off
	elegidos=$(pedir --title "$(_ 'Software adicional')" --separate-output --checklist \
"$(_ 'Marca con la barra espaciadora lo que quieras instalar. Firefox se instala siempre.')" \
		19 76 9 \
		fastfetch "$(_ 'Fastfetch: resumen del equipo en la terminal')" off \
		btop "$(_ 'Btop: monitor de recursos')" off \
		vlc "$(_ 'VLC: reproductor de video y música')" off \
		youtube "$(_ 'YouTube ligero: videos sin navegador (480p)')" on \
		libreoffice "$(_ 'LibreOffice: oficina (documentos, hojas de cálculo)')" off \
		flatpak "$(_ 'Flatpak con Flathub: tienda de aplicaciones')" "$flat" \
		onlyoffice "OnlyOffice (Flathub$fp_usb)" off \
		chrome "Google Chrome (Flathub, $(_ 'necesita internet'))" off \
		brave "Brave (Flathub$fp_usb)" off) || cancelar
fi
for e in $elegidos; do extras="$extras $e"; done

# --- Idioma, teclado y zona horaria ----------------------------------------
idioma=$(pedir --title "$(_ 'Idioma')" --default-item es_CO.UTF-8 --menu "$(_ 'Idioma del sistema:')" 17 50 9 \
	es_CO.UTF-8 "Español (Colombia)" \
	es_MX.UTF-8 "Español (México)" \
	es_AR.UTF-8 "Español (Argentina)" \
	es_CL.UTF-8 "Español (Chile)" \
	es_PE.UTF-8 "Español (Perú)" \
	es_VE.UTF-8 "Español (Venezuela)" \
	es_ES.UTF-8 "Español (España)" \
	en_US.UTF-8 "English (US)" \
	pt_BR.UTF-8 "Português (Brasil)") || cancelar

tecla=$(pedir --title "$(_ 'Teclado')" --menu "$(_ 'Distribución del teclado (la tecla Ñ y los acentos):')" 14 60 5 \
	"latam" "$(_ 'Latinoamericano')" \
	"es" "$(_ 'Español (España)')" \
	"us" "$(_ 'Inglés (EE. UU.)')" \
	"us intl" "$(_ 'Inglés internacional (con acentos)')" \
	"br" "$(_ 'Portugués de Brasil (ABNT2)')") || cancelar
teclado="${tecla%% *}"
variante=""
[ "$tecla" = "us intl" ] && variante=intl

case "$idioma" in
	es_CO*) zona_def=America/Bogota ;;
	es_MX*) zona_def=America/Mexico_City ;;
	es_AR*) zona_def=America/Argentina/Buenos_Aires ;;
	es_CL*) zona_def=America/Santiago ;;
	es_PE*) zona_def=America/Lima ;;
	es_VE*) zona_def=America/Caracas ;;
	es_ES*) zona_def=Europe/Madrid ;;
	pt_BR*) zona_def=America/Sao_Paulo ;;
	*) zona_def=America/New_York ;;
esac
while :; do
	zona=$(pedir --title "$(_ 'Zona horaria')" --inputbox \
"$(_ 'Zona horaria (para la hora del reloj). Si no sabes, deja la propuesta:')" 10 64 "$zona_def") || cancelar
	[ -e "/usr/share/zoneinfo/$zona" ] && break
	dlg --msgbox "$(printf "$(_ 'No conozco la zona "%s". Ejemplos: America/Bogota, Europe/Madrid.')" "$zona")" 8 60
done

# --- Usuario ----------------------------------------------------------------
nombre=$(pedir --title "$(_ 'Usuario')" --inputbox "$(_ 'Tu nombre (como quieres que aparezca):')" 9 60 "") || cancelar
sugerido=$(printf '%s' "${nombre%% *}" | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9')
while :; do
	usuario=$(pedir --title "$(_ 'Usuario')" --inputbox \
"$(_ 'Nombre de usuario para entrar (minúsculas y números, sin espacios):')" 9 64 "$sugerido") || cancelar
	case "$usuario" in
		root|lazaro|"") dlg --msgbox "$(_ 'Ese nombre no se puede usar; elige otro.')" 7 50 ;;
		[a-z]*) printf '%s' "$usuario" | grep -qx '[a-z][a-z0-9_-]*' && break
			dlg --msgbox "$(_ 'Usa solo minúsculas, números, - y _, empezando con una letra.')" 7 64 ;;
		*) dlg --msgbox "$(_ 'Debe empezar con una letra minúscula.')" 7 50 ;;
	esac
done
while :; do
	clave=$(pedir --title "$(_ 'Contraseña')" --insecure --passwordbox \
"$(printf "$(_ 'Contraseña de %s (mínimo 4 caracteres). También será la de administrador:')" "$usuario")" 10 64) || cancelar
	clave2=$(pedir --title "$(_ 'Contraseña')" --insecure --passwordbox "$(_ 'Escríbela otra vez:')" 9 64) || cancelar
	if [ "${#clave}" -lt 4 ]; then
		dlg --msgbox "$(_ 'La contraseña debe tener al menos 4 caracteres.')" 7 54
	elif [ "$clave" != "$clave2" ]; then
		dlg --msgbox "$(_ 'Las dos contraseñas no coinciden. Inténtalo de nuevo.')" 7 58
	else
		break
	fi
done
equipo=$(pedir --title "$(_ 'Nombre del equipo')" --inputbox \
"$(_ 'Nombre del equipo en la red:')" 9 60 "lazaro-$usuario") || cancelar
equipo=$(printf '%s' "$equipo" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9-\n' '-' | cut -c1-63)
[ -n "$equipo" ] || equipo=lazaro

# --- Resumen ----------------------------------------------------------------
tam=$(printf '%s\n' "$lista" | grep -A1 -x "$disco" | sed -n 2p)
dlg --title "$(_ 'Resumen')" --no-collapse --defaultno --yesno \
"$(printf "$(_ 'Revisa antes de instalar:

  Disco:       %s (%s)  <- SE BORRA COMPLETO
  Escritorio:  %s
  Programas:   %s
  Idioma:      %s
  Teclado:     %s
  Zona:        %s
  Usuario:     %s (%s)
  Equipo:      %s

¿Borro el disco e instalo?')" "$disco" "$tam" "$escritorio" "${extras#base}" "$idioma" "$tecla" "$zona" "$usuario" "$nombre" "$equipo")" 20 70 || cancelar

clear
printf "$(_ 'Instalando Lázaro Linux en %s. Esto puede tardar bastante;\nno apagues el equipo. El detalle queda en /var/log/lazaro-instalar.log.')\n" "$disco"
echo
rc=0
LAZARO_CLAVE="$clave" lazaro-instalar texto "$disco" "$escritorio" "$usuario" \
	"${nombre:-$usuario}" "$equipo" "$idioma" "$teclado" "$variante" "$zona" "$extras" || rc=$?
clave=""; clave2=""
echo
if [ "$rc" -eq 0 ]; then
	if dlg --title "$(_ 'Listo')" --yesno \
"$(_ 'Lázaro Linux quedó instalado.

Saca el USB y reinicia el equipo. ¿Reinicio ahora?')" 10 56; then
		reboot
	fi
else
	printf "$(_ 'La instalación falló (código %s). Las últimas líneas del registro:')\n" "$rc"
	tail -n 20 /var/log/lazaro-instalar.log 2>/dev/null || true
	echo
	_ 'Puedes sacarle una foto a esta pantalla para pedir ayuda.'; echo
	exit "$rc"
fi
