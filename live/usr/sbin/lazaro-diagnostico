#!/bin/sh
# lazaro-diagnostico: junta en un archivo de texto la información de un
# equipo con Lázaro Linux (instalación, hardware, estado actual y errores
# del arranque) para compartirla al pedir ayuda.
#
# Uso, en una terminal (en la sesión live o en el sistema instalado):
#   lazaro-diagnostico
# Con ventanas (botón de la Bienvenida): lazaro-diagnostico --ventana
# En el sistema instalado pide la contraseña (doas) porque varios
# registros solo los lee root; en la sesión live no la pide.
#
# Resultado: ~/lazaro-diagnostico-AAAAMMDD-HHMMSS.txt, en la carpeta
# personal de quien lo ejecuta: fácil de encontrar y de adjuntar, y de esa
# persona (no de root). En la sesión live esa carpeta vive en la memoria y
# se pierde al apagar: copia el archivo a otro USB o envíalo antes.
# No guarda contraseñas: no lee /etc/shadow ni las claves del wifi.
# Textos en el idioma de la sesión (idiomas/*.po); sin traducción, español.
if [ -r "${LAZARO_TEXTO_DIR:-/usr/share/lazaro}/texto.sh" ]; then . "${LAZARO_TEXTO_DIR:-/usr/share/lazaro}/texto.sh"; else _() { printf '%b' "$1"; }; fi

# Plan B de --ventana, si zenity no puede abrir ventanas: el mismo
# informe en una terminal del escritorio (pide la contraseña ahí mismo).
diagnostico_en_terminal() {
	_dt_yo="$0"
	case "$_dt_yo" in /*) ;; *) _dt_yo="$PWD/$_dt_yo" ;; esac
	_dt_guion="$(mktemp)" || return 1
	{
		printf 'sh %s\n' "'$_dt_yo'"
		echo 'echo'
		printf "printf '%%s' '%s'\n" "$(_ 'Pulsa Intro para cerrar esta ventana.' | sed "s/'/'\\\\''/g")"
		echo 'read _'
		printf 'rm -f %s\n' "'$_dt_guion'"
	} > "$_dt_guion"
	for _dt in xfce4-terminal mate-terminal lxterminal qterminal konsole gnome-terminal kgx foot xterm; do
		command -v "$_dt" >/dev/null 2>&1 || continue
		echo "Se abre $_dt" >> "${registro:-/dev/null}"
		# Cada terminal recibe la orden a su manera; si una no arranca, se
		# prueba la siguiente.
		case "$_dt" in
			xfce4-terminal|mate-terminal) "$_dt" -x sh "$_dt_guion" ;;
			lxterminal|qterminal) "$_dt" -e "sh $_dt_guion" ;;
			gnome-terminal|kgx) "$_dt" -- sh "$_dt_guion" ;;
			foot) foot sh "$_dt_guion" ;;
			*) "$_dt" -e sh "$_dt_guion" ;;
		esac && return 0
		echo "$_dt no arrancó" >> "${registro:-/dev/null}"
	done
	rm -f "$_dt_guion"
	echo "No hay ninguna terminal para mostrar el diagnóstico" >> "${registro:-/dev/null}"
	return 1
}

# --ventana: lo mismo con ventanas (botón de la Bienvenida y menú): pide
# la contraseña con la ventana del escritorio (pkexec), muestra que está
# trabajando y al final dice dónde quedó el archivo.
if [ "${1:-}" = "--ventana" ]; then
	# Lo que digan las ventanas (zenity) y por qué fallan queda en
	# ~/.cache/lazaro-diagnostico-ventana.log: si no aparece nada en
	# pantalla, ahí está la causa.
	registro="$HOME/.cache/lazaro-diagnostico-ventana.log"
	mkdir -p "$(dirname "$registro")" 2>/dev/null
	{ [ -w "$(dirname "$registro")" ] && : >> "$registro"; } 2>/dev/null || registro=/dev/null
	echo "== $(date '+%F %T') $0 --ventana DISPLAY=${DISPLAY:-} WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-} LANG=${LANG:-}" >> "$registro"
	if ! command -v zenity >/dev/null 2>&1; then
		echo "Falta zenity" | tee -a "$registro" >&2
		diagnostico_en_terminal
		exit $?
	fi
	t="$(_ 'Diagnóstico de Lázaro')"
	explica="$(_ 'Revisa el equipo y reúne en un archivo de texto su hardware, el estado del sistema y los errores del arranque, para compartirlo al pedir ayuda.\n\nNo guarda contraseñas ni claves del wifi. Suele tardar menos de un minuto.')"
	# zenity: 0 = Aceptar, 1 = Cerrar (o la ventana cerrada con la X),
	# otro número = no pudo abrir la ventana. Si no pudo, se prueba sin
	# los botones con nombre propio y, si tampoco, en una terminal: el
	# botón nunca debe quedar "sin hacer nada".
	rc=0
	zenity --question --width=480 --title="$t" --ok-label="$(_ 'Crear el informe')" --cancel-label="$(_ 'Cerrar')" \
		--text="$explica" >/dev/null 2>>"$registro" || rc=$?
	if [ "$rc" -gt 1 ]; then
		echo "zenity --question terminó con $rc; se prueba sin botones propios" >> "$registro"
		rc=0
		zenity --question --title="$t" --text="$explica" >/dev/null 2>>"$registro" || rc=$?
		if [ "$rc" -gt 1 ]; then
			echo "zenity no abre ventanas ($rc); se usa una terminal" >> "$registro"
			diagnostico_en_terminal
			exit $?
		fi
	fi
	[ "$rc" = 0 ] || exit 0
	if [ "$(id -u)" = 0 ]; then como=""
	elif [ -x /usr/sbin/lazaro-instalar ]; then como="doas -n"
	elif command -v pkexec >/dev/null 2>&1; then como="pkexec"
	else como="doas"
	fi
	sal="$(mktemp)" || exit 1
	# shellcheck disable=SC2086
	( $como sh "$0" > "$sal" 2>&1; echo $? > "$sal.rc" ) |
		zenity --progress --pulsate --auto-close --no-cancel --width=380 --title="$t" \
			--text="$(_ 'Revisando el equipo…')" >/dev/null 2>>"$registro"
	rc="$(cat "$sal.rc" 2>/dev/null || echo 1)"
	# La ruta del informe, del renglón "Listo: RUTA" (que sale traducido):
	# se busca por el nombre del archivo, no por la palabra.
	informe="$(sed -n 's|^[^/]*\(/.*/lazaro-diagnostico-[0-9]*-[0-9]*\.txt\)[^/]*$|\1|p' "$sal" | tail -n 1)"
	if [ "$rc" = 0 ] && [ -n "$informe" ]; then
		nota=""
		[ ! -x /usr/sbin/lazaro-instalar ] || nota="\n\n$(_ 'Estás en la sesión de prueba (live): copia el archivo a otro USB o envíalo antes de apagar.')"
		zenity --question --width=480 --title="$t" --ok-label="$(_ 'Abrir la carpeta')" --cancel-label="$(_ 'Cerrar')" \
			--text="$(_ 'Listo. El informe quedó en:')\n\n$informe\n\n$(_ 'Adjunta ese archivo cuando pidas ayuda.')$nota" >/dev/null 2>>"$registro" &&
			xdg-open "$(dirname "$informe")" >/dev/null 2>&1
	else
		zenity --error --width=460 --title="$t" \
			--text="$(_ 'No se pudo crear el informe.')\n\n$(tail -n 3 "$sal" | sed 's/[&<>]/ /g')" >/dev/null 2>>"$registro" || true
	fi
	rm -f "$sal" "$sal.rc"
	exit 0
fi

if [ "$(id -u)" -ne 0 ]; then
	exec doas sh "$0" "$@"
fi

# Quién lo pidió: con doas, sudo o la ventana de contraseña (pkexec).
usuario="${DOAS_USER:-${SUDO_USER:-}}"
if [ -z "$usuario" ] && [ -n "${PKEXEC_UID:-}" ]; then
	usuario="$(getent passwd "$PKEXEC_UID" 2>/dev/null | cut -d: -f1)"
fi
casa="/root"
if [ -n "$usuario" ]; then
	casa="$(getent passwd "$usuario" 2>/dev/null | cut -d: -f6)"
	[ -n "$casa" ] || casa="/home/$usuario"
fi
salida="$casa/lazaro-diagnostico-$(date +%Y%m%d-%H%M%S).txt"
# El informe se arma en un archivo temporal de root (solo legible por
# root) y al final lo escribe la propia persona en su carpeta: así root
# nunca abre nada dentro de una carpeta ajena (un enlace puesto ahí no
# puede hacerle pisar un archivo del sistema).
umask 077
tmp="$(mktemp)" || { echo "No se pudo crear un archivo temporal." >&2; exit 1; }
trap 'rm -f "$tmp"' EXIT

# Cada comando se corta a los 30 s para que nada deje el script colgado.
corre() {
	if command -v "$1" >/dev/null 2>&1; then
		timeout 30 "$@" 2>&1
	else
		echo "(no está instalado: $1)"
	fi
}
seccion() { printf '\n==================== %s ====================\n' "$*"; }
archivo() { # RUTA [LÍNEAS]
	if [ -r "$1" ]; then
		echo "--- $1"
		# Sin contraseñas: una dirección como https://usuario:clave@sitio
		# queda https://***@sitio.
		if [ -n "${2:-}" ]; then tail -n "$2" "$1"; else cat "$1"; fi |
			sed 's|://[^/@[:space:]]*@|://***@|g'
	else
		echo "--- $1 (no existe)"
	fi
}
errores() { # RUTA: solo las líneas con errores o avisos (últimas 80)
	if [ -r "$1" ]; then
		echo "--- errores y avisos en $1"
		grep -iE 'error|fail|fall[oó]|warn|aviso|cannot|could not|no se pudo|denied|segfault|\(EE\)' "$1" | tail -n 80
	fi
}

_ 'Reuniendo información... (suele tardar menos de un minuto)'; echo
{
	seccion "Resumen"
	# Sello de compilación: qué ISO es (versión, edición, de qué código y
	# cuándo se compiló). Una ISO anterior a este dato dice "sin dato".
	if [ -r /usr/share/lazaro/version.env ]; then
		(
			. /usr/share/lazaro/version.env
			echo "Lázaro: ${ISO_VERSION:-sin dato}, edición ${LAZARO_EDICION:-sin dato}, ${LAZARO_CANAL:-sin dato}, Alpine ${ALPINE_BRANCH:-sin dato}"
			echo "Compilación: ${LAZARO_FECHA:-sin dato} (código ${LAZARO_COMMIT:-sin dato}, script ${LAZARO_SCRIPT_COMMIT:-sin dato})"
		)
	else
		echo "Lázaro: sin dato (no existe /usr/share/lazaro/version.env)"
	fi
	echo "Fecha: $(date)"
	echo "Equipo: $(cat /sys/class/dmi/id/sys_vendor 2>/dev/null) $(cat /sys/class/dmi/id/product_name 2>/dev/null) $(cat /sys/class/dmi/id/product_version 2>/dev/null)"
	echo "BIOS: $(cat /sys/class/dmi/id/bios_version 2>/dev/null) ($(cat /sys/class/dmi/id/bios_date 2>/dev/null))"
	echo "Arranque: $([ -d /sys/firmware/efi ] && echo UEFI || echo BIOS)"
	echo "Alpine: $(cat /etc/alpine-release 2>/dev/null)"
	echo "Núcleo: $(uname -a)"
	echo "Tiempo encendido: $(uptime)"
	echo "Procesador: $(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2) ($(grep -c ^processor /proc/cpuinfo) núcleos)"
	archivo /proc/cmdline

	seccion "Instalación de Lázaro"
	archivo /usr/share/lazaro/version.env
	for f in /run/lazaro/*; do [ -f "$f" ] && archivo "$f"; done
	for f in /etc/lazaro/*; do [ -f "$f" ] && archivo "$f"; done
	archivo /etc/apk/repositories
	archivo /etc/apk/world
	archivo /etc/flatpak-pendientes
	errores /var/log/lazaro-instalar.log
	archivo /var/log/lazaro-instalar.log 60
	errores /var/log/desktop-postinstall.log
	archivo /var/log/desktop-postinstall.log 60
	archivo /var/log/lazaro-primer-arranque.log 60
	archivo /var/log/flatpak-pendientes.log 40

	seccion "Memoria y discos"
	corre free -m
	corre df -h
	corre lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT,MODEL
	dmesg | grep -iE "not properly unmounted|I/O error|exfat|fat-fs" | tail -n 20
	archivo /etc/fstab
	cat /proc/swaps

	seccion "Hardware (PCI y USB)"
	if command -v lspci >/dev/null 2>&1; then
		corre lspci -nnk
	else
		# Sin pciutils: lo mismo, más escueto, desde /sys.
		for d in /sys/bus/pci/devices/*; do
			[ -e "$d/vendor" ] || continue
			ctl=""; [ -e "$d/driver" ] && ctl="$(basename "$(readlink "$d/driver")")"
			echo "$(basename "$d") clase=$(cat "$d/class") id=$(cat "$d/vendor"):$(cat "$d/device") controlador=${ctl:-ninguno}"
		done
	fi
	if command -v lsusb >/dev/null 2>&1; then
		corre lsusb
	else
		for d in /sys/bus/usb/devices/*; do
			[ -e "$d/idVendor" ] && echo "USB $(cat "$d/idVendor"):$(cat "$d/idProduct") $(cat "$d/product" 2>/dev/null)"
		done
	fi

	seccion "Controladores que faltan (lazaro-controladores)"
	for lc in /usr/local/sbin/lazaro-controladores /usr/sbin/lazaro-controladores; do
		[ -x "$lc" ] || continue
		corre "$lc" --revisar
		break
	done
	archivo /etc/lazaro/controladores.conf 20
	archivo /var/log/lazaro-controladores.log 40

	seccion "Perfil del hardware y ajustes (lazaro-afinador)"
	for la in /usr/local/sbin/lazaro-afinador /usr/sbin/lazaro-afinador; do
		[ -x "$la" ] || continue
		timeout 60 "$la" --perfil 2>&1
		break
	done
	archivo /etc/lazaro/afinador.conf
	archivo /etc/sysctl.d/60-lazaro-afinador.conf
	archivo /var/log/lazaro-afinador.log 20

	seccion "Gráfica y pantalla"
	lsmod | grep -E '^(nouveau|i915|xe|amdgpu|radeon|simpledrm|bochs|qxl|virtio_gpu|vboxvideo|drm) ' || echo "(ningún controlador gráfico conocido cargado)"
	ls -l /dev/dri 2>&1
	for c in /sys/class/drm/card*-*; do
		[ -e "$c/status" ] && echo "$(basename "$c"): $(cat "$c/status")"
	done
	archivo /etc/modprobe.d/blacklist-nouveau.conf
	if [ -n "$usuario" ] && command -v glxinfo >/dev/null 2>&1; then
		su "$usuario" -c 'DISPLAY=:0 timeout 15 glxinfo -B' 2>&1 | head -n 25
	fi
	for x in /var/log/Xorg.0.log "$casa/.local/share/xorg/Xorg.0.log"; do
		[ -r "$x" ] && { echo "--- $x"; grep -E '\((EE|WW)\)|Loading|driver' "$x" | tail -n 40; }
	done

	seccion "Red"
	corre nmcli device status
	corre nmcli -f NAME,TYPE,DEVICE connection show
	corre ip addr
	corre rfkill list

	seccion "Sonido"
	archivo /proc/asound/cards
	corre aplay -l
	if [ -n "$usuario" ]; then
		su "$usuario" -c 'timeout 10 wpctl status 2>/dev/null || timeout 10 pactl info 2>/dev/null' 2>&1 | head -n 60
	fi

	seccion "Servicios (OpenRC)"
	corre rc-status -a
	corre rc-status --crashed

	seccion "Errores del arranque (núcleo)"
	dmesg | grep -iE 'error|fail|warn|firmware|bug|timeout|nouveau|i915|amdgpu|radeon|drm' | tail -n 120
	seccion "Últimas líneas del núcleo"
	dmesg | tail -n 60

	seccion "Registro del sistema"
	errores /var/log/messages
	archivo /var/log/rc.log 80
	for d in /var/log/lightdm/lightdm.log /var/log/lightdm/x-0.log /var/log/sddm.log /var/log/gdm/greeter.log /var/log/greetd.log; do
		[ -r "$d" ] && { errores "$d"; archivo "$d" 30; }
	done

	seccion "Aplicaciones"
	corre flatpak list --columns=application,version,origin
	echo "Paquetes instalados: $(apk info 2>/dev/null | wc -l)"
	echo "Actualizaciones pendientes: $(apk list -u 2>/dev/null | wc -l)"

	seccion "Temperatura y batería"
	corre sensors
	for b in /sys/class/power_supply/BAT*; do
		[ -d "$b" ] && echo "$(basename "$b"): $(cat "$b/status" 2>/dev/null), $(cat "$b/capacity" 2>/dev/null)%"
	done
} > "$tmp" 2>&1

if [ -n "$usuario" ]; then
	su -s /bin/sh "$usuario" -c 'umask 077; cat > "$1"' sh "$salida" < "$tmp"
else
	cat "$tmp" > "$salida"
fi
if [ $? -ne 0 ] || [ ! -s "$salida" ]; then
	printf "$(_ 'No se pudo guardar el informe en %s (¿carpeta llena o sin permiso?).')\n" "$salida" >&2
	exit 1
fi
printf "$(_ 'Listo: %s')\n" "$salida"
_ 'Compártelo en el chat (no contiene contraseñas).'; echo
[ ! -d /media/cdrom ] || ! grep -q ' /media/cdrom ' /proc/mounts || { _ 'Estás en la sesión live: copia el archivo a otro USB o envíalo antes de apagar.'; echo; }
