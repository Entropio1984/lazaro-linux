#!/bin/sh
# lazaro-nvidia: decide qué controlador de NVIDIA le corresponde a la
# tarjeta del equipo (tabla de docs/nvidia/ARQUITECTURA.md, sección 3).
#
# No instala nada todavía: es la tabla que usarán el instalador y
# lazaro-controladores (paso 4 del plan). La generación la decide
# lazaro-graficas, con las mismas reglas que en la sesión live.
#
# Uso:
#   lazaro-nvidia --rama                 la tarjeta de este equipo
#   lazaro-nvidia --rama GENERACION [OPTIMUS]
#        para una generación de lazaro-graficas (moderna, volta, pascal,
#        maxwell, kepler, fermi, tesla, anterior, desconocida, ninguna) y
#        si es un portátil Optimus (si/no)
#
# Salida (variables de shell):
#   CONTROLADOR=propietario|nouveau|ninguno
#   MODULO=abierto|cerrado|        (solo con propietario)
#   RAMA=actual|580|470|           (solo con propietario)
#   VERSION=x.y.z|                 versión del .run, si ya se sabe
#   PAQUETE=nvidia-open|...|       paquete del módulo, si ya existe
#   ESTADO=probada|sin-probar|     si esa combinación se probó en hardware
#   MOTIVO=texto corto

set -eu

# Versiones: la única probada de verdad es la de las Turing y posteriores
# (RTX 3060, kernel 6.18, 2026-11-27). Las demás hay que elegirlas y
# probarlas con nvidia/prueba-viabilidad.sh antes de activarlas.
VERSION_ACTUAL=620.73.04
VERSION_580=""          # la 580.95.05 no compila en el 6.18; falta una 580 más nueva
VERSION_470=470.256.02  # la última de la 470; necesita parches para kernels nuevos

decidir() { # GENERACION OPTIMUS
	gen="$1"; optimus="${2:-no}"
	CONTROLADOR=nouveau MODULO="" RAMA="" VERSION="" PAQUETE="" ESTADO="" MOTIVO=""
	if [ "$gen" = ninguna ] || [ -z "$gen" ]; then
		CONTROLADOR=ninguno MOTIVO=sin-nvidia
	elif [ "$optimus" = si ]; then
		# Dos GPU: hace falta PRIME render offload y no está probado.
		MOTIVO=optimus
	else
		case "$gen" in
			moderna)
				CONTROLADOR=propietario MODULO=abierto RAMA=actual
				VERSION=$VERSION_ACTUAL PAQUETE=nvidia-open ESTADO=probada
				MOTIVO=turing-o-posterior ;;
			volta|pascal|maxwell)
				CONTROLADOR=propietario MODULO=cerrado RAMA=580
				VERSION=$VERSION_580 ESTADO=sin-probar
				MOTIVO=ultima-rama-580 ;;
			kepler)
				CONTROLADOR=propietario MODULO=cerrado RAMA=470
				VERSION=$VERSION_470 ESTADO=sin-probar
				MOTIVO=legacy-470-solo-xorg ;;
			fermi|tesla|anterior)
				# La 390 y anteriores: sin soporte, sin Vulkan y sin PRIME.
				MOTIVO=sin-rama-utilizable ;;
			*)
				MOTIVO=generacion-desconocida ;;
		esac
	fi
	cat <<-EOF2
	CONTROLADOR=$CONTROLADOR
	MODULO=$MODULO
	RAMA=$RAMA
	VERSION=$VERSION
	PAQUETE=$PAQUETE
	ESTADO=$ESTADO
	MOTIVO=$MOTIVO
	EOF2
}

de_este_equipo() {
	tmp="$(mktemp)"
	LAZARO_GRAFICAS="$tmp" lazaro-graficas --sin-cargar >/dev/null 2>&1 || true
	GENERACION="" OPTIMUS=""
	# shellcheck disable=SC1090
	. "$tmp"
	rm -f "$tmp"
	decidir "${GENERACION:-ninguna}" "${OPTIMUS:-no}"
}

case "${1:-}" in
	--rama)
		if [ $# -ge 2 ]; then decidir "$2" "${3:-no}"; else de_este_equipo; fi ;;
	*) echo "uso: $0 --rama [GENERACION [OPTIMUS]]" >&2; exit 2 ;;
esac
