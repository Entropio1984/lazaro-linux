#!/bin/sh
# lazaro-nvidia: decide qué controlador de NVIDIA le corresponde a la
# tarjeta del equipo (tabla de docs/nvidia/ARQUITECTURA.md, sección 3) y
# activa o desactiva el controlador propietario con el sysroot glibc.
#
# La tabla la usarán el instalador y lazaro-controladores (paso 4 del
# plan). La generación la decide lazaro-graficas, con las mismas reglas
# que en la sesión live.
#
#   lazaro-nvidia --activar [SYSROOT.tar.zst]   (como root)
#        instala el sysroot (si se pasa el archivo de nvidia/construir-raiz.sh),
#        los servicios y la configuración, y deja nouveau en la lista negra.
#        Exige el módulo de NVIDIA de la misma versión que el sysroot
#        (paquete nvidia-open-src). Se nota después de reiniciar.
#   lazaro-nvidia --desactivar                  (como root)
#        vuelve a nouveau; el sysroot y el módulo quedan instalados.
#
# Uso:
#   lazaro-nvidia --rama                 la tarjeta de este equipo
#   lazaro-nvidia --rama GENERACION[,GENERACION...] [OPTIMUS]
#        para una generación de lazaro-graficas (moderna, volta, pascal,
#        maxwell, kepler, fermi, tesla, anterior, desconocida, ninguna) y
#        si es un portátil Optimus (si/no). Con varias NVIDIA se pasan todas
#        sus generaciones: si no les toca la misma rama, queda nouveau.
#
# Los controladores de NVIDIA son solo para x86_64: en otra arquitectura
# (la ISO de 32 bits) siempre queda nouveau. LAZARO_ARCH reemplaza a
# uname -m en las pruebas.
#
# Salida (variables de shell):
#   CONTROLADOR=propietario|nouveau|ninguno
#   MODULO=abierto|cerrado|        (solo con propietario)
#   RAMA=actual|580|470|           (solo con propietario)
#   VERSION=x.y.z|                 versión del .run, si ya se sabe
#   PAQUETE=nvidia-open-src|...|   paquete que hay que instalar (trae el
#                                  firmware como dependencia), si ya existe
#   ESTADO=probada|sin-probar|     si esa rama y versión ya se probaron en
#                                  al menos una tarjeta (moderna: RTX 3060)
#   MOTIVO=texto corto

set -eu

# Versiones: la única probada de verdad es la de las Turing y posteriores
# (RTX 3060, kernel 6.18, 2026-11-27). Las demás hay que elegirlas y
# probarlas con nvidia/prueba-viabilidad.sh antes de activarlas.
VERSION_ACTUAL=620.73.04
VERSION_580=""          # la 580.95.05 no compila en el 6.18; falta una 580 más nueva
VERSION_470=470.256.02  # la última de la 470; necesita parches para kernels nuevos

ARCH="${LAZARO_ARCH:-$(uname -m)}"

decidir_una() { # GENERACION OPTIMUS
	gen="$1"; optimus="${2:-no}"
	CONTROLADOR=nouveau MODULO="" RAMA="" VERSION="" PAQUETE="" ESTADO="" MOTIVO=""
	if [ "$gen" = ninguna ] || [ -z "$gen" ]; then
		CONTROLADOR=ninguno MOTIVO=sin-nvidia
	elif [ "$optimus" = si ]; then
		# Dos GPU: hace falta PRIME render offload y no está probado.
		MOTIVO=optimus
	else
		case "$gen" in
			moderna)
				CONTROLADOR=propietario MODULO=abierto RAMA=actual
				VERSION=$VERSION_ACTUAL PAQUETE=nvidia-open-src ESTADO=probada
				MOTIVO=turing-o-posterior ;;
			volta|pascal|maxwell)
				CONTROLADOR=propietario MODULO=cerrado RAMA=580
				VERSION=$VERSION_580 ESTADO=sin-probar
				MOTIVO=ultima-rama-580 ;;
			kepler)
				CONTROLADOR=propietario MODULO=cerrado RAMA=470
				VERSION=$VERSION_470 ESTADO=sin-probar
				MOTIVO=legacy-470-solo-xorg ;;
			fermi|tesla|anterior)
				# La 390 y anteriores: sin soporte, sin Vulkan y sin PRIME.
				MOTIVO=sin-rama-utilizable ;;
			*)
				MOTIVO=generacion-desconocida ;;
		esac
	fi
	if [ "$CONTROLADOR" = propietario ] && [ "$ARCH" != x86_64 ]; then
		CONTROLADOR=nouveau MODULO="" RAMA="" VERSION="" PAQUETE="" ESTADO=""
		MOTIVO=solo-x86_64
	fi
}

decidir() { # GENERACIONES OPTIMUS
	lista="$(echo "$1" | tr ',' ' ')"
	primera="" mezcla=no
	for g in $lista; do
		decidir_una "$g" "${2:-no}"
		clave="$CONTROLADOR/$MODULO/$RAMA"
		if [ -z "$primera" ]; then primera="$clave"; elif [ "$clave" != "$primera" ]; then mezcla=si; fi
	done
	if [ -z "$lista" ]; then
		decidir_una ninguna "${2:-no}"
	elif [ "$mezcla" = si ]; then
		# Un solo módulo de NVIDIA a la vez: sin rama común, nouveau.
		CONTROLADOR=nouveau MODULO="" RAMA="" VERSION="" PAQUETE="" ESTADO=""
		MOTIVO=generaciones-mezcladas
	fi
	cat <<-EOF2
	CONTROLADOR=$CONTROLADOR
	MODULO=$MODULO
	RAMA=$RAMA
	VERSION=$VERSION
	PAQUETE=$PAQUETE
	ESTADO=$ESTADO
	MOTIVO=$MOTIVO
	EOF2
}

de_este_equipo() {
	tmp="$(mktemp)"
	LAZARO_GRAFICAS="$tmp" lazaro-graficas --sin-cargar >/dev/null 2>&1 || true
	GENERACION="" GENERACIONES="" OPTIMUS=""
	# shellcheck disable=SC1090
	. "$tmp"
	rm -f "$tmp"
	decidir "${GENERACIONES:-${GENERACION:-ninguna}}" "${OPTIMUS:-no}"
}

# --- Activar y desactivar --------------------------------------------------

# Archivos de live/usr/share/lazaro/nvidia: junto a este programa, tanto en
# el repositorio como en el sistema (/usr/sbin y /usr/share).
DATOS="${LAZARO_NVIDIA_DATOS:-$(cd "$(dirname "$0")/../share/lazaro/nvidia" 2>/dev/null && pwd || echo /usr/share/lazaro/nvidia)}"
DESTINO="${LAZARO_DESTINO:-}"   # raíz del sistema (para las pruebas)
RAIZ_NV="$DESTINO/opt/lazaro-nvidia/raiz"
MODPROBE_NV="$DESTINO/etc/modprobe.d/lazaro-nvidia.conf"
LIGHTDM_NV="$DESTINO/etc/lightdm/lightdm.conf.d/50-lazaro-nvidia.conf"

die() { echo "lazaro-nvidia: $*" >&2; exit 1; }

# Versión del módulo instalado para el kernel en uso (vacía si no hay).
version_modulo() {
	modinfo -F version nvidia 2>/dev/null || true
}

rehacer_initramfs() {
	# nouveau tiene que quedar fuera también en el arranque temprano.
	[ -z "$DESTINO" ] || return 0
	command -v mkinitfs >/dev/null 2>&1 || return 0
	mkinitfs "$(uname -r)" >/dev/null || echo "aviso: no se pudo rehacer el initramfs" >&2
}

activar() {
	[ -n "$DESTINO" ] || [ "$(id -u)" -eq 0 ] || die "hay que ejecutarlo como root"
	[ -x "$DATOS/nvidia-raiz" ] || die "no están los archivos de $DATOS"
	if [ -n "${1:-}" ]; then
		[ -r "$1" ] || die "no se puede leer $1"
		command -v zstd >/dev/null 2>&1 || die "falta zstd (apk add zstd)"
		echo "Instalando el sysroot en $RAIZ_NV..."
		rm -rf "$RAIZ_NV.nuevo"
		mkdir -p "$RAIZ_NV.nuevo"
		zstd -dc "$1" | tar -xpf - -C "$RAIZ_NV.nuevo" || { rm -rf "$RAIZ_NV.nuevo"; die "no se pudo descomprimir $1"; }
		[ ! -d "$RAIZ_NV" ] || { "$DATOS/nvidia-raiz" desmontar 2>/dev/null || true; rm -rf "$RAIZ_NV"; }
		mv "$RAIZ_NV.nuevo" "$RAIZ_NV"
	fi
	[ -x "$RAIZ_NV/usr/bin/Xorg" ] || die "no hay sysroot en $RAIZ_NV: pasa el archivo .tar.zst"
	v_raiz=$(sed -n 's/^VERSION=//p' "$RAIZ_NV/etc/lazaro-nvidia" 2>/dev/null)
	if [ -z "$DESTINO" ]; then
		v_mod=$(version_modulo)
		[ -n "$v_mod" ] || die "no está el módulo de NVIDIA para $(uname -r) (instala nvidia-open-src y revisa akms status)"
		[ "$v_mod" = "$v_raiz" ] || die "el módulo es la $v_mod y el sysroot la $v_raiz: tienen que ser la misma versión"
	fi

	install -Dm755 "$DATOS/nvidia-raiz" "$DESTINO/usr/libexec/lazaro/nvidia-raiz"
	install -Dm755 "$DATOS/lazaro-nvidia.initd" "$DESTINO/etc/init.d/lazaro-nvidia"
	install -Dm755 "$DATOS/nvidia-persistenced.initd" "$DESTINO/etc/init.d/nvidia-persistenced"
	install -Dm644 "$DATOS/60-lazaro-nvidia.rules" "$DESTINO/etc/udev/rules.d/60-lazaro-nvidia.rules"
	install -Dm644 "$DATOS/50-lazaro-nvidia.conf" "$LIGHTDM_NV"
	mkdir -p "$(dirname "$MODPROBE_NV")"
	cat > "$MODPROBE_NV" <<-EOF2
	# Lázaro Linux: controlador propietario de NVIDIA ($v_raiz), activado
	# con lazaro-nvidia --activar. Se quita con lazaro-nvidia --desactivar.
	blacklist nouveau
	options nouveau modeset=0
	options nvidia-drm modeset=1 fbdev=1
	EOF2
	for s in lazaro-nvidia nvidia-persistenced; do
		mkdir -p "$DESTINO/etc/runlevels/default"
		ln -sf "/etc/init.d/$s" "$DESTINO/etc/runlevels/default/$s"
	done
	rehacer_initramfs
	echo "NVIDIA $v_raiz activado. Reinicia para usarlo; si no arranca el escritorio, lazaro-nvidia --desactivar vuelve a nouveau."
}

desactivar() {
	[ -n "$DESTINO" ] || [ "$(id -u)" -eq 0 ] || die "hay que ejecutarlo como root"
	for s in nvidia-persistenced lazaro-nvidia; do
		rm -f "$DESTINO/etc/runlevels/default/$s"
	done
	rm -f "$LIGHTDM_NV" "$MODPROBE_NV"
	rehacer_initramfs
	echo "Vuelve nouveau en el próximo arranque. El sysroot ($RAIZ_NV) y el módulo siguen instalados."
}

case "${1:-}" in
	--rama)
		if [ $# -ge 2 ]; then decidir "$2" "${3:-no}"; else de_este_equipo; fi ;;
	--activar) activar "${2:-}" ;;
	--desactivar) desactivar ;;
	*) echo "uso: $0 --rama [GENERACION [OPTIMUS]] | --activar [SYSROOT.tar.zst] | --desactivar" >&2; exit 2 ;;
esac
