#!/usr/bin/python3
# lazaro-bienvenida: la ventana de Bienvenida de Lázaro Linux. Presenta el
# proyecto y reúne en un solo lugar, con botones, las herramientas que ya
# trae el sistema (manual, controladores, afinador, diagnóstico, tienda de
# aplicaciones...).
#
# Está hecha para crecer sin tocar este programa: cada botón es un archivo
# de texto en /usr/share/lazaro/bienvenida/funciones/. Para agregar una
# función basta con agregar un archivo ahí (ver LEEME en esa carpeta).
#
#   lazaro-bienvenida             abre la ventana
#   lazaro-bienvenida --sesion    lo mismo, pero no abre si la persona pidió
#                                 que no se muestre al iniciar sesión
#   lazaro-bienvenida --listar    lista las funciones (sin ventana)
#   lazaro-bienvenida --comprobar revisa los archivos de funciones; termina
#                                 con error si alguno está mal escrito
#
# Usa GTK 3 (py3-gobject3): toma el tema, los colores, la letra y los
# iconos del escritorio instalado, sea XFCE, MATE, LXQt, Plasma, GNOME o
# Sway.

import configparser
import os
import shutil
import subprocess
import sys

NOMBRE = "Bienvenida a Lázaro Linux"
ID_APP = "io.github.entropio1984.lazaro.Bienvenida"

# Carpetas de datos, de menor a mayor prioridad: un archivo con el mismo
# nombre en una carpeta posterior reemplaza al anterior. /etc y /usr/local
# son para lo que agregue quien administra el equipo.
CARPETAS = [
    "/usr/share/lazaro/bienvenida",
    "/usr/local/share/lazaro/bienvenida",
    "/etc/lazaro/bienvenida",
]
if os.environ.get("LAZARO_BIENVENIDA_DIR"):
    CARPETAS = os.environ["LAZARO_BIENVENIDA_DIR"].split(":")

# Los programas de Lázaro viven en /usr/local/sbin (instalado) o /usr/sbin
# (live); algunas sesiones gráficas no traen esas carpetas en el PATH.
RUTA = os.pathsep.join(
    [os.environ.get("PATH", "")]
    + ["/usr/local/sbin", "/usr/local/bin", "/usr/sbin", "/usr/bin", "/sbin", "/bin"]
)

CLAVES = {
    "nombre", "descripcion", "icono", "seccion", "orden", "ejecutar",
    "requiere", "donde", "mostrar", "boton", "portada",
}
OBLIGATORIAS = ("nombre", "descripcion", "seccion", "ejecutar")


def es_live():
    """La sesión live es la única que trae el instalador."""
    if os.environ.get("LAZARO_BIENVENIDA_DONDE") in ("live", "instalado"):
        return os.environ["LAZARO_BIENVENIDA_DONDE"] == "live"
    return os.access("/usr/sbin/lazaro-instalar", os.X_OK)


def existe(programa):
    return shutil.which(programa, path=RUTA) is not None


def archivo_de_datos(nombre):
    """La versión de mayor prioridad de un archivo de datos, o None."""
    for carpeta in reversed(CARPETAS):
        ruta = os.path.join(carpeta, nombre)
        if os.path.isfile(ruta):
            return ruta
    return None


def leer_version():
    datos = {}
    try:
        with open("/usr/share/lazaro/version.env", encoding="utf-8") as f:
            for linea in f:
                clave, igual, valor = linea.strip().partition("=")
                if igual:
                    datos[clave] = valor.strip("\"'")
    except OSError:
        pass
    return datos


def leer_funciones():
    """Lee todos los archivos de funciones. Devuelve (funciones, errores)."""
    archivos = {}
    for carpeta in CARPETAS:
        sub = os.path.join(carpeta, "funciones")
        try:
            nombres = sorted(os.listdir(sub))
        except OSError:
            continue
        for n in nombres:
            if n.endswith(".conf"):
                archivos[n] = os.path.join(sub, n)
    funciones, errores = [], []
    for n in sorted(archivos):
        ruta = archivos[n]
        cp = configparser.ConfigParser(interpolation=None)
        try:
            with open(ruta, encoding="utf-8") as f:
                cp.read_file(f)
            datos = dict(cp["Funcion"])
        except (OSError, UnicodeError, configparser.Error, KeyError) as e:
            errores.append("%s: no se pudo leer (%s)" % (ruta, e))
            continue
        mal = False
        for clave in OBLIGATORIAS:
            if not datos.get(clave, "").strip():
                errores.append("%s: falta %s" % (ruta, clave.capitalize()))
                mal = True
        for clave in datos:
            if clave not in CLAVES:
                errores.append("%s: clave desconocida: %s" % (ruta, clave))
                mal = True
        donde = datos.get("donde", "ambos").strip().lower()
        if donde not in ("ambos", "live", "instalado"):
            errores.append("%s: Donde debe ser ambos, live o instalado" % ruta)
            mal = True
        mostrar = datos.get("mostrar", "").strip().lower()
        if mostrar not in ("", "ventana"):
            errores.append("%s: Mostrar solo acepta: ventana" % ruta)
            mal = True
        try:
            orden = int(datos.get("orden", "500"))
        except ValueError:
            errores.append("%s: Orden debe ser un número" % ruta)
            mal = True
            orden = 500
        if mal:
            continue
        funciones.append({
            "archivo": n,
            "nombre": datos["nombre"].strip(),
            "descripcion": " ".join(datos["descripcion"].split()),
            "iconos": datos.get("icono", "").split(),
            "seccion": datos["seccion"].strip(),
            "orden": orden,
            "ejecutar": datos["ejecutar"].strip(),
            "requiere": datos.get("requiere", "").split(),
            "donde": donde,
            "mostrar": mostrar,
            "boton": datos.get("boton", "Abrir").strip() or "Abrir",
            "portada": datos.get("portada", "no").strip().lower() in ("si", "sí", "yes", "1"),
        })
    funciones.sort(key=lambda f: (f["orden"], f["archivo"]))
    return funciones, errores


def visible(funcion, live):
    """Una función se muestra si corresponde a esta sesión (live o sistema
    instalado) y si están los programas que necesita."""
    if funcion["donde"] == "live" and not live:
        return False
    if funcion["donde"] == "instalado" and live:
        return False
    # Requiere=a b|c: hace falta "a" y además "b" o "c".
    return all(any(existe(p) for p in grupo.split("|")) for grupo in funcion["requiere"])


def leer_portada():
    """Texto de la primera página: título, lema y párrafos."""
    titulo, lema, parrafos = "Lázaro Linux", "", []
    ruta = archivo_de_datos("portada.txt")
    if ruta:
        try:
            with open(ruta, encoding="utf-8") as f:
                bloques = [" ".join(b.split()) for b in f.read().split("\n\n")]
            bloques = [b for b in bloques if b]
            if bloques:
                titulo = bloques.pop(0)
            if bloques:
                lema = bloques.pop(0)
            parrafos = bloques
        except (OSError, UnicodeError):
            pass
    return titulo, lema, parrafos


# --- Preferencia: mostrar al iniciar sesión -----------------------------------

def archivo_no_mostrar():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "lazaro", "bienvenida-no-mostrar")


def se_muestra_al_iniciar():
    return not os.path.exists(archivo_no_mostrar())


def guardar_mostrar(mostrar):
    ruta = archivo_no_mostrar()
    try:
        if mostrar:
            if os.path.exists(ruta):
                os.remove(ruta)
        else:
            os.makedirs(os.path.dirname(ruta), exist_ok=True)
            with open(ruta, "w", encoding="utf-8") as f:
                f.write("La Bienvenida no se abre sola al iniciar sesión.\n")
    except OSError:
        pass


# --- Sin ventana --------------------------------------------------------------

def listar():
    funciones, errores = leer_funciones()
    live = es_live()
    for f in funciones:
        print("%s\t%s\t%s\t%s" % (
            f["seccion"], f["nombre"],
            "visible" if visible(f, live) else "oculta", f["ejecutar"]))
    for e in errores:
        print(e, file=sys.stderr)
    return 0


def comprobar():
    funciones, errores = leer_funciones()
    for e in errores:
        print(e, file=sys.stderr)
    if not funciones:
        print("No hay funciones en: %s" % ", ".join(CARPETAS), file=sys.stderr)
        return 1
    print("%d funciones, %d errores" % (len(funciones), len(errores)))
    return 1 if errores else 0


def falta_gtk():
    """En un equipo instalado antes de que existiera la Bienvenida puede
    faltar py3-gobject3: se ofrece instalarlo."""
    paquetes = "py3-gobject3 gtk+3.0"
    texto = ("A la Bienvenida de Lázaro le falta un componente para abrir "
             "su ventana.\n\n¿Instalarlo ahora? (necesita internet)")
    if not existe("zenity"):
        print("Falta py3-gobject3. Instálalo con: doas apk add " + paquetes, file=sys.stderr)
        return 1
    entorno = dict(os.environ, PATH=RUTA)
    if subprocess.call(["zenity", "--question", "--title", NOMBRE, "--width", "420",
                        "--text", texto], env=entorno) != 0:
        return 1
    orden = (["pkexec"] if existe("pkexec") else ["doas"]) + ["apk", "add"] + paquetes.split()
    if subprocess.call(orden, env=entorno) != 0:
        subprocess.call(["zenity", "--error", "--title", NOMBRE, "--width", "420", "--text",
                         "No se pudo instalar. Revisa la conexión a internet y vuelve a intentar."],
                        env=entorno)
        return 1
    os.execv(sys.executable, [sys.executable] + sys.argv)


# --- Ventana ------------------------------------------------------------------

def ventana_principal(argv):
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, Pango
    except (ImportError, ValueError):
        return falta_gtk()

    entorno = dict(os.environ, PATH=RUTA)
    live = es_live()

    def icono(nombres, tamano):
        """El primer icono de la lista que exista en el tema del escritorio."""
        tema = Gtk.IconTheme.get_default()
        for n in list(nombres) + ["application-x-executable"]:
            if tema.has_icon(n):
                img = Gtk.Image.new_from_icon_name(n, Gtk.IconSize.DIALOG)
                img.set_pixel_size(tamano)
                return img
        return Gtk.Image()

    def aviso(ventana, texto, tipo=None):
        d = Gtk.MessageDialog(transient_for=ventana, modal=True,
                              message_type=tipo or Gtk.MessageType.ERROR,
                              buttons=Gtk.ButtonsType.CLOSE, text=texto)
        d.run()
        d.destroy()

    def mostrar_salida(ventana, funcion):
        """Corre la orden y muestra lo que escribe en una ventana de texto,
        con botones para copiarlo o guardarlo."""
        d = Gtk.Dialog(title=funcion["nombre"], transient_for=ventana, modal=True)
        d.set_default_size(680, 480)
        b_copiar = d.add_button("Copiar", 1)
        b_guardar = d.add_button("Guardar…", 2)
        d.add_button("Cerrar", Gtk.ResponseType.CLOSE)
        b_copiar.set_sensitive(False)
        b_guardar.set_sensitive(False)
        texto = Gtk.TextView(editable=False, cursor_visible=False, monospace=True,
                             left_margin=10, right_margin=10, top_margin=10, bottom_margin=10)
        buf = texto.get_buffer()
        buf.set_text("Revisando el equipo…")
        sw = Gtk.ScrolledWindow()
        sw.add(texto)
        d.get_content_area().pack_start(sw, True, True, 0)
        d.show_all()

        def listo(proc, res):
            try:
                _, salida, error = proc.communicate_utf8_finish(res)
            except GLib.Error as e:
                salida, error = "", str(e)
            buf.set_text((salida or "").strip() or (error or "").strip()
                         or "La herramienta no devolvió información.")
            b_copiar.set_sensitive(True)
            b_guardar.set_sensitive(True)

        try:
            lanzador = Gio.SubprocessLauncher.new(
                Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE)
            lanzador.setenv("PATH", RUTA, True)
            proc = lanzador.spawnv(["sh", "-c", funcion["ejecutar"]])
            proc.communicate_utf8_async(None, None, listo)
        except GLib.Error as e:
            buf.set_text("No se pudo abrir: %s" % e.message)

        while True:
            r = d.run()
            contenido = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False)
            if r == 1:
                Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(contenido, -1)
            elif r == 2:
                g = Gtk.FileChooserDialog(title="Guardar", transient_for=d,
                                          action=Gtk.FileChooserAction.SAVE)
                g.add_buttons("Cancelar", Gtk.ResponseType.CANCEL, "Guardar", Gtk.ResponseType.OK)
                g.set_do_overwrite_confirmation(True)
                g.set_current_name("lazaro-%s.txt" % funcion["archivo"][:-5])
                if g.run() == Gtk.ResponseType.OK:
                    try:
                        with open(g.get_filename(), "w", encoding="utf-8") as f:
                            f.write(contenido + "\n")
                    except OSError as e:
                        aviso(d, "No se pudo guardar: %s" % e)
                g.destroy()
            else:
                break
        d.destroy()

    def abrir(_boton, ventana, funcion):
        if funcion["mostrar"] == "ventana":
            mostrar_salida(ventana, funcion)
            return
        try:
            subprocess.Popen(["sh", "-c", funcion["ejecutar"]], env=entorno,
                             stdin=subprocess.DEVNULL, start_new_session=True)
        except OSError as e:
            aviso(ventana, "No se pudo abrir «%s»: %s" % (funcion["nombre"], e))

    def etiqueta(texto, clases=(), **props):
        e = Gtk.Label(label=texto, xalign=0, wrap=True, **props)
        e.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        for c in clases:
            e.get_style_context().add_class(c)
        return e

    def fila(ventana, funcion):
        caja = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14,
                       margin_top=10, margin_bottom=10, margin_start=14, margin_end=14)
        img = icono(funcion["iconos"], 40)
        img.set_valign(Gtk.Align.CENTER)
        caja.pack_start(img, False, False, 0)
        textos = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3, valign=Gtk.Align.CENTER)
        nombre = etiqueta(funcion["nombre"])
        nombre.set_attributes(Pango.AttrList.from_string("0 -1 weight bold"))
        textos.pack_start(nombre, False, False, 0)
        textos.pack_start(etiqueta(funcion["descripcion"], ("dim-label",), max_width_chars=48), False, False, 0)
        caja.pack_start(textos, True, True, 0)
        boton = Gtk.Button(label=funcion["boton"], valign=Gtk.Align.CENTER)
        boton.set_size_request(96, -1)
        boton.connect("clicked", abrir, ventana, funcion)
        caja.pack_end(boton, False, False, 0)
        f = Gtk.ListBoxRow(activatable=False, selectable=False)
        f.add(caja)
        return f

    def separador(fila_, anterior):
        fila_.set_header(Gtk.Separator() if anterior is not None else None)

    def pagina_seccion(ventana, funciones):
        lista = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        lista.set_header_func(separador)
        for f in funciones:
            lista.add(fila(ventana, f))
        marco = Gtk.Frame(margin=18, valign=Gtk.Align.START)
        marco.add(lista)
        sw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        sw.add(marco)
        return sw

    def pagina_inicio(ventana, portada):
        titulo, lema, parrafos = leer_portada()
        caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10,
                       margin=24, margin_start=32, margin_end=32)
        cab = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=18)
        logo = archivo_de_datos("logo.png")
        if logo:
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_size(logo, 96, 96)
                cab.pack_start(Gtk.Image.new_from_pixbuf(pb), False, False, 0)
            except GLib.Error:
                pass
        tit = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, valign=Gtk.Align.CENTER)
        t = etiqueta(titulo)
        t.set_attributes(Pango.AttrList.from_string("0 -1 weight bold, 0 -1 scale 1.8"))
        tit.pack_start(t, False, False, 0)
        if lema:
            lm = etiqueta(lema)
            lm.set_attributes(Pango.AttrList.from_string("0 -1 scale 1.15, 0 -1 style italic"))
            tit.pack_start(lm, False, False, 0)
        v = leer_version()
        if v.get("ISO_VERSION"):
            det = "Versión %s" % v["ISO_VERSION"]
            if v.get("LAZARO_EDICION"):
                det += " · edición %s" % v["LAZARO_EDICION"].capitalize()
            if live:
                det += " · sesión de prueba (live)"
            tit.pack_start(etiqueta(det, ("dim-label",)), False, False, 0)
        cab.pack_start(tit, True, True, 0)
        caja.pack_start(cab, False, False, 0)
        caja.pack_start(Gtk.Separator(margin_top=6, margin_bottom=6), False, False, 0)
        for p in parrafos:
            caja.pack_start(etiqueta(p, max_width_chars=60), False, False, 0)
        if portada:
            botones = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True,
                                  column_spacing=10, row_spacing=10, margin_top=12,
                                  max_children_per_line=3, min_children_per_line=1)
            for n, f in enumerate(portada):
                b = Gtk.Button(tooltip_text=f["descripcion"])
                c = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8,
                            halign=Gtk.Align.CENTER, margin=4)
                c.pack_start(icono(f["iconos"], 24), False, False, 0)
                c.pack_start(Gtk.Label(label=f["nombre"]), False, False, 0)
                b.add(c)
                if n == 0:
                    b.get_style_context().add_class("suggested-action")
                b.connect("clicked", abrir, ventana, f)
                botones.add(b)
            for hijo in botones.get_children():
                hijo.set_can_focus(False)
            caja.pack_start(botones, False, False, 0)
        sw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        sw.add(caja)
        return sw

    def activar(app):
        ventanas = app.get_windows()
        if ventanas:
            ventanas[0].present()
            return
        funciones, errores = leer_funciones()
        for e in errores:
            print(e, file=sys.stderr)
        funciones = [f for f in funciones if visible(f, live)]

        ventana = Gtk.ApplicationWindow(application=app, title=NOMBRE)
        ventana.set_default_size(860, 560)
        ventana.set_position(Gtk.WindowPosition.CENTER)
        ventana.set_icon_name("lazaro-bienvenida")
        logo = archivo_de_datos("logo.png")
        if logo:
            try:
                ventana.set_icon(GdkPixbuf.Pixbuf.new_from_file_at_size(logo, 64, 64))
            except GLib.Error:
                pass

        pila = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, transition_duration=120)
        pila.add_titled(pagina_inicio(ventana, [f for f in funciones if f["portada"]]),
                        "inicio", "Inicio")
        secciones = []
        for f in funciones:
            if f["seccion"] not in secciones:
                secciones.append(f["seccion"])
        for n, s in enumerate(secciones):
            pila.add_titled(pagina_seccion(ventana, [f for f in funciones if f["seccion"] == s]),
                            "seccion%d" % n, s)
        barra = Gtk.StackSidebar(stack=pila)
        barra.set_size_request(190, -1)

        centro = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        centro.pack_start(barra, False, False, 0)
        centro.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False, False, 0)
        centro.pack_start(pila, True, True, 0)

        pie = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12, margin=10,
                      margin_start=14, margin_end=14)
        if not live:
            casilla = Gtk.CheckButton(label="Mostrar esta ventana al iniciar sesión",
                                      active=se_muestra_al_iniciar())
            casilla.connect("toggled", lambda c: guardar_mostrar(c.get_active()))
            pie.pack_start(casilla, False, False, 0)
        cerrar = Gtk.Button(label="Cerrar")
        cerrar.set_size_request(96, -1)
        cerrar.connect("clicked", lambda _b: ventana.close())
        pie.pack_end(cerrar, False, False, 0)

        todo = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        todo.pack_start(centro, True, True, 0)
        todo.pack_start(Gtk.Separator(), False, False, 0)
        todo.pack_start(pie, False, False, 0)
        ventana.add(todo)
        ventana.show_all()
        pagina = os.environ.get("LAZARO_BIENVENIDA_PAGINA")
        if pagina and pila.get_child_by_name(pagina):
            pila.set_visible_child_name(pagina)

    GLib.set_prgname("lazaro-bienvenida")
    GLib.set_application_name(NOMBRE)
    app = Gtk.Application(application_id=ID_APP)
    app.connect("activate", activar)
    return app.run(argv[:1])


def main(argv):
    orden = argv[1] if len(argv) > 1 else ""
    if orden == "--listar":
        return listar()
    if orden == "--comprobar":
        return comprobar()
    if orden == "--sesion":
        if not se_muestra_al_iniciar() or es_live():
            return 0
    elif orden:
        print("Uso: lazaro-bienvenida [--sesion|--listar|--comprobar]", file=sys.stderr)
        return 2
    return ventana_principal(argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
