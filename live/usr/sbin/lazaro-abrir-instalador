#!/bin/sh
# Abre Calamares como root dentro de la sesión gráfica del usuario live.
# El candado se mantiene mientras Calamares está abierto: si el inicio
# automático y un clic coinciden, solo se abre uno.
# Sin LANG Calamares arranca en inglés; el usuario puede cambiarlo en la
# primera pantalla. Alpine pone LANG=C.UTF-8 en todas las sesiones
# (/etc/profile.d/locale.sh), y eso también es inglés: se reemplaza.
# Al abrirse solo al iniciar la sesión, espera a que NetworkManager termine
# de conectarse (como mucho 30 s): Calamares revisa internet una sola vez,
# al abrir, y si la red aún no estaba lista decía que no había conexión.
# En la instalación desatendida de las pruebas (lazaro.autoinstall en la
# línea del kernel, como la detecta /etc/init.d/lazaro-live) ya se está
# instalando sin interfaz: no se abre Calamares.
for p in $(cat /proc/cmdline); do
	case "$p" in lazaro.autoinstall=*) exit 0 ;; esac
done
if [ "${1:-}" = --esperar-red ]; then
	shift
	command -v nm-online >/dev/null 2>&1 && nm-online -s -q -t 30 || true
fi
# Con GParted abierto no se abre: Calamares leería los discos a medio
# cambiar (ver lazaro-abrir-gparted). Al iniciar la sesión no puede estar
# abierto, así que solo se avisa cuando el usuario hace clic.
if pgrep -x gpartedbin >/dev/null 2>&1; then
	zenity --warning --title="Instalar Lázaro Linux" --width=380 \
		--text="Cierra primero GParted y luego vuelve a abrir el instalador." \
		2>/dev/null
	exit 0
fi
case "${LANG:-}" in
	""|C|C.*|POSIX) LANG=es_ES.UTF-8 ;;
esac
export LANG
case "${LC_ALL:-}" in C|C.*|POSIX) unset LC_ALL ;; esac
# -D 6: guarda en el registro (/root/.cache/.../session.log) los discos
# que Calamares encuentra; la prueba automática lo revisa.
exec flock -n /tmp/lazaro-instalador.lock doas -n /usr/bin/calamares -D 6 "$@"
