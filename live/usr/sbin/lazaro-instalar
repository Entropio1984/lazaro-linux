#!/bin/sh
# lazaro-instalar: pasos de instalación de Lázaro Linux.
#
# Calamares llama a cada paso desde sus módulos shellprocess (ver
# /etc/calamares/modules/shellprocess@*.conf). Las pruebas automáticas
# usan "auto", que hace lo mismo sin interfaz gráfica.
#
# El trabajo pesado lo hacen las herramientas oficiales de Alpine:
#   setup-disk    sistema base, fstab, initramfs, kernel, firmware y GRUB
#                 (BIOS y UEFI) sobre la raíz que montó Calamares
#   setup-desktop el escritorio elegido
# y al final se ejecuta desktop-postinstall.sh.
#
# Uso:
#   lazaro-instalar base RAIZ ESCRITORIO
#   lazaro-instalar escritorio RAIZ ESCRITORIO
#   lazaro-instalar ajustes RAIZ USUARIO IDIOMA TECLADO VARIANTE ZONA [EXTRAS [OFICINA]]
#     EXTRAS: esencial (por defecto), flatpak o flatpak-chrome
#     OFICINA: ninguna (por defecto), libreoffice u onlyoffice (activa Flatpak)
#   lazaro-instalar auto DISCO ESCRITORIO     (¡BORRA EL DISCO COMPLETO!)

set -eu

LOG=/var/log/lazaro-instalar.log
DATOS=/usr/share/lazaro
# ALPINE_BRANCH, ALPINE_MIRROR, ISO_VERSION, LAZARO_LLAVE (de build.sh)
. "$DATOS/version.env"
ARCH="$(apk --print-arch)"
ESCRITORIOS="xfce xfce-wayland gnome plasma mate sway lxqt ninguno"
# El único escritorio cuyos paquetes van dentro de la ISO.
ESCRITORIO_OFFLINE="xfce"

log() { printf '[lazaro] %s\n' "$*" | tee -a "$LOG" >&2; }
die() { log "ERROR: $*"; exit 1; }

# Toda llamada a apk del instalador pasa por esta función: si cambia la
# forma de usar apk (apk v3, por ejemplo), se cambia en un solo sitio.
lz_apk() {
	apk "$@"
}

# Repositorio de la ISO tal como lo dejó el arranque live
# (/media/cdrom/apks, /media/sdb/apks...). Vacío si no hay.
repo_iso() {
	grep -m1 '^/media/.*/apks$' /etc/apk/repositories 2>/dev/null || true
}

hay_red() {
	wget -q --spider -T 8 \
		"$ALPINE_MIRROR/$ALPINE_BRANCH/main/$ARCH/APKINDEX.tar.gz" 2>/dev/null
}

# escribir_repos ARCHIVO REPO_ISO(vacío=no) RED(si/no)
escribir_repos() {
	{
		[ -z "$2" ] || echo "$2"
		if [ "$3" = si ]; then
			echo "$ALPINE_MIRROR/$ALPINE_BRANCH/main"
			echo "$ALPINE_MIRROR/$ALPINE_BRANCH/community"
		fi
	} > "$1.lazaro-nuevo"
	mv "$1.lazaro-nuevo" "$1"
}

validar_escritorio() {
	case " $ESCRITORIOS " in
		*" $1 "*) ;;
		*) die "Escritorio desconocido: '$1' (opciones: $ESCRITORIOS)" ;;
	esac
}

# --- Ejecutar comandos dentro del sistema instalado ----------------------
MONTADOS=""

montar_si_falta() { # TIPO ORIGEN DESTINO
	mountpoint -q "$3" && return 0
	mkdir -p "$3"
	if [ "$1" = bind ]; then
		mount --bind "$2" "$3"
	else
		mount -t "$1" "$2" "$3"
	fi
	MONTADOS="$3 $MONTADOS"
}

desmontar_propios() {
	for m in $MONTADOS; do
		umount "$m" 2>/dev/null || umount -l "$m" || true
	done
	MONTADOS=""
}

# en_destino RAIZ [VAR=valor...] COMANDO [ARGS...]
en_destino() {
	raiz="$1"
	shift
	montar_si_falta proc proc "$raiz/proc"
	montar_si_falta sysfs sys "$raiz/sys"
	montar_si_falta bind /dev "$raiz/dev"
	if [ -d /sys/firmware/efi/efivars ]; then
		montar_si_falta efivarfs efivarfs "$raiz/sys/firmware/efi/efivars"
	fi
	iso="$(repo_iso)"
	[ -z "$iso" ] || montar_si_falta bind "$iso" "$raiz$iso"
	cp /etc/resolv.conf "$raiz/etc/resolv.conf" 2>/dev/null || true
	rc=0
	chroot "$raiz" /usr/bin/env -i \
		PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root TERM=linux \
		"$@" || rc=$?
	desmontar_propios
	return $rc
}

# --- Paso 1: sistema base -------------------------------------------------
paso_base() {
	raiz="${1%/}"
	de="$2"
	validar_escritorio "$de"
	mountpoint -q "$raiz" || die "$raiz no es un punto de montaje"

	iso="$(repo_iso)"
	red=no
	hay_red && red=si
	log "Lázaro Linux $ISO_VERSION sobre Alpine $ALPINE_BRANCH"
	log "Repositorio de la ISO: ${iso:-ninguno}; internet: $red"
	if [ "$de" != "$ESCRITORIO_OFFLINE" ] && [ "$de" != ninguno ] && [ "$red" = no ]; then
		die "El escritorio '$de' se descarga de internet y no hay conexión. Conéctate a una red o elige XFCE."
	fi
	[ -n "$iso" ] || [ "$red" = si ] || die "No se encontró el repositorio de la ISO ni hay internet."

	# setup-disk instala con los repositorios del sistema live.
	escribir_repos /etc/apk/repositories "$iso" "$red"
	lz_apk update >>"$LOG" 2>&1 || log "Aviso: apk update terminó con errores (ver $LOG)."

	# Configuración inicial del destino. setup-disk la desempaqueta en la
	# raíz (opción -o, como si fuera un respaldo de lbu) y luego instala
	# todo lo que diga etc/apk/world.
	ovl="$(mktemp -d)"
	mkdir -p "$ovl/etc/apk"
	grep -v '^#' "$DATOS/paquetes-base" | grep -v '^$' > "$ovl/etc/apk/world"
	escribir_repos "$ovl/etc/apk/repositories" "$iso" "$red"
	echo lazaro > "$ovl/etc/hostname"
	for s in devfs:sysinit dmesg:sysinit mdev:sysinit hwdrivers:sysinit \
		hwclock:boot modules:boot sysctl:boot hostname:boot bootmisc:boot \
		syslog:boot networkmanager:default chronyd:default acpid:default \
		crond:default mount-ro:shutdown killprocs:shutdown savecache:shutdown; do
		mkdir -p "$ovl/etc/runlevels/${s#*:}"
		ln -s "/etc/init.d/${s%:*}" "$ovl/etc/runlevels/${s#*:}/${s%:*}"
	done
	tar -C "$ovl" -czf /tmp/lazaro-destino.apkovl.tar.gz etc
	rm -rf "$ovl"

	log "Instalando el sistema base con setup-disk (puede tardar)..."
	if ! BOOTLOADER=grub KERNELOPTS="${LAZARO_KERNELOPTS:-quiet}" \
		setup-disk -v -m sys -o /tmp/lazaro-destino.apkovl.tar.gz "$raiz" \
		>>"$LOG" 2>&1; then
		die "setup-disk falló (detalles en $LOG)"
	fi
	log "Sistema base instalado."
}

# --- Paso 2: escritorio ---------------------------------------------------
paso_escritorio() {
	raiz="${1%/}"
	de="$2"
	validar_escritorio "$de"
	if [ "$de" = ninguno ]; then
		# Solo consola: queda una marca para que los ajustes no instalen
		# programas gráficos.
		mkdir -p "$raiz/etc/lazaro"
		: > "$raiz/etc/lazaro/sin-escritorio"
		# Si se reutilizó sin formatear una partición con un escritorio
		# anterior, su pantalla de inicio no debe volver a arrancar.
		for dm in lightdm sddm gdm greetd; do
			rm -f "$raiz"/etc/runlevels/*/"$dm"
		done
		log "Sin escritorio: el sistema arrancará en modo texto."
		return 0
	fi
	log "Instalando el escritorio '$de' con setup-desktop..."
	if ! en_destino "$raiz" setup-desktop "$de" </dev/null >>"$LOG" 2>&1; then
		die "setup-desktop $de falló (detalles en $LOG)"
	fi
	log "Escritorio '$de' instalado."
}

# --- Paso 3: ajustes y desktop-postinstall.sh ----------------------------
paso_ajustes() {
	raiz="${1%/}"
	usuario="$2"
	idioma="${3:-es_CO.UTF-8}"
	teclado="${4:-latam}"
	variante="${5:-}"
	zona="${6:-America/Bogota}"
	extras="${7:-esencial}"
	oficina="${8:-ninguna}"
	opt_flatpak=no
	opt_chrome=no
	case "$extras" in
		esencial) ;;
		flatpak) opt_flatpak=yes ;;
		flatpak-chrome) opt_flatpak=yes; opt_chrome=yes ;;
		*) log "Aviso: aplicaciones adicionales desconocidas '$extras'; se instala lo esencial." ;;
	esac
	opt_libreoffice=no
	opt_onlyoffice=no
	case "$oficina" in
		ninguna) ;;
		libreoffice) opt_libreoffice=yes ;;
		# OnlyOffice solo existe en Flathub: necesita Flatpak.
		onlyoffice) opt_onlyoffice=yes; opt_flatpak=yes ;;
		*) log "Aviso: programa de oficina desconocido '$oficina'; no se instala ninguno." ;;
	esac
	if [ -e "$raiz/etc/lazaro/sin-escritorio" ]; then
		# Flatpak, Chrome y la oficina no sirven sin escritorio.
		opt_flatpak=no
		opt_chrome=no
		opt_libreoffice=no
		opt_onlyoffice=no
	fi
	opt_firefox=yes
	opt_cups=yes
	if [ -e "$raiz/etc/lazaro/sin-escritorio" ]; then
		# Solo consola: tampoco navegador ni impresoras.
		opt_firefox=no
		opt_cups=no
	fi

	if [ -e "$raiz/usr/share/zoneinfo/$zona" ]; then
		ln -sf "/usr/share/zoneinfo/$zona" "$raiz/etc/localtime"
		echo "$zona" > "$raiz/etc/timezone"
	else
		log "Aviso: zona horaria desconocida '$zona'; se deja UTC."
	fi

	mkdir -p "$raiz/etc/profile.d"
	cat > "$raiz/etc/profile.d/00-idioma.sh" <<-EOF
	# Idioma elegido en el instalador de Lázaro Linux
	export LANG=$idioma
	EOF

	# Teclado de la sesión gráfica (Xorg)...
	mkdir -p "$raiz/etc/X11/xorg.conf.d"
	{
		echo 'Section "InputClass"'
		echo '    Identifier "system-keyboard"'
		echo '    MatchIsKeyboard "on"'
		echo "    Option \"XkbLayout\" \"$teclado\""
		[ -z "$variante" ] || echo "    Option \"XkbVariant\" \"$variante\""
		echo 'EndSection'
	} > "$raiz/etc/X11/xorg.conf.d/00-keyboard.conf"
	# ...y de la consola.
	if ! en_destino "$raiz" setup-keymap "$teclado" "${variante:-$teclado}" \
		</dev/null >>"$LOG" 2>&1; then
		en_destino "$raiz" setup-keymap "$teclado" "$teclado" </dev/null >>"$LOG" 2>&1 \
			|| log "Aviso: no se pudo configurar el teclado de consola '$teclado'."
	fi

	mkdir -p "$raiz/etc/doas.d"
	echo 'permit persist :wheel' > "$raiz/etc/doas.d/20-wheel.conf"
	chmod 0600 "$raiz/etc/doas.d/20-wheel.conf"

	# Repositorios definitivos: los de internet (el de la ISO deja de
	# existir al reiniciar), y fuera la llave que solo firmaba la ISO.
	escribir_repos "$raiz/etc/apk/repositories" "" si
	[ -z "${LAZARO_LLAVE:-}" ] || rm -f "$raiz/etc/apk/keys/$LAZARO_LLAVE"

	# desktop-postinstall.sh sin preguntas: sus opciones se fijan con las
	# variables OPT_* (las mismas casillas premarcadas de su menú).
	install -Dm755 "$DATOS/desktop-postinstall.sh" \
		"$raiz/usr/libexec/lazaro/desktop-postinstall.sh"
	opt_teclado=no
	[ "$teclado" = latam ] && opt_teclado=yes
	mkdir -p "$raiz/etc/lazaro"
	cat > "$raiz/etc/lazaro/postinstall.env" <<-EOF
	OPT_KEYBOARD=$opt_teclado
	OPT_LANG=$idioma
	OPT_NVIDIA_SAFE=yes
	OPT_NVIDIA_MODE=optimus
	OPT_GCOMPAT=no
	OPT_CUPS=$opt_cups
	OPT_LIBREOFFICE=$opt_libreoffice
	OPT_FIREFOX=$opt_firefox
	OPT_FLATPAK=$opt_flatpak
	OPT_ONLYOFFICE=$opt_onlyoffice
	OPT_CHROME=$opt_chrome
	OPT_UPDATE_SHORTCUT=yes
	DOAS_USER=$usuario
	EOF

	install -Dm755 "$DATOS/lazaro-postinstalacion" "$raiz/usr/libexec/lazaro/lazaro-postinstalacion"
	if hay_red; then
		log "Ejecutando desktop-postinstall.sh (descarga paquetes, puede tardar)..."
		if en_destino "$raiz" /usr/libexec/lazaro/lazaro-postinstalacion \
			</dev/null >>"$LOG" 2>&1; then
			log "desktop-postinstall.sh terminó bien."
		else
			log "Aviso: desktop-postinstall.sh falló; se repetirá en el primer arranque."
			programar_primer_arranque "$raiz"
		fi
	else
		log "Sin internet: desktop-postinstall.sh se ejecutará en el primer arranque con red."
		programar_primer_arranque "$raiz"
	fi

	cp "$LOG" "$raiz/var/log/lazaro-instalar.log" 2>/dev/null || true
	log "Instalación terminada."
}

programar_primer_arranque() {
	install -Dm755 "$DATOS/lazaro-primer-arranque.initd" \
		"$1/etc/init.d/lazaro-primer-arranque"
	mkdir -p "$1/etc/runlevels/default"
	ln -sf /etc/init.d/lazaro-primer-arranque "$1/etc/runlevels/default/lazaro-primer-arranque"
}

# --- Instalación desatendida (pruebas automáticas) -----------------------
paso_auto() {
	disco="$1"
	de="$2"
	validar_escritorio "$de"
	[ -b "$disco" ] || die "$disco no es un disco"
	case "$disco" in
		*[0-9]) p="${disco}p" ;;
		*) p="$disco" ;;
	esac

	log "Instalación desatendida en $disco con '$de' (se borra el disco)"
	raiz=/mnt/lazaro
	if [ -d /sys/firmware/efi ]; then
		printf 'label: gpt\nsize=300M, type=uefi\ntype=linux\n' | sfdisk --wipe always "$disco" >>"$LOG" 2>&1
		udevadm settle 2>/dev/null || sleep 2
		mkfs.vfat -F 32 -n EFI "${p}1" >>"$LOG" 2>&1
		mkfs.ext4 -q -F -L lazaro "${p}2"
		mkdir -p "$raiz"
		mount -t ext4 "${p}2" "$raiz"
		mkdir -p "$raiz/boot/efi"
		mount -t vfat "${p}1" "$raiz/boot/efi"
	else
		printf 'label: dos\ntype=83, bootable\n' | sfdisk --wipe always "$disco" >>"$LOG" 2>&1
		udevadm settle 2>/dev/null || sleep 2
		mkfs.ext4 -q -F -L lazaro "${p}1"
		mkdir -p "$raiz"
		mount -t ext4 "${p}1" "$raiz"
	fi

	paso_base "$raiz" "$de"

	# Lo que en Calamares hace el módulo "users".
	en_destino "$raiz" adduser -D -g "Prueba" -s /bin/ash prueba >>"$LOG" 2>&1
	echo 'prueba:lazaro' | en_destino "$raiz" chpasswd >>"$LOG" 2>&1
	for g in wheel audio video netdev input plugdev lp users; do
		en_destino "$raiz" addgroup prueba "$g" >>"$LOG" 2>&1 || true
	done
	echo lazaro-prueba > "$raiz/etc/hostname"

	paso_escritorio "$raiz" "$de"
	paso_ajustes "$raiz" prueba es_CO.UTF-8 latam "" America/Bogota "${LAZARO_EXTRAS:-esencial}"
	echo "LAZARO-FLATPAK-INICIO"
	echo "- postinstall.env:"; grep FLATPAK "$raiz/etc/lazaro/postinstall.env"
	echo "- apk flatpak:"; en_destino "$raiz" apk info -e flatpak gnome-software-plugin-flatpak 2>&1
	echo "- remotes:"; en_destino "$raiz" flatpak remotes --system 2>&1
	echo "- log:"; grep -n -i -B2 -A25 "chrome" "$raiz/var/log/desktop-postinstall.log" 2>&1 | head -n 120
	echo "- instalar.log:"; grep -n -i "postinstall\|aviso" "$LOG" | tail -n 20
	echo "LAZARO-FLATPAK-FIN"

	# Recorrido real de la resolución: "prueba" entra sola a su sesión,
	# cambia la pantalla a 800x600, la prueba cierra la sesión y la
	# pantalla de inicio debe volver con 800x600 (LightDM o SDDM). Con
	# GDM la prueba reinicia, porque GDM solo la toma al arrancar.
	pdm=""
	[ -f "$raiz/etc/lightdm/lightdm.conf.d/50-pantalla-inicio.conf" ] && pdm=lightdm
	[ -f "$raiz/etc/sddm.conf.d/50-pantalla-inicio.conf" ] && pdm=sddm
	[ -f "$raiz/etc/init.d/pantalla-inicio-gdm" ] && pdm=gdm
	if [ "$pdm" = lightdm ]; then
		en_destino "$raiz" addgroup -S autologin >>"$LOG" 2>&1 || true
		en_destino "$raiz" addgroup prueba autologin >>"$LOG" 2>&1 || true
		cat > "$raiz/etc/lightdm/lightdm.conf.d/90-lazaro-prueba.conf" <<-EOF
		[Seat:*]
		autologin-user=prueba
		autologin-user-timeout=0
		autologin-session=$de
		EOF
	elif [ "$pdm" = sddm ]; then
		# Plasma entra en su sesión Wayland (la predeterminada).
		sesion=""
		for f in "$raiz/usr/share/wayland-sessions/$de.desktop" \
			"$raiz/usr/share/xsessions/$de.desktop"; do
			[ -f "$f" ] && { sesion="${f##*/}"; break; }
		done
		cat > "$raiz/etc/sddm.conf.d/90-lazaro-prueba.conf" <<-EOF
		[Autologin]
		User=prueba
		Session=${sesion:-$de.desktop}
		EOF
	elif [ "$pdm" = gdm ]; then
		# Se guarda el custom.conf original y se repone antes de reiniciar.
		mkdir -p "$raiz/etc/gdm"
		if [ -f "$raiz/etc/gdm/custom.conf" ]; then
			cp "$raiz/etc/gdm/custom.conf" "$raiz/etc/lazaro/gdm-custom.conf.orig"
		fi
		cat > "$raiz/etc/gdm/custom.conf" <<-EOF
		[daemon]
		AutomaticLoginEnable=True
		AutomaticLogin=prueba
		EOF
	fi
	if [ -n "$pdm" ]; then
		echo "$pdm" > "$raiz/etc/lazaro/prueba-pantalla"
		# Traza de "guardar" para el diagnóstico.
		sed -i 's|^Exec=.*|Exec=sh -c "sh -x /usr/local/libexec/pantalla-inicio/guardar 2>/tmp/guardar-traza.log"|' \
			"$raiz/etc/xdg/autostart/pantalla-inicio.desktop"
		mkdir -p "$raiz/usr/local/bin"
		cat > "$raiz/usr/local/bin/lazaro-prueba-800x600" <<-'EOF'
		#!/bin/sh
		# Solo pruebas: la sesión del usuario elige 800x600.
		exec 2>/tmp/prueba-800x600.log
		set -x
		sleep 5
		case ":${XDG_CURRENT_DESKTOP:-}:" in *:GNOME:*) gnome=1 ;; *) gnome="" ;; esac
		if [ -n "$gnome" ]; then
			# Como la Configuración de GNOME: se aplica de forma permanente
			# y GNOME pregunta "¿Mantener los cambios?" (la prueba pulsa
			# Intro desde QEMU). Solo así GNOME escribe monitors.xml.
			t=0
			until e="$(gdbus call --session --dest org.gnome.Mutter.DisplayConfig \
				--object-path /org/gnome/Mutter/DisplayConfig \
				--method org.gnome.Mutter.DisplayConfig.GetCurrentState)" || [ $t -ge 60 ]; do
				sleep 3
				t=$((t + 3))
			done
			printf '%s\n' "$e" >&2
			serie="$(printf '%s\n' "$e" | sed -n 's/^(uint32 \([0-9]*\).*/\1/p')"
			conector="$(printf '%s\n' "$e" | grep -o "(('[^']*'" | head -n 1 | cut -d"'" -f2)"
			modo="$(printf '%s\n' "$e" | grep -o "'800x600@[0-9.]*'" | head -n 1 | tr -d "'")"
			gdbus call --session --dest org.gnome.Mutter.DisplayConfig \
				--object-path /org/gnome/Mutter/DisplayConfig \
				--method org.gnome.Mutter.DisplayConfig.ApplyMonitorsConfig \
				"$serie" 2 "[(0, 0, 1.0, 0, true, [('$conector', '$modo', @a{sv} {})])]" "@a{sv} {}"
			touch /tmp/lazaro-confirmar
		elif [ -n "${WAYLAND_DISPLAY:-}" ]; then
			o="$(kscreen-doctor -o | sed 's/\x1b\[[0-9;]*m//g')"
			printf '%s\n' "$o" >&2
			salida="$(printf '%s\n' "$o" | awk '/Output:/ { for (i = 1; i < NF; i++) if ($i == "Output:") { print $(i + 2); exit } }')"
			modo="$(printf '%s\n' "$o" | grep -o '[0-9]*: *800x600@[0-9.]*' | head -n 1 | cut -d: -f1)"
			[ -n "$modo" ] && kscreen-doctor "output.$salida.mode.$modo"
		else
			xrandr -s 800x600
		fi
		EOF
		chmod 755 "$raiz/usr/local/bin/lazaro-prueba-800x600"
		cat > "$raiz/etc/xdg/autostart/zz-lazaro-prueba-resolucion.desktop" <<-'EOF'
		[Desktop Entry]
		Type=Application
		Name=Prueba de resolucion
		Exec=/usr/local/bin/lazaro-prueba-800x600
		NoDisplay=true
		EOF
	fi

	# Solo pruebas: al arrancar el sistema instalado, informar por el
	# puerto serie y apagar.
	mkdir -p "$raiz/etc/local.d"
	cat > "$raiz/etc/local.d/zz-lazaro-prueba.start" <<-'EOF'
	#!/bin/sh
	{
		echo "LAZARO-INSTALADO-ARRANCO"
		echo "- pendientes:"; cat /etc/flatpak-pendientes 2>&1
		t=0
		while [ -e /etc/flatpak-pendientes ] && [ $t -lt 1200 ]; do sleep 10; t=$((t + 10)); done
		if flatpak list --app 2>/dev/null | grep -q com.google.Chrome; then echo "LAZARO-CHROME-OK $t"; else echo "LAZARO-CHROME-NO $t"; fi
		tail -n 30 /var/log/flatpak-pendientes.log 2>&1
		rc-status default
		# Nada en la carpeta del usuario debe ser de otro dueño (si
		# no, Plasma y otros no pueden guardar su configuración).
		if [ ! -d /home/prueba ]; then
			ajenos="falta /home/prueba"
		else
			ajenos="$(find /home/prueba ! -user prueba 2>/dev/null | head -n 5)"
		fi
		if [ -z "$ajenos" ]; then
			echo "LAZARO-HOME-OK"
		else
			echo "LAZARO-HOME-AJENO"
			echo "$ajenos"
		fi
		# Resolución de la pantalla de inicio (LightDM o SDDM): la que
		# quedó anotada en ~/.config/pantalla-inicio.
		pdm="$(cat /etc/lazaro/prueba-pantalla 2>/dev/null)"
		reiniciar=""
		if [ "$pdm" = gdm ] && [ ! -f /etc/lazaro/prueba-reiniciada ]; then
			# Primera vuelta: la sesión de GNOME elige 800x600.
			t=0
			until [ -f /tmp/lazaro-confirmar ] || [ $t -ge 240 ]; do
				sleep 3
				t=$((t + 3))
			done
			# qemu.sh pulsa Intro en "¿Mantener los cambios?".
			echo "LAZARO-CONFIRMAR"
			t=0
			until grep -qs '<width>800</width>' /home/prueba/.config/monitors.xml || [ $t -ge 120 ]; do
				sleep 3
				t=$((t + 3))
			done
			if grep -qs '<width>800</width>' /home/prueba/.config/monitors.xml; then
				echo "LAZARO-GUARDADO-OK"
			else
				echo "LAZARO-GUARDADO-NO"
				echo "--- diagnóstico del guardado ---"
				ls -la /home/prueba/.config 2>&1
				cat /home/prueba/.config/monitors.xml 2>&1
				echo "- cambio a 800x600:"
				tail -n 30 /tmp/prueba-800x600.log 2>&1
				echo "--- fin del diagnóstico ---"
			fi
			if [ -f /etc/lazaro/gdm-custom.conf.orig ]; then
				mv /etc/lazaro/gdm-custom.conf.orig /etc/gdm/custom.conf
			else
				rm -f /etc/gdm/custom.conf
			fi
			touch /etc/lazaro/prueba-reiniciada
			echo "LAZARO-REINICIANDO"
			reiniciar=1
		elif [ "$pdm" = gdm ]; then
			# Segunda vuelta: GDM debe mostrarse en 800x600 (qemu.sh
			# mide la pantalla). Se espera al gnome-shell del saludo.
			t=0
			saludo=""
			while [ -z "$saludo" ] && [ $t -lt 180 ]; do
				for c in /proc/[0-9]*/comm; do
					[ "$(cat "$c" 2>/dev/null)" = gnome-shell ] \
						&& [ "$(stat -c %U "${c%/comm}" 2>/dev/null)" = gdm ] && saludo=1
				done
				[ -n "$saludo" ] || { sleep 3; t=$((t + 3)); }
			done
			sleep 20
			echo "LAZARO-SALUDO-${saludo:+LISTO}"
			# Modo actual del saludo, preguntado al Mutter de GDM.
			modo_gdm() {
				for c in /proc/[0-9]*/comm; do
					p="${c%/comm}"
					[ "$(cat "$c" 2>/dev/null)" = gnome-shell ] \
						&& [ "$(stat -c %U "$p" 2>/dev/null)" = gdm ] || continue
					bus="$(tr '\0' '\n' < "$p/environ" | sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p')"
					[ -n "$bus" ] || continue
					su -s /bin/sh gdm -c "DBUS_SESSION_BUS_ADDRESS='$bus' gdbus call --session \
						--dest org.gnome.Mutter.DisplayConfig --object-path /org/gnome/Mutter/DisplayConfig \
						--method org.gnome.Mutter.DisplayConfig.GetCurrentState" 2>/dev/null \
						| grep -o "('[0-9]*x[0-9]*@[0-9.]*', [^)]*'is-current': <true>" | cut -d"'" -f2
					return 0
				done
			}
			reiniciar_gdm() {
				rc-service gdm restart >/dev/null 2>&1
				sleep 45
			}
			echo "LAZARO-GDM-MODO $(modo_gdm)"
			echo "--- datos de GDM ---"
			rc-service pantalla-inicio-gdm status 2>&1
			stat -c '%n acceso=%x cambio=%y' /var/lib/gdm/.config/monitors.xml /home/prueba/.config/monitors.xml 2>&1
			cmp /var/lib/gdm/.config/monitors.xml /home/prueba/.config/monitors.xml && echo "copia idéntica"
			# Orden: ¿arrancó el saludo antes o después de la copia?
			arranque="$(awk '/^btime/ { print $2 }' /proc/stat)"
			for c in /proc/[0-9]*/comm; do
				[ "$(cat "$c" 2>/dev/null)" = gnome-shell ] || continue
				inicio=$((arranque + $(awk '{ print $22 }' "${c%/comm}/stat") / 100))
				echo "gnome-shell $(stat -c %U "${c%/comm}") empezó $(date -d "@$inicio" '+%T')"
			done
			echo "sistema arrancó $(date -d "@$arranque" '+%T')"
			if ! modo_gdm | grep -qx '800x600@.*'; then
				# Pruebas para encontrar la causa: reiniciar GDM con el
				# archivo ya en su sitio, y luego como archivo del sistema.
				reiniciar_gdm
				echo "tras reiniciar GDM: $(modo_gdm)"
				stat -c '%n acceso=%x' /var/lib/gdm/.config/monitors.xml
				cp /var/lib/gdm/.config/monitors.xml /etc/xdg/monitors.xml
				reiniciar_gdm
				echo "con /etc/xdg/monitors.xml: $(modo_gdm)"
				rm -f /etc/xdg/monitors.xml
				sed -i 's|<layoutmode>logical</layoutmode>|<layoutmode>physical</layoutmode>|' /var/lib/gdm/.config/monitors.xml
				reiniciar_gdm
				echo "con layoutmode physical: $(modo_gdm)"
				sed -i '/<layoutmode>/d' /var/lib/gdm/.config/monitors.xml
				reiniciar_gdm
				echo "sin layoutmode: $(modo_gdm)"
			fi
			echo "- greeter.log:"
			grep -iE 'monitor|config' /var/log/gdm/greeter.log 2>/dev/null | head -n 20
			echo "--- fin de los datos ---"
		elif [ -n "$pdm" ]; then
			# 1) La sesión debe anotar la resolución que eligió.
			t=0
			until grep -qs 800x600 /home/prueba/.config/pantalla-inicio || [ $t -ge 240 ]; do
				sleep 3
				t=$((t + 3))
			done
			if grep -qs 800x600 /home/prueba/.config/pantalla-inicio; then
				echo "LAZARO-GUARDADO-OK"
			else
				echo "LAZARO-GUARDADO-NO"
				echo "--- diagnóstico del guardado ---"
				cat /home/prueba/.config/pantalla-inicio 2>&1
				ps -ef 2>/dev/null | grep -E '[g]uardar|[x]fce4-session|[m]ate-session|[p]lasma|[k]win|[l]ightdm|[s]ddm'
				loginctl list-sessions --no-pager 2>&1 | cat
				for pid in $(pgrep -f pantalla-inicio/guardar); do
					tr '\0' '\n' < /proc/$pid/environ | grep -E '^(DISPLAY|XAUTHORITY|XDG_SESSION_ID|WAYLAND_DISPLAY|HOME)='
				done
				echo "- cambio a 800x600:"
				tail -n 30 /tmp/prueba-800x600.log 2>&1
				echo "- guardar:"
				tail -n 40 /tmp/guardar-traza.log 2>&1
				echo "--- fin del diagnóstico ---"
			fi
			# 2) Se cierra la sesión (sin volver a entrar sola).
			rm -f /etc/lightdm/lightdm.conf.d/90-lazaro-prueba.conf /etc/sddm.conf.d/90-lazaro-prueba.conf
			# Los Xorg de la sesión del usuario: no cuentan como saludo.
			viejos=" $(ps -eo pid,args | awk '/[X]org/ { printf "%s ", $1 }')"
			if [ "$pdm" = sddm ]; then
				# Como al cerrar sesión: SDDM vuelve a su pantalla de
				# inicio (sin "Relogin" no entra sola de nuevo).
				loginctl terminate-user prueba >/dev/null 2>&1
			else
				rc-service lightdm restart >/dev/null 2>&1
			fi
			# Se reintenta: X puede tardar en aceptar conexiones y la
			# resolución se aplica justo antes de mostrar el saludo.
			# La llave de X queda atada al nombre del equipo, que cambia
			# al arrancar: se usa una copia válida para cualquier nombre
			# (familia "ffff"). La llave y la pantalla salen de Xorg.
			llave=/tmp/lazaro-llave-x
			t=0
			modo=""
			while [ "$modo" != 800x600 ] && [ $t -lt 120 ]; do
				sleep 3
				t=$((t + 3))
				x="$(ps -eo pid,args | awk -v viejos="$viejos" '/[X]org/ && index(viejos, " " $1 " ") == 0 { for (i = 3; i <= NF; i++) { if ($i ~ /^:[0-9]+$/) d = $i; if ($i == "-auth") a = $(i + 1) } } END { print d, a }')"
				pantalla="${x%% *}"
				rm -f "$llave"
				xauth -f "${x#* }" nlist 2>/dev/null | sed 's/^..../ffff/' \
					| xauth -f "$llave" nmerge - 2>/dev/null
				modo="$(DISPLAY="${pantalla:-:0}" XAUTHORITY="$llave" xrandr --current 2>/dev/null \
					| awk '$2 == "connected" { for (i = 3; i <= NF; i++) if ($i ~ /^[0-9]+x[0-9]+[+]/) { sub(/[+].*/, "", $i); print $i; exit } }')"
			done
			echo "LAZARO-PANTALLA-${modo:-desconocida}"
			if [ "$modo" != 800x600 ]; then
				echo "--- diagnóstico de la resolución ---"
				command -v xrandr || echo "sin xrandr"
				echo "Xorg: $x"
				ls -la /usr/local/libexec/pantalla-inicio 2>&1
				cat /etc/lightdm/lightdm.conf.d/50-pantalla-inicio.conf /etc/sddm.conf.d/50-pantalla-inicio.conf 2>/dev/null
				ps -ef 2>/dev/null | grep -E '[X]org|[l]ightdm|[s]ddm'
				command -v xauth || echo "sin xauth"
				DISPLAY="${pantalla:-:0}" XAUTHORITY="$llave" xrandr --current 2>&1 | head -n 5
				grep pantalla-inicio /var/log/messages 2>/dev/null | tail -n 5
				tail -n 25 /var/log/lightdm/lightdm.log 2>/dev/null
				grep -i sddm /var/log/messages 2>/dev/null | tail -n 25
				echo "--- fin del diagnóstico ---"
			fi
		else
			echo "LAZARO-PANTALLA-SIN-AJUSTE"
		fi
		for s in lightdm sddm gdm greetd; do
			rc-service --exists "$s" && rc-service "$s" status
		done
		# El servicio de SDDM de Alpine espera solo 2 segundos a la
		# pantalla de inicio: en una máquina lenta OpenRC lo marca como
		# fallido aunque esté corriendo. Se mira el proceso.
		for s in lightdm sddm gdm greetd; do
			cat /proc/[0-9]*/comm 2>/dev/null | grep -qx "$s" && echo "LAZARO-DM-ACTIVO $s"
		done
		[ -n "$reiniciar" ] || echo "LAZARO-PRUEBA-FIN"
	} > /dev/ttyS0 2>&1
	if [ -n "$reiniciar" ]; then
		reboot
		exit 0
	fi
	sleep 20
	poweroff
	EOF
	chmod +x "$raiz/etc/local.d/zz-lazaro-prueba.start"
	ln -sf /etc/init.d/local "$raiz/etc/runlevels/default/local"

	sync
	[ ! -d "$raiz/boot/efi" ] || ! mountpoint -q "$raiz/boot/efi" || umount "$raiz/boot/efi"
	umount "$raiz"
	log "Instalación desatendida terminada."
}

orden="${1:-}"
[ $# -gt 0 ] && shift
case "$orden" in
	base)       [ $# -eq 2 ] || die "uso: lazaro-instalar base RAIZ ESCRITORIO"; paso_base "$@" ;;
	escritorio) [ $# -eq 2 ] || die "uso: lazaro-instalar escritorio RAIZ ESCRITORIO"; paso_escritorio "$@" ;;
	ajustes)    [ $# -ge 2 ] || die "uso: lazaro-instalar ajustes RAIZ USUARIO [IDIOMA TECLADO VARIANTE ZONA EXTRAS OFICINA]"; paso_ajustes "$@" ;;
	auto)       [ $# -eq 2 ] || die "uso: lazaro-instalar auto DISCO ESCRITORIO"; paso_auto "$@" ;;
	*)
		sed -n '2,/^$/s/^# \{0,1\}//p' "$0" >&2
		exit 1
		;;
esac
