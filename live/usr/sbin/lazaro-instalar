#!/bin/sh
# lazaro-instalar: pasos de instalación de Lázaro Linux.
#
# Calamares llama a cada paso desde sus módulos shellprocess (ver
# /etc/calamares/modules/shellprocess-*.conf). Las pruebas automáticas
# usan "auto", que hace lo mismo sin interfaz gráfica.
#
# El trabajo pesado lo hacen las herramientas oficiales de Alpine:
#   setup-disk    sistema base, fstab, initramfs, kernel, firmware y GRUB
#                 (BIOS y UEFI) sobre la raíz que montó Calamares
#   setup-desktop el escritorio elegido
# y al final se ejecuta desktop-postinstall.sh.
#
# Uso:
#   lazaro-instalar base RAIZ ESCRITORIO
#   lazaro-instalar escritorio RAIZ ESCRITORIO
#   lazaro-instalar ajustes RAIZ USUARIO IDIOMA TECLADO VARIANTE ZONA [EXTRAS]
#     EXTRAS: lo marcado en "Software adicional", separado por espacios,
#     detrás de "base": fastfetch btop vlc youtube libreoffice (Alpine) y
#     flatpak onlyoffice brave (Flathub). Sin EXTRAS: "base flatpak".
#     Google Chrome ya no se ofrece al instalar (se instala desde la
#     Bienvenida); "chrome" se sigue aceptando por si alguien lo pasa.
#   lazaro-instalar autologin RAIZ USUARIO
#     Inicio de sesión automático para USUARIO (casilla de Calamares).
#   lazaro-instalar texto DISCO ESCRITORIO USUARIO NOMBRE EQUIPO IDIOMA
#     TECLADO VARIANTE ZONA [EXTRAS]           (¡BORRA EL DISCO COMPLETO!)
#     Instalación desde la consola (lazaro-instalar-texto); la contraseña
#     va en la variable LAZARO_CLAVE.
#   lazaro-instalar red
#     Termina bien si hay internet (lo usa lazaro-instalar-texto).
#   lazaro-instalar auto DISCO ESCRITORIO     (¡BORRA EL DISCO COMPLETO!)
#     Solo pruebas: además deja en el disco las comprobaciones de
#     /usr/share/lazaro/pruebas, que informan por el puerto serie.

set -eu

# Textos en el idioma de la sesión (idiomas/*.po); sin traducción, español.
if [ -r "${LAZARO_TEXTO_DIR:-/usr/share/lazaro}/texto.sh" ]; then . "${LAZARO_TEXTO_DIR:-/usr/share/lazaro}/texto.sh"; else _() { printf '%b' "$1"; }; fi

LOG=/var/log/lazaro-instalar.log
DATOS=/usr/share/lazaro
# ALPINE_BRANCH, ALPINE_MIRROR, ISO_VERSION, LAZARO_LLAVE (de build.sh)
. "$DATOS/version.env"
ARCH="$(apk --print-arch)"
ESCRITORIOS="xfce xfce-wayland gnome plasma mate sway lxqt ninguno"
# El único escritorio cuyos paquetes van dentro de la ISO.
# Escritorios que vienen completos en la ISO (LAZARO_ESCRITORIOS en
# perfil/mkimg.lazaro.sh); los demás se descargan.
ESCRITORIOS_OFFLINE="xfce mate lxqt sway xfce-wayland ninguno"
# Edición Completa: todos vienen en la ISO, y también todo lo que instala
# desktop-postinstall.sh, que entonces corre aunque no haya internet.
LAZARO_EDICION="${LAZARO_EDICION:-ligera}"
[ "$LAZARO_EDICION" != completa ] || ESCRITORIOS_OFFLINE="$ESCRITORIOS"
# ISO de 32 bits: solo IceWM (y "Sin escritorio"), en el USB: XFCE y LXQt
# iban lentos en estos equipos (Julián, 2026-11-15). No hay
# Flatpak (Flathub no tiene aplicaciones de 32 bits) ni kernel Lázaro;
# NetSurf, un navegador liviano, se instala siempre y Firefox solo si se
# marcó ("firefox" entre los EXTRAS).
BITS32=no
if [ "$ARCH" = x86 ]; then
	BITS32=si
	ESCRITORIOS="icewm ninguno"
	ESCRITORIOS_OFFLINE="$ESCRITORIOS"
fi

log() { printf '[lazaro] %s\n' "$*" | tee -a "$LOG" >&2; }
die() { log "ERROR: $*"; exit 1; }

# --- Avance visible en Calamares ----------------------------------------
# Calamares muestra en "Toggle log" lo que este programa escribe, pero la
# salida completa de setup-disk, setup-desktop y desktop-postinstall.sh va
# solo a $LOG. Mientras trabajan, un vigía en segundo plano revisa $LOG
# cada 5 s y escribe un resumen (igual que hace el script en la consola):
#   - una línea por paquete: "(12/80) Instalando firefox";
#   - si pasan 20 s sin novedades, "... sigue trabajando (1 min 20 s)",
#     con cuánto se descargó de internet en esos 20 s y el último mensaje
#     del registro, para distinguir un paso largo que avanza de uno que
#     espera a una red que no responde. desktop-postinstall.sh escribe su
#     propio "sigue trabajando" con el mismo detalle y aquí se deja pasar.
# setup-disk llama a apk con --quiet y no escribe una línea por paquete:
# para ese paso se muestra cuánto ocupa ya el sistema nuevo en el disco.
# avance_iniciar QUÉ [RAÍZ] arranca el vigía; avance_parar lo detiene.
AVANCE_PID=""
AVANCE_LEIDAS=/tmp/lazaro-avance.leidas

# Traduce a español las líneas de apk ("( 1/12) Installing x (1.0-r0)")
# y deja pasar las que ya trae traducidas desktop-postinstall.sh.
avance_traducir() {
	awk '
		{ sub(/^[ \t]+/, ""); sub(/^\( +/, "(") }
		/^\([0-9]+\/[0-9]+\) (Installing|Upgrading|Downgrading|Reinstalling) / {
			print "[lazaro] " $1 " Instalando " $3; next
		}
		/^\([0-9]+\/[0-9]+\) Purging / { print "[lazaro] " $1 " Quitando " $3; next }
		/^\([0-9]+\/[0-9]+\) (Instalando|Quitando|Descargando) / { print "[lazaro] " $0; next }
		/^\.\.\. sigue trabajando/ { print "[lazaro] " $0 }
	'
}

# Escribe a la salida de error las líneas de avance que llegaron a $LOG
# desde la última lectura (cuántas se leyeron queda en $AVANCE_LEIDAS, para
# que avance_parar muestre también las últimas). Devuelve 1 si no hubo.
avance_leer() {
	leidas=$(cat "$AVANCE_LEIDAS" 2>/dev/null || echo 0)
	lineas=$(wc -l <"$LOG")
	[ "$lineas" -gt "$leidas" ] || return 1
	nuevas=$(sed -n "$((leidas + 1)),${lineas}p" "$LOG" | avance_traducir)
	echo "$lineas" >"$AVANCE_LEIDAS"
	[ -n "$nuevas" ] || return 1
	printf '%s\n' "$nuevas" >&2
}

# Bytes recibidos hasta ahora por las interfaces de red salvo lo.
red_bytes() {
	awk 'NR > 2 { sub(/^[ \t]+/, ""); split($0, a, ":"); if (a[1] != "lo") { split(a[2], f, " "); s += f[1] } }
		END { if (NR > 2) printf "%.0f\n", s }' /proc/net/dev 2>/dev/null || true
}

avance_vigia() { # QUÉ [RAÍZ]
	total=0
	silencio=0
	red_antes=$(red_bytes)
	sin_red=0
	# sleep sin la salida de Calamares: al parar el vigía no la deja abierta.
	while sleep 5 >/dev/null 2>&1; do
		total=$((total + 5))
		silencio=$((silencio + 5))
		if avance_leer; then
			silencio=0
			# El siguiente aviso mide solo lo descargado durante el silencio.
			red_antes=$(red_bytes)
			sin_red=0
			continue
		fi
		if [ "$silencio" -ge 20 ]; then
			silencio=0
			if [ "$total" -ge 60 ]; then
				tiempo="$((total / 60)) min $((total % 60)) s"
			else
				tiempo="$total s"
			fi
			if [ -n "${2:-}" ] && mb=$(df -Pm "$2" 2>/dev/null | awk 'NR == 2 { print $3 }') && [ -n "$mb" ]; then
				tiempo="$tiempo, $mb MB en el disco"
			fi
			detalle=""
			red_ahora=$(red_bytes)
			if [ -n "$red_ahora" ] && [ -n "$red_antes" ]; then
				kb=$(((red_ahora - red_antes) / 1024))
				red_antes=$red_ahora
				if [ "$kb" -ge 1024 ]; then
					sin_red=0
					detalle=" | internet: $(awk -v k="$kb" 'BEGIN { printf "%.1f", k / 1024 }') MB en 20 s"
				elif [ "$kb" -ge 10 ]; then
					sin_red=0
					detalle=" | internet: lento, $kb KB en 20 s"
				else
					sin_red=$((sin_red + 20))
					if [ "$sin_red" -ge 60 ]; then
						detalle=" | internet: sin descargar nada desde hace $((sin_red / 60)) min"
					else
						detalle=" | internet: casi nada en 20 s"
					fi
				fi
			fi
			ultimo=$(tr -d '\000-\010\013-\037\177' <"$LOG" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -n 1 | tr -s ' \t' ' ' | sed 's/^ //' | cut -c1-90)
			[ -z "$ultimo" ] || detalle="$detalle | último mensaje: $ultimo"
			printf '[lazaro] ... %s sigue trabajando (%s)%s\n' "$1" "$tiempo" "$detalle" >&2
		fi
	done
}

# hora TEXTO: deja en el registro (solo en el archivo) la hora en que
# empieza o termina cada parte, para saber cuál tarda (la Completa en una
# VM tardó bastante y no había cómo medirlo: 23 de noviembre de 2026).
hora() { printf '[lazaro] Hora %s: %s\n' "$(date '+%T')" "$*" >>"$LOG" 2>/dev/null || true; }

avance_iniciar() { # QUÉ [RAÍZ]
	avance_parar
	touch "$LOG"
	hora "empieza $1"
	wc -l <"$LOG" >"$AVANCE_LEIDAS"
	avance_vigia "$@" </dev/null &
	AVANCE_PID=$!
}

avance_parar() {
	[ -n "$AVANCE_PID" ] || return 0
	kill "$AVANCE_PID" 2>/dev/null || true
	wait "$AVANCE_PID" 2>/dev/null || true
	AVANCE_PID=""
	# Lo que el paso escribió después de la última vuelta del vigía.
	avance_leer || true
	hora "termina"
}

# Si el programa termina por un error (die), el vigía no debe quedar vivo
# (Calamares espera a que se cierre la salida) ni quedar montado nada en el
# sistema nuevo (/proc, /dev, el repositorio del USB...).
al_salir() {
	al_rc=$?
	avance_parar
	desmontar_propios
	[ -z "${orden:-}" ] || hora "fin del paso $orden (código $al_rc)"
}
trap al_salir EXIT

# Toda llamada a apk del instalador pasa por esta función: si cambia la
# forma de usar apk (apk v3, por ejemplo), se cambia en un solo sitio.
lz_apk() {
	apk "$@"
}

# Repositorio de la ISO tal como lo dejó el arranque live
# (/media/cdrom/apks, /media/sdb/apks...). Vacío si no hay.
repo_iso() {
	grep -m1 '^/media/.*/apks$' /etc/apk/repositories 2>/dev/null || true
}

hay_red() {
	wget -q --spider -T 8 \
		"$ALPINE_MIRROR/$ALPINE_BRANCH/main/$ARCH/APKINDEX.tar.gz" 2>/dev/null
}

# Como hay_red, pero tolera un corte breve (pasos base y ajustes): espera
# a NetworkManager y prueba hasta 4 veces (unos 45 s como mucho). Si aun
# así no llega al servidor, anota en el registro el motivo que da wget.
esperar_red() {
	command -v nm-online >/dev/null 2>&1 && nm-online -s -q -t 10 || true
	for _intento in 1 2 3 4; do
		hay_red && return 0
		[ "$_intento" = 4 ] || sleep 3
	done
	log "Sin respuesta de $ALPINE_MIRROR tras 4 intentos. Motivo:"
	wget --spider -T 8 "$ALPINE_MIRROR/$ALPINE_BRANCH/main/$ARCH/APKINDEX.tar.gz" >>"$LOG" 2>&1 || true
	return 1
}

# escribir_repos ARCHIVO REPO_ISO(vacío=no) RED(si/no)
escribir_repos() {
	{
		[ -z "$2" ] || echo "$2"
		if [ "$3" = si ]; then
			echo "$ALPINE_MIRROR/$ALPINE_BRANCH/main"
			echo "$ALPINE_MIRROR/$ALPINE_BRANCH/community"
		fi
	} > "$1.lazaro-nuevo"
	mv "$1.lazaro-nuevo" "$1"
}

escritorio_offline() {
	case " $ESCRITORIOS_OFFLINE " in *" $1 "*) return 0 ;; esac
	return 1
}

validar_escritorio() {
	case " $ESCRITORIOS " in
		*" $1 "*) ;;
		*) die "Escritorio desconocido: '$1' (opciones: $ESCRITORIOS)" ;;
	esac
}

# --- Ejecutar comandos dentro del sistema instalado ----------------------
MONTADOS=""

# Cada montaje que falla se informa y devuelve error. Hace falta decirlo
# así: en_destino se llama casi siempre dentro de un "if" o con "||", y
# ahí "set -e" no detiene nada.
montar_si_falta() { # TIPO ORIGEN DESTINO
	mountpoint -q "$3" && return 0
	mkdir -p "$3" || { log "ERROR: no se pudo crear $3"; return 1; }
	if [ "$1" = bind ]; then
		mount --bind "$2" "$3" || { log "ERROR: no se pudo montar $2 en $3"; return 1; }
	else
		mount -t "$1" "$2" "$3" || { log "ERROR: no se pudo montar $1 en $3"; return 1; }
	fi
	MONTADOS="$3 $MONTADOS"
}

# Lo que necesita un chroot al sistema instalado: /proc, /sys, /dev, las
# variables EFI y el repositorio de la ISO (para instalar sin internet).
montar_destino() { # RAIZ
	montar_si_falta proc proc "$1/proc" || return 1
	montar_si_falta sysfs sys "$1/sys" || return 1
	montar_si_falta bind /dev "$1/dev" || return 1
	if [ -d /sys/firmware/efi/efivars ]; then
		montar_si_falta efivarfs efivarfs "$1/sys/firmware/efi/efivars" || return 1
	fi
	md_iso="$(repo_iso)"
	if [ -n "$md_iso" ]; then
		montar_si_falta bind "$md_iso" "$1$md_iso" || return 1
	fi
	return 0
}

desmontar_propios() {
	for m in ${MONTADOS:-}; do
		umount "$m" 2>/dev/null || umount -l "$m" || true
	done
	MONTADOS=""
}

# en_destino RAIZ [VAR=valor...] COMANDO [ARGS...]
en_destino() {
	raiz="$1"
	shift
	if ! montar_destino "$raiz"; then
		desmontar_propios
		return 1
	fi
	cp /etc/resolv.conf "$raiz/etc/resolv.conf" 2>/dev/null || true
	rc=0
	chroot "$raiz" /usr/bin/env -i \
		PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root TERM=linux \
		"$@" || rc=$?
	matar_restos "$raiz"
	desmontar_propios
	return $rc
}

# Procesos que siguen vivos dentro del sistema instalado (por ejemplo,
# servicios de D-Bus que arranca flatpak) impiden desmontarlo al final.
matar_restos() {
	mr_raiz="${1%/}"
	for mr_senal in TERM KILL; do
		mr_quedan=""
		for mr_p in /proc/[0-9]*; do
			[ "$(readlink "$mr_p/root" 2>/dev/null)" = "$mr_raiz" ] || continue
			[ "$mr_senal" = KILL ] || log "Aviso: se cierra un proceso que quedó vivo en $mr_raiz: $(tr '\0' ' ' < "$mr_p/cmdline" 2>/dev/null)"
			kill -s "$mr_senal" "${mr_p#/proc/}" 2>/dev/null && mr_quedan=1
		done
		[ -n "$mr_quedan" ] || return 0
		sleep 1
	done
}

# --- Descargas que se quedan colgadas --------------------------------------
# apk (3.0) abre la conexión segura (HTTPS) con el servidor sin tiempo
# límite: si el servidor o la red dejan de responder justo en ese momento,
# apk espera para siempre. Pasó en una VM con la Completa (2026-11-19): el
# índice de community llegó cortado ("unexpected end of file") y después
# el "apk update" que hace setup-desktop se quedó quieto hasta que
# Calamares cortó el paso a los 90 minutos. desktop-postinstall.sh ya se
# cuida de esto (apk_vigilado); aquí se hace lo mismo con setup-desktop.

# El proceso PID y todos los que nacieron de él (busybox ps no muestra el
# padre: se lee de /proc).
descendientes() { # PID
	grep -H '^PPid:' /proc/[0-9]*/status 2>/dev/null | awk -v raiz="$1" '
		{ p = $1; sub(/^\/proc\//, "", p); sub(/\/status:.*/, "", p); padre[p] = $2 }
		END {
			lista[raiz] = 1
			do {
				cambio = 0
				for (p in padre) if (!(p in lista) && (padre[p] in lista)) { lista[p] = 1; cambio = 1 }
			} while (cambio)
			for (p in lista) print p
		}'
}

# Bytes leídos y escritos hasta ahora por esos procesos (disco y red).
io_total() { # PID...
	for it_p in "$@"; do cat "/proc/$it_p/io" 2>/dev/null; done |
		awk '/^(rchar|wchar):/ { s += $2 } END { printf "%.0f\n", s }'
}

# Lo más que espera la instalación por la lista de la tienda (opcional).
TIENDA_LIMITE=${TIENDA_LIMITE:-180}

# en_destino_vigilado RAIZ COMANDO...: como en_destino (con la salida en
# $LOG), pero si el comando y todos sus procesos pasan CUELGUE_LIMITE
# segundos (3 minutos) sin leer ni escribir nada, se cortan y se intenta
# de nuevo, hasta 3 veces. apk recuerda lo que ya instaló, así que el
# intento siguiente sigue donde quedó. Devuelve lo que devolvió el
# comando, o 124 si se colgó las 3 veces.
CUELGUE_LIMITE=180
en_destino_vigilado() { # RAIZ COMANDO...
	for ev_intento in 1 2 3; do
		en_destino "$@" </dev/null >>"$LOG" 2>&1 &
		ev_pid=$!
		ev_antes=""
		ev_quieto=0
		ev_rc=""
		while kill -0 "$ev_pid" 2>/dev/null; do
			sleep 5
			ev_procs=$(descendientes "$ev_pid")
			# shellcheck disable=SC2086 # una lista de números
			ev_ahora=$(io_total $ev_procs)
			# Si no se puede medir (sin /proc), nunca se corta.
			if [ -z "$ev_procs" ] || [ "$ev_ahora" != "$ev_antes" ]; then
				ev_antes=$ev_ahora
				ev_quieto=0
				continue
			fi
			ev_quieto=$((ev_quieto + 5))
			[ "$ev_quieto" -ge "$CUELGUE_LIMITE" ] || continue
			log "Aviso: $2 lleva $((CUELGUE_LIMITE / 60)) minutos sin avanzar (una descarga se quedó colgada). Se corta (intento $ev_intento de 3)."
			# Se cortan los procesos de dentro, no el primero: así
			# en_destino termina normal y desmonta lo que montó. Solo los
			# que corren dentro del sistema nuevo (su raíz es $1): si el
			# comando ya terminó con TERM, en_destino puede estar
			# desmontando, y el KILL no debe cortar ese umount.
			ev_r="${1%/}"
			for ev_senal in TERM KILL; do
				for ev_p in $(descendientes "$ev_pid"); do
					[ "$ev_p" != "$ev_pid" ] || continue
					[ "$(readlink "/proc/$ev_p/root" 2>/dev/null)" = "$ev_r" ] || continue
					kill -s "$ev_senal" "$ev_p" 2>/dev/null || true
				done
				sleep 2
			done
			ev_rc=124
			break
		done
		ev_fin=0
		wait "$ev_pid" || ev_fin=$?
		[ -n "$ev_rc" ] || return "$ev_fin"
	done
	return 124
}

# Durante los pasos que instalan lo que trae el USB, el sistema nuevo usa
# solo el repositorio de la ISO: sin internet de por medio, una red lenta
# o que se corta no puede dejar la instalación colgada.
# repos_solo_usb RAIZ guarda los repositorios que tenía y deja solo el de
# la ISO (devuelve 1 si no hay ISO); repos_volver RAIZ los devuelve.
repos_solo_usb() { # RAIZ
	ru_iso="$(repo_iso)"
	[ -n "$ru_iso" ] || return 1
	# Si quedó una copia de un intento anterior que se cortó (Calamares
	# canceló el paso), esa es la buena: no se pisa.
	[ -f "$1/etc/apk/repositories.lazaro-antes" ] ||
		cp "$1/etc/apk/repositories" "$1/etc/apk/repositories.lazaro-antes" || return 1
	escribir_repos "$1/etc/apk/repositories" "$ru_iso" no
}

repos_volver() { # RAIZ
	[ -f "$1/etc/apk/repositories.lazaro-antes" ] || return 0
	mv "$1/etc/apk/repositories.lazaro-antes" "$1/etc/apk/repositories"
}

# ¿Los repositorios guardados por repos_solo_usb incluyen los de internet?
repos_antes_con_red() { # RAIZ
	grep -qs '^https\?://' "$1/etc/apk/repositories.lazaro-antes"
}

# ¿Edición Completa con su repositorio a mano? Esa edición trae todo lo
# que se instala, así que cada paso (sistema base, escritorio, driver
# Broadcom, controladores, programas y configuración final) usa solo el
# USB, haya o no internet: tarda lo mismo con buena o mala conexión y
# una red lenta no puede dejar la instalación colgada. Si desde el USB
# algo falla y hay internet, ese paso se intenta otra vez con internet.
# Las versiones nuevas llegan después, con el aviso de actualizaciones.
completa_usb() {
	[ "$LAZARO_EDICION" = completa ] && [ -n "$(repo_iso)" ]
}

# --- Wifi Broadcom con driver privativo -----------------------------------
# Tarjetas Broadcom (fabricante 14e4) que con el kernel no tienen un
# driver libre que funcione: b43 necesitaría un firmware que no se puede
# repartir y brcmsmac no las conoce. Funcionan con broadcom-wl (wl).
# BCM4311/4312 (4311 4312 4313 4315), BCM4321 (4328 4329 432a),
# BCM4322 (432b 432c 432d), BCM4331 (4331), BCM43227 (4358), BCM43228
# (4359), BCM43142 (4365), BCM4360 (43a0) y BCM4352 (43b1). Quedan fuera
# las que brcmsmac sí maneja (BCM4313 = 4727, BCM43224 = 4353, BCM43225 =
# 4357) y las de brcmfmac.
BROADCOM_WL_IDS="4311 4312 4313 4315 4328 4329 432a 432b 432c 432d 4331 4358 4359 4365 43a0 43b1"

broadcom_wl_tarjeta() {
	# Las pruebas (QEMU no tiene una Broadcom) lo fuerzan desde el menú.
	if grep -qw 'lazaro.broadcom=forzar' /proc/cmdline 2>/dev/null; then
		echo "prueba"
		return 0
	fi
	for bw_d in /sys/bus/pci/devices/*; do
		[ "$(cat "$bw_d/vendor" 2>/dev/null)" = 0x14e4 ] || continue
		bw_id="$(cat "$bw_d/device" 2>/dev/null)"
		bw_id="${bw_id#0x}"
		case " $BROADCOM_WL_IDS " in
			*" $bw_id "*) echo "14e4:$bw_id"; return 0 ;;
		esac
	done
	return 1
}

# Instala broadcom-wl en el sistema instalado y lo compila con akms para
# su kernel. Sin internet usa las cabeceras del kernel y el compilador que
# vienen en la ISO. Si falla, la instalación sigue: el equipo queda sin
# wifi pero con cable, y akms lo vuelve a intentar con cada kernel nuevo.
paso_broadcom() { # RAIZ
	bw_tarjeta="$(broadcom_wl_tarjeta)" || return 0
	if [ "$BITS32" = si ]; then
		log "Aviso: wifi Broadcom $bw_tarjeta: su driver (broadcom-wl) no está disponible para 32 bits. Usa cable, el celular por USB o un adaptador wifi USB."
		return 0
	fi
	log "Wifi Broadcom $bw_tarjeta: se instala el driver broadcom-wl (se compila, tarda unos minutos)..."
	avance_iniciar "el driver wifi Broadcom" "$1"
	bw_rc=0
	# Al instalar el paquete, akms intenta compilar el driver, pero dentro
	# del chroot del instalador no puede (aísla la compilación con espacios
	# de usuario y el kernel no los permite en un chroot). Ese intento falla
	# sin consecuencias; el driver se compila aquí directo. En el sistema ya
	# instalado akms sí funciona y lo recompila solo cuando se actualiza el
	# kernel.
	en_destino "$1" apk add --no-progress broadcom-wl-src </dev/null >>"$LOG" 2>&1 || bw_rc=$?
	bw_src=""
	for bw_s in "$1"/usr/src/broadcom-wl-*/AKMBUILD; do
		[ -f "$bw_s" ] && bw_src="${bw_s%/AKMBUILD}" && bw_src="${bw_src#"$1"}"
	done
	[ -n "$bw_src" ] || [ "$bw_rc" != 0 ] || bw_rc=1
	bw_ko=""
	if [ "$bw_rc" = 0 ]; then
		# El compilador y las cabeceras del kernel instalado (en la
		# Completa vienen en el USB; en la Ligera se descargan). Se quitan
		# al terminar.
		bw_dev=""
		for bw_f in "$1"/usr/share/kernel/*/kernel.release; do
			[ -f "$bw_f" ] || continue
			bw_dev="$bw_dev linux-$(basename "$(dirname "$bw_f")")-dev"
		done
		en_destino "$1" apk add --no-progress -t .lazaro-wl-compilar build-base $bw_dev </dev/null >>"$LOG" 2>&1 || bw_rc=$?
	fi
	if [ "$bw_rc" = 0 ]; then
		for bw_k in "$1"/lib/modules/*; do
			[ -d "$bw_k/build" ] || [ -L "$bw_k/build" ] || continue
			bw_kv="${bw_k##*/}"
			bw_c=0
			en_destino "$1" sh -c "rm -rf /tmp/lazaro-wl && cp -a '$bw_src' /tmp/lazaro-wl && cd /tmp/lazaro-wl && make -j\$(nproc) -C '/lib/modules/$bw_kv/build' M=/tmp/lazaro-wl modules && install -D -m 644 wl.ko '/lib/modules/$bw_kv/extra/wl.ko' && depmod -a '$bw_kv'" </dev/null >>"$LOG" 2>&1 || bw_c=$?
			rm -rf "$1/tmp/lazaro-wl"
			if [ "$bw_c" = 0 ] && [ -f "$bw_k/extra/wl.ko" ]; then
				bw_ko="$bw_k/extra/wl.ko"
			else
				bw_rc=$bw_c
				log "Aviso: falló la compilación de broadcom-wl para el kernel $bw_kv (código $bw_c)."
			fi
		done
		en_destino "$1" apk del --no-progress .lazaro-wl-compilar </dev/null >>"$LOG" 2>&1 || true
	fi
	avance_parar
	if [ -z "$bw_ko" ]; then
		log "Aviso: no se pudo compilar broadcom-wl (código $bw_rc, detalles en $LOG). El wifi Broadcom no funcionará hasta conectarse por cable y ejecutar: doas akms install -k all ${bw_src:-/usr/src/broadcom-wl-*}"
		echo "LAZARO-BROADCOM-NO"
		grep -v -E '^\(|^ *(CC|LD|MODPOST|BTF)' "$LOG" | grep -i -E 'error|akms|broadcom|wl\.|make' | tail -n 40
		return 0
	fi
	log "broadcom-wl listo: ${bw_ko#"$1"}"
	# Los drivers libres que reclaman estas tarjetas se apartan para que
	# las tome wl. ssb también lo usa b44 (cable Broadcom antiguo): si hay
	# una de esas, ssb se deja y se avisa.
	bw_ssb="blacklist ssb"
	for bw_d in /sys/bus/pci/devices/*; do
		[ "$(cat "$bw_d/vendor" 2>/dev/null)" = 0x14e4 ] || continue
		case "$(cat "$bw_d/device" 2>/dev/null)" in
			0x4401|0x4402|0x170c)
				bw_ssb="# ssb no se aparta: lo usa la tarjeta de cable b44"
				log "Aviso: hay una tarjeta de cable Broadcom b44; ssb no se aparta y el wifi podría no tomar el driver wl." ;;
		esac
	done
	mkdir -p "$1/etc/modprobe.d"
	cat > "$1/etc/modprobe.d/lazaro-broadcom-wl.conf" <<-EOF
	# Lázaro Linux: esta tarjeta wifi Broadcom ($bw_tarjeta) funciona con
	# el driver privativo wl (paquete broadcom-wl-src, compilado con akms).
	# Se apartan los drivers libres que la reclamarían. Para volver a
	# ellos, borra este archivo y reinicia.
	blacklist b43
	blacklist b43legacy
	blacklist bcma
	blacklist brcmsmac
	$bw_ssb
	EOF
	# wl se carga solo por el tipo de tarjeta; se pide también al arrancar.
	mkdir -p "$1/etc/modules-load.d"
	echo wl > "$1/etc/modules-load.d/lazaro-broadcom-wl.conf"
	echo "LAZARO-BROADCOM-OK ${bw_ko#"$1"}"
}

# --- NVIDIA con el controlador propietario -------------------------------
# docs/nvidia/ARQUITECTURA.md: solo en la Completa de 64 bits, que trae el
# sysroot glibc (carpeta nvidia/ de la ISO) y el paquete nvidia-open-src.
# Solo con la rama que lazaro-nvidia marca como lista (Turing y
# posteriores) y con los escritorios que usan LightDM y Xorg: los demás
# (GNOME, Plasma, Sway, XFCE Wayland) componen con la GPU desde un
# proceso musl y siguen con nouveau. Si algo falla, queda nouveau; en el
# sistema instalado, lazaro-nvidia.initd vuelve solo a nouveau si el
# controlador no arranca.
nvidia_raiz_iso() { # el .tar.zst del sysroot en la ISO, o nada
	nr_iso="$(repo_iso)"
	[ -n "$nr_iso" ] || return 1
	for nr_f in "${nr_iso%/apks}"/nvidia/lazaro-nvidia-raiz-*.tar.zst; do
		[ -f "$nr_f" ] && { echo "$nr_f"; return 0; }
	done
	return 1
}

paso_nvidia() { # RAIZ ESCRITORIO
	[ "$BITS32" = no ] || return 0
	[ "$LAZARO_EDICION" = completa ] || return 0
	command -v lazaro-nvidia >/dev/null 2>&1 || return 0
	# Las pruebas (QEMU no tiene una NVIDIA) lo fuerzan desde el menú: se
	# instala todo como para una Turing o posterior, y en el sistema
	# instalado lazaro-nvidia.initd tiene que volver solo a nouveau.
	if grep -qw 'lazaro.nvidia-propietario=forzar' /proc/cmdline 2>/dev/null; then
		log "Prueba: se simula una NVIDIA Turing o posterior."
		nv_tabla="$(LAZARO_ARCH=x86_64 lazaro-nvidia --rama moderna 2>/dev/null)" || return 0
	else
		nv_tabla="$(lazaro-nvidia --rama 2>/dev/null)" || return 0
	fi
	nv_ctl=$(printf '%s\n' "$nv_tabla" | sed -n 's/^CONTROLADOR=//p')
	nv_paq=$(printf '%s\n' "$nv_tabla" | sed -n 's/^PAQUETE=//p')
	nv_ver=$(printf '%s\n' "$nv_tabla" | sed -n 's/^VERSION=//p')
	nv_motivo=$(printf '%s\n' "$nv_tabla" | sed -n 's/^MOTIVO=//p')
	[ "$nv_ctl" != ninguno ] || return 0
	if [ "$nv_ctl" != propietario ] || [ "$nv_paq" != nvidia-open-src ]; then
		log "NVIDIA: queda nouveau ($nv_motivo)."
		echo "LAZARO-NVIDIA-NOUVEAU $nv_motivo"
		return 0
	fi
	case "$2" in
		xfce|mate|lxqt|icewm) ;;
		*)
			log "NVIDIA: el controlador propietario funciona con XFCE, MATE, LXQt o IceWM; con '$2' queda nouveau."
			echo "LAZARO-NVIDIA-NOUVEAU escritorio-$2"
			return 0 ;;
	esac
	nv_tar="$(nvidia_raiz_iso)" || {
		log "NVIDIA: la ISO no trae el sysroot; queda nouveau."
		echo "LAZARO-NVIDIA-NOUVEAU sin-sysroot"
		return 0
	}
	log "NVIDIA: se instala el controlador propietario $nv_ver (se compila el módulo y se copia el sysroot, tarda unos minutos)..."
	avance_iniciar "el controlador de NVIDIA" "$1"
	repos_solo_usb "$1" || true
	nv_rc=0
	en_destino "$1" apk add --no-progress nvidia-open-src zstd </dev/null >>"$LOG" 2>&1 || nv_rc=$?
	nv_src=/usr/src/nvidia-open-$nv_ver
	[ "$nv_rc" != 0 ] || [ -f "$1$nv_src/Makefile" ] || nv_rc=1
	# El módulo se compila aquí directo, como broadcom-wl (akms no puede
	# dentro del chroot del instalador); akms lo recompila solo con cada
	# kernel nuevo en el sistema instalado.
	nv_ok=""
	if [ "$nv_rc" = 0 ]; then
		nv_dev=""
		for nv_f in "$1"/usr/share/kernel/*/kernel.release; do
			[ -f "$nv_f" ] || continue
			nv_dev="$nv_dev linux-$(basename "$(dirname "$nv_f")")-dev"
		done
		# shellcheck disable=SC2086
		en_destino "$1" apk add --no-progress -t .lazaro-nvidia-compilar build-base $nv_dev </dev/null >>"$LOG" 2>&1 || nv_rc=$?
	fi
	if [ "$nv_rc" = 0 ]; then
		for nv_k in "$1"/lib/modules/*; do
			[ -d "$nv_k/build" ] || [ -L "$nv_k/build" ] || continue
			nv_kv="${nv_k##*/}"
			nv_c=0
			en_destino "$1" sh -c "rm -rf /tmp/lazaro-nv && cp -a '$nv_src' /tmp/lazaro-nv && cd /tmp/lazaro-nv && make -j\$(nproc) SYSSRC='/lib/modules/$nv_kv/build' modules && mkdir -p '/lib/modules/$nv_kv/extra/nvidia' && install -m 644 nvidia.ko nvidia-modeset.ko nvidia-drm.ko nvidia-uvm.ko '/lib/modules/$nv_kv/extra/nvidia/' && depmod -a '$nv_kv'" </dev/null >>"$LOG" 2>&1 || nv_c=$?
			rm -rf "$1/tmp/lazaro-nv"
			if [ "$nv_c" = 0 ] && [ -f "$nv_k/extra/nvidia/nvidia.ko" ]; then
				nv_ok="$nv_ok $nv_kv"
			else
				log "Aviso: falló la compilación del módulo de NVIDIA para el kernel $nv_kv (código $nv_c)."
			fi
		done
		en_destino "$1" apk del --no-progress .lazaro-nvidia-compilar </dev/null >>"$LOG" 2>&1 || true
	fi
	# El sysroot: se descomprime dentro del sistema nuevo (con su zstd).
	if [ -n "$nv_ok" ]; then
		nv_c=0
		cp "$nv_tar" "$1/tmp/lazaro-nvidia-raiz.tar.zst" || nv_c=$?
		[ "$nv_c" != 0 ] || en_destino "$1" sh -c 'rm -rf /opt/lazaro-nvidia/raiz && mkdir -p /opt/lazaro-nvidia/raiz && zstd -dc /tmp/lazaro-nvidia-raiz.tar.zst | tar -xpf - -C /opt/lazaro-nvidia/raiz' </dev/null >>"$LOG" 2>&1 || nv_c=$?
		rm -f "$1/tmp/lazaro-nvidia-raiz.tar.zst"
		[ "$nv_c" = 0 ] || { nv_ok=""; log "Aviso: no se pudo copiar el sysroot de NVIDIA (código $nv_c)."; }
	fi
	# lazaro-nvidia y sus archivos quedan en el sistema para --desactivar.
	if [ -n "$nv_ok" ]; then
		install -Dm755 /usr/sbin/lazaro-nvidia "$1/usr/local/sbin/lazaro-nvidia"
		mkdir -p "$1/usr/local/share/lazaro"
		rm -rf "$1/usr/local/share/lazaro/nvidia"
		cp -a "$DATOS/nvidia" "$1/usr/local/share/lazaro/nvidia"
		LAZARO_DESTINO="$1" LAZARO_NVIDIA_DATOS="$DATOS/nvidia" sh /usr/sbin/lazaro-nvidia --activar >>"$LOG" 2>&1 || { nv_ok=""; log "Aviso: lazaro-nvidia --activar falló."; }
	fi
	if [ -n "$nv_ok" ]; then
		# El initramfs, con nouveau en la lista negra desde el arranque.
		for nv_kv in $nv_ok; do
			en_destino "$1" mkinitfs "$nv_kv" </dev/null >>"$LOG" 2>&1 || log "Aviso: no se pudo rehacer el initramfs de $nv_kv."
		done
	fi
	repos_volver "$1"
	avance_parar
	if [ -z "$nv_ok" ]; then
		log "Aviso: no se pudo preparar el controlador de NVIDIA (detalles en $LOG). Queda nouveau."
		echo "LAZARO-NVIDIA-NO"
		return 0
	fi
	log "NVIDIA $nv_ver listo (kernel:$nv_ok). Si no arranca el escritorio, el sistema vuelve solo a nouveau."
	echo "LAZARO-NVIDIA-OK $nv_ver$nv_ok"
}

# --- Paso 1: sistema base -------------------------------------------------
paso_base() {
	raiz="${1%/}"
	de="$2"
	validar_escritorio "$de"
	mountpoint -q "$raiz" || die "$raiz no es un punto de montaje"

	iso="$(repo_iso)"
	red=no
	esperar_red && red=si
	log "Lázaro Linux $ISO_VERSION sobre Alpine $ALPINE_BRANCH"
	log "Repositorio de la ISO: ${iso:-ninguno}; internet: $red"
	if ! escritorio_offline "$de" && [ "$red" = no ]; then
		die "El escritorio '$de' se descarga de internet y no hay conexión. Conéctate a una red o elige uno de los que vienen en el USB: XFCE, MATE, LXQt, Sway o XFCE Wayland."
	fi
	[ -n "$iso" ] || [ "$red" = si ] || die "No se encontró el repositorio de la ISO ni hay internet."

	# setup-disk instala con los repositorios del sistema live. En la
	# Completa y la de 32 bits, solo el de la ISO: traen el sistema base y
	# todo el firmware, y así una red lenta o que se corta no puede dejar la
	# instalación colgada. La Ligera no trae todo el firmware (setup-disk
	# elige el del hardware detectado): ahí sigue usando internet si hay.
	# Internet vuelve para los pasos siguientes (escritorios que se
	# descargan, driver Broadcom, controladores, ajustes).
	red_base="$red"
	if [ -n "$iso" ] && { [ "$LAZARO_EDICION" = completa ] || [ "$BITS32" = si ]; }; then
		red_base=no
		log "El sistema base se instala desde el USB, sin descargar nada."
	fi
	escribir_repos /etc/apk/repositories "$iso" "$red_base"
	lz_apk update >>"$LOG" 2>&1 || log "Aviso: apk update terminó con errores (ver $LOG)."

	# Configuración inicial del destino. setup-disk la desempaqueta en la
	# raíz (opción -o, como si fuera un respaldo de lbu) y luego instala
	# todo lo que diga etc/apk/world.
	ovl="$(mktemp -d)"
	mkdir -p "$ovl/etc/apk"
	grep -v '^#' "$DATOS/paquetes-base" | grep -v '^$' > "$ovl/etc/apk/world"
	escribir_repos "$ovl/etc/apk/repositories" "$iso" "$red_base"
	echo lazaro > "$ovl/etc/hostname"
	for s in devfs:sysinit dmesg:sysinit mdev:sysinit hwdrivers:sysinit \
		hwclock:boot modules:boot sysctl:boot hostname:boot bootmisc:boot \
		syslog:boot networkmanager:default modemmanager:default chronyd:default acpid:default \
		crond:default mount-ro:shutdown killprocs:shutdown savecache:shutdown; do
		mkdir -p "$ovl/etc/runlevels/${s#*:}"
		ln -s "/etc/init.d/${s%:*}" "$ovl/etc/runlevels/${s#*:}/${s%:*}"
	done
	# Orden de arranque: polkit antes que NetworkManager y fwupd, y
	# ModemManager antes que NetworkManager. Si no, al encender
	# NetworkManager despierta a ModemManager por D-Bus, este a polkit, y
	# los servicios de OpenRC de los dos chocan con esos y quedan
	# "failed" (Acer Aspire 4739). Lo mismo hace ordenar_polkit de
	# desktop-postinstall.sh, y el arreglo 004 en equipos ya instalados.
	mkdir -p "$ovl/etc/conf.d"
	printf '%s\n' '# Lázaro: polkit arranca antes que quienes lo despiertan por D-Bus;' \
		'# si no, su servicio choca con ese polkit y queda "failed".' \
		'rc_before="networkmanager fwupd"' > "$ovl/etc/conf.d/polkit"
	printf '%s\n' '# Lázaro: ModemManager arranca antes que NetworkManager, que si no' \
		'# lo despierta por D-Bus y su servicio queda "failed".' \
		'rc_before="networkmanager"' > "$ovl/etc/conf.d/modemmanager"
	tar -C "$ovl" -czf /tmp/lazaro-destino.apkovl.tar.gz etc
	rm -rf "$ovl"

	log "Instalando el sistema base con setup-disk (puede tardar)..."
	# "splash" enciende la pantalla de arranque con el pulso (Plymouth).
	# No se usa en dos casos:
	# - Sin escritorio: el arranque se ve en texto, como en la consola, y
	#   ese sistema no tiene udev, que Plymouth necesita para encontrar la
	#   pantalla.
	# - GNOME: con Plymouth, GDM no logra abrir su pantalla de inicio al
	#   encender (prueba el modo X, que no está instalado, y se rinde).
	splash=" splash"
	case "$de" in ninguno | gnome) splash="" ;; esac
	avance_iniciar "el sistema base" "$raiz"
	if ! BOOTLOADER=grub KERNELOPTS="${LAZARO_KERNELOPTS:-quiet}$splash" \
		setup-disk -v -m sys -o /tmp/lazaro-destino.apkovl.tar.gz "$raiz" \
		>>"$LOG" 2>&1; then
		die "setup-disk falló (detalles en $LOG)"
	fi
	avance_parar
	# Con el sistema base ya en el disco, vuelven los repositorios de
	# internet (si hay conexión), en la live y en el sistema nuevo.
	escribir_repos /etc/apk/repositories "$iso" "$red"
	escribir_repos "$raiz/etc/apk/repositories" "$iso" "$red"
	# Comando lazaro-diagnostico (informe para pedir ayuda) y la versión
	# de la ISO con que se instaló, que el informe muestra.
	install -Dm755 /usr/sbin/lazaro-diagnostico "$raiz/usr/local/sbin/lazaro-diagnostico"
	install -Dm644 "$DATOS/version.env" "$raiz/usr/share/lazaro/version.env"
	# Traducción de los textos de las herramientas: idiomas/*.po y quienes
	# los leen (texto.sh para los programas de shell, lazaro_texto.py
	# para los de Python).
	install -Dm644 "$DATOS/texto.sh" "$raiz/usr/share/lazaro/texto.sh"
	install -Dm644 "$DATOS/lazaro_texto.py" "$raiz/usr/share/lazaro/lazaro_texto.py"
	rm -rf "$raiz/usr/share/lazaro/idiomas"
	cp -a "$DATOS/idiomas" "$raiz/usr/share/lazaro/"
	# Manual de Lázaro (PDF) y su acceso en el menú, "Manual de Lázaro".
	if [ -r /usr/share/doc/lazaro/manual-lazaro.pdf ]; then
		install -Dm644 /usr/share/doc/lazaro/manual-lazaro.pdf "$raiz/usr/share/doc/lazaro/manual-lazaro.pdf"
		install -Dm755 /usr/bin/lazaro-manual "$raiz/usr/local/bin/lazaro-manual"
		install -Dm644 /usr/share/applications/lazaro-manual.desktop "$raiz/usr/share/applications/lazaro-manual.desktop"
		sed -i 's|^Exec=lazaro-manual|Exec=/usr/local/bin/lazaro-manual|' \
			"$raiz/usr/share/applications/lazaro-manual.desktop"
	fi
	# btop mide la GPU Intel sin doas: un gancho de apk le da el permiso
	# CAP_PERFMON cada vez que se instala o actualiza (libcap-setcap se
	# instala siempre con los programas adicionales).
	install -Dm755 "$DATOS/btop-gpu.hook" "$raiz/etc/apk/commit_hooks.d/lazaro-btop-gpu.hook"
	# Fondo de pantalla de Lázaro (su logo). desktop-postinstall.sh lo usa
	# en IceWM si lo encuentra, por eso se copia antes de correrlo.
	if [ -d /usr/share/backgrounds/lazaro ]; then
		mkdir -p "$raiz/usr/share/backgrounds"
		cp -a /usr/share/backgrounds/lazaro "$raiz/usr/share/backgrounds/"
	fi
	# El tema del pulso no viene en ningún paquete: se copia el de la ISO.
	mkdir -p "$raiz/usr/share/plymouth/themes" "$raiz/etc/plymouth"
	cp -a /usr/share/plymouth/themes/lazaro "$raiz/usr/share/plymouth/themes/"
	cp /etc/plymouth/plymouthd.conf "$raiz/etc/plymouth/plymouthd.conf"
	if [ -n "$splash" ]; then
		install -m 755 /usr/share/lazaro/plymouth-salir "$raiz/etc/init.d/plymouth-salir"
		mkdir -p "$raiz/etc/runlevels/default"
		ln -sf /etc/init.d/plymouth-salir "$raiz/etc/runlevels/default/plymouth-salir"
	fi
	# Driver wifi Broadcom: en la Completa, desde el USB (trae el driver,
	# el compilador y las cabeceras del kernel); con internet solo si
	# desde el USB no se pudo.
	if completa_usb && broadcom_wl_tarjeta >/dev/null && repos_solo_usb "$raiz"; then
		log "Driver wifi Broadcom: se instala desde el USB, sin descargar nada."
		paso_broadcom "$raiz"
		if [ ! -e "$raiz/etc/modprobe.d/lazaro-broadcom-wl.conf" ] && repos_antes_con_red "$raiz"; then
			log "Aviso: desde el USB no se pudo preparar el driver Broadcom; se intenta de nuevo con internet."
			repos_volver "$raiz"
			paso_broadcom "$raiz"
		fi
		repos_volver "$raiz"
	else
		paso_broadcom "$raiz"
	fi
	log "Sistema base instalado."
}

# setup-desktop agrega la pantalla de inicio y sus servicios con
# "rc-update add" sin decir en qué nivel. Dentro del chroot no hay nivel
# en curso y OpenRC los pone en sysinit: la pantalla de inicio arrancaba
# entonces al principio del encendido y cerraba la animación del pulso.
# Se pasan al nivel default, donde van (también si quedaron de una
# instalación anterior en la misma partición).
servicios_a_default() {
	for svc in dbus elogind lightdm sddm gdm greetd; do
		[ -L "$1/etc/runlevels/sysinit/$svc" ] || continue
		rm -f "$1/etc/runlevels/sysinit/$svc"
		mkdir -p "$1/etc/runlevels/default"
		ln -sf "/etc/init.d/$svc" "$1/etc/runlevels/default/$svc"
		log "Servicio $svc: del nivel sysinit al default."
	done
}

# --- Paso 2: escritorio ---------------------------------------------------
# instalar_escritorio RAIZ ESCRITORIO COMANDO...: instala el escritorio con
# COMANDO dentro del sistema nuevo, vigilando que no se quede colgado
# (en_destino_vigilado). Si el escritorio viene en el USB (siempre en la
# Completa), solo desde el repositorio de la ISO: así no depende de
# internet aunque haya conexión. Si desde el USB falla y hay internet, se
# intenta otra vez con internet.
instalar_escritorio() { # RAIZ ESCRITORIO COMANDO...
	ie_raiz=$1
	ie_de=$2
	shift 2
	ie_rc=0
	if escritorio_offline "$ie_de" && repos_solo_usb "$ie_raiz"; then
		log "El escritorio se instala desde el USB, sin descargar nada."
		en_destino_vigilado "$ie_raiz" "$@" || ie_rc=$?
		if [ "$ie_rc" != 0 ] && repos_antes_con_red "$ie_raiz"; then
			log "Aviso: desde el USB terminó con error $ie_rc; se intenta de nuevo con internet."
			repos_volver "$ie_raiz"
			ie_rc=0
			en_destino_vigilado "$ie_raiz" "$@" || ie_rc=$?
		fi
		repos_volver "$ie_raiz"
		return "$ie_rc"
	fi
	en_destino_vigilado "$ie_raiz" "$@" || ie_rc=$?
	return "$ie_rc"
}

# IceWM con la base gráfica (ver paso_escritorio) e icewm_esta RAIZ: si
# sus paquetes principales quedaron instalados.
icewm_xorg() {
	en_destino_vigilado "$raiz" setup-xorg-base icewm lxsession lightdm lightdm-gtk-greeter \
		dbus dbus-x11 elogind polkit-elogind gvfs udisks2 font-dejavu
}

icewm_esta() { # RAIZ
	en_destino "$1" apk info -e xorg-server icewm lxsession lightdm >>"$LOG" 2>&1
}

escritorio_colgado() {
	printf '%s' "La descarga del escritorio se quedó detenida 3 veces (el servidor o la red dejaron de responder). Revisa la conexión a internet y vuelve a instalar, o elige un escritorio que venga en el USB. Detalles en $LOG"
}

paso_escritorio() {
	raiz="${1%/}"
	de="$2"
	validar_escritorio "$de"
	if [ "$de" = ninguno ]; then
		# Solo consola: queda una marca para que los ajustes no instalen
		# programas gráficos.
		mkdir -p "$raiz/etc/lazaro"
		: > "$raiz/etc/lazaro/sin-escritorio"
		# Si se reutilizó sin formatear una partición con un escritorio
		# anterior, su pantalla de inicio no debe volver a arrancar.
		for dm in lightdm sddm gdm greetd; do
			rm -f "$raiz"/etc/runlevels/*/"$dm"
		done
		servicios_a_default "$raiz"
		log "Sin escritorio: el sistema arrancará en modo texto."
		return 0
	fi
	if [ "$de" = icewm ]; then
		# IceWM no está en setup-desktop: la misma base gráfica y lo mínimo
		# para entrar (sesión de LXDE y LightDM), como lo instala
		# desktop-postinstall.sh --escritorio icewm. El script después
		# arma la barra, el menú y el tema (setup_icewm).
		log "Instalando el escritorio 'icewm' (IceWM moderno)..."
		avance_iniciar "el escritorio"
		# setup-xorg-base termina arrancando udev, lo que falla dentro del
		# chroot ("failed to acquire lock") aunque los paquetes ya quedaron
		# instalados: se mira que estén y se dejan los servicios de udev
		# en el arranque a mano.
		# Todo viene en el USB: solo el repositorio de la ISO (ver
		# instalar_escritorio). Si desde el USB faltó algún paquete y hay
		# internet, se intenta otra vez con internet.
		rc=0
		repos_solo_usb "$raiz" || true
		icewm_xorg || rc=$?
		if [ "$rc" != 0 ] && ! icewm_esta "$raiz" && repos_antes_con_red "$raiz"; then
			log "Aviso: desde el USB faltaron paquetes de IceWM; se intenta de nuevo con internet."
			repos_volver "$raiz"
			rc=0
			icewm_xorg || rc=$?
		fi
		repos_volver "$raiz"
		if [ "$rc" != 0 ]; then
			if ! icewm_esta "$raiz"; then
				[ "$rc" != 124 ] || die "$(escritorio_colgado)"
				die "no se pudo instalar IceWM (detalles en $LOG)"
			fi
			log "setup-xorg-base terminó con error $rc (udev no arranca dentro del chroot); los paquetes están instalados."
		fi
		for svc in udev udev-trigger udev-settle; do
			en_destino "$raiz" rc-update add "$svc" sysinit >>"$LOG" 2>&1 || true
		done
		en_destino "$raiz" rc-update add udev-postmount default >>"$LOG" 2>&1 || true
		for svc in dbus elogind lightdm; do
			en_destino "$raiz" rc-update add "$svc" default >>"$LOG" 2>&1 || true
		done
		avance_parar
		servicios_a_default "$raiz"
		log "Escritorio 'icewm' instalado."
		paso_nvidia "$raiz" icewm
		return 0
	fi
	log "Instalando el escritorio '$de' con setup-desktop..."
	avance_iniciar "el escritorio"
	rc=0
	instalar_escritorio "$raiz" "$de" setup-desktop "$de" || rc=$?
	[ "$rc" != 124 ] || die "$(escritorio_colgado)"
	[ "$rc" = 0 ] || die "setup-desktop $de falló (detalles en $LOG)"
	avance_parar
	servicios_a_default "$raiz"
	log "Escritorio '$de' instalado."
	paso_nvidia "$raiz" "$de"
}

# Programas adicionales que vienen en la ISO (ver LAZARO_EXTRAS en
# perfil/mkimg.lazaro.sh): se instalan desde el USB, sin internet y más
# rápido. desktop-postinstall.sh los encuentra después ya instalados; si
# algo falla aquí, el script lo intenta de nuevo por internet.
preinstalar_extras() { # RAIZ IDIOMA EXTRAS
	pe_iso="$(repo_iso)"
	[ -n "$pe_iso" ] || return 0
	pe_grafico=si
	[ ! -e "$1/etc/lazaro/sin-escritorio" ] || pe_grafico=no
	# libcap-setcap (40 kB): lo usa el gancho de btop (paso_base).
	pe_paq="libcap-setcap"
	# Las mismas tipografías que el script pone con cualquier escritorio.
	[ "$pe_grafico" = no ] || pe_paq="$pe_paq font-dejavu font-liberation font-liberation-sans-narrow font-noto font-noto-emoji"
	# La Bienvenida (lazaro-bienvenida) es Python con GTK 3.
	[ "$pe_grafico" = no ] || pe_paq="$pe_paq python3 py3-gobject3 gtk+3.0"
	# 32 bits: NetSurf siempre; Firefox, si se marcó, sale del USB.
	[ "$BITS32" = no ] || [ "$pe_grafico" = no ] || pe_paq="$pe_paq netsurf"
	for e in $3; do
		case "$e" in
			fastfetch|btop) pe_paq="${pe_paq:+$pe_paq }$e" ;;
			flatpak) [ "$pe_grafico" = no ] || [ "$BITS32" = si ] || pe_paq="$pe_paq flatpak" ;;
			# ff2mpv-rust: el "Play in MPV" de la extensión ff2mpv (paso_firefox_32).
			firefox) [ "$pe_grafico" = no ] || [ "$BITS32" = no ] || pe_paq="$pe_paq firefox ff2mpv-rust" ;;
			vlc) [ "$pe_grafico" = no ] || pe_paq="$pe_paq vlc vlc-qt" ;;
			# YouTube ligero: yt-dlp-ejs-rt-quickjs se pide aparte para que
			# yt-dlp use QuickJS (1 MB) y no arrastre Deno (41 MB).
			youtube) [ "$pe_grafico" = no ] || pe_paq="$pe_paq pipe-viewer pipe-viewer-gtk mpv yt-dlp yt-dlp-ejs-rt-quickjs" ;;
			libreoffice)
				[ "$pe_grafico" = no ] && continue
				pe_paq="$pe_paq libreoffice"
				case "$2" in es|es_*|es.*) pe_paq="$pe_paq libreoffice-lang-es" ;; esac ;;
		esac
	done
	[ -n "$pe_paq" ] || return 0
	log "Instalando desde el USB: $pe_paq"
	avance_iniciar "los programas adicionales"
	pe_rc=0
	# --no-network: solo el repositorio de la ISO, aunque haya internet.
	# shellcheck disable=SC2086
	en_destino "$1" apk add --no-network $pe_paq </dev/null >>"$LOG" 2>&1 || pe_rc=$?
	avance_parar
	if [ "$pe_rc" = 0 ]; then
		log "Programas adicionales instalados desde el USB."
	else
		log "Aviso: no se pudieron instalar desde el USB (código $pe_rc); se descargarán."
	fi
	paso_claudito "$1"
}

# Sway: su barra es Claudito Shell Fusion (paquete lazaro-claudito, con
# Quickshell), en lugar de waybar. waybar queda instalada: la pone
# desktop-postinstall.sh y lazaro-claudito vuelve a ella si Quickshell no
# arranca. Va aparte de los programas adicionales para que un problema
# aquí no deje a los demás sin instalar.
# La Completa lo trae en el USB. La Ligera no (no cabe): Sway arranca con
# waybar y lazaro-repositorio pone Claudito en el primer arranque con
# internet (marca /etc/lazaro/claudito-pendiente).
paso_claudito() { # RAIZ
	[ "$BITS32" = no ] || return 0
	en_destino "$1" apk info -e sway >/dev/null 2>&1 || return 0
	if [ "$LAZARO_EDICION" != completa ]; then
		mkdir -p "$1/etc/lazaro"
		: > "$1/etc/lazaro/claudito-pendiente"
		log "LAZARO-CLAUDITO-PENDIENTE: Sway empieza con waybar; Claudito Shell llega con internet."
		return 0
	fi
	log "Sway: instalando su barra, Claudito Shell Fusion, desde el USB"
	pc_rc=0
	en_destino "$1" apk add --no-network lazaro-claudito </dev/null >>"$LOG" 2>&1 || pc_rc=$?
	if [ "$pc_rc" = 0 ]; then
		log "LAZARO-CLAUDITO-INSTALADO"
	else
		log "Aviso: no se pudo instalar Claudito Shell (código $pc_rc); Sway queda con waybar."
	fi
}

# Controladores que le faltan al hardware (lazaro-controladores): se deja
# la herramienta en el sistema (menú "Controladores", aviso en la sesión
# y servicio de arranque) y se instala ya lo de Alpine: desde el USB o, si
# no está ahí, por internet; si no hay, lo hace el servicio al arrancar.
# Lo que se instaló en la live con permiso del usuario (firmware de b43,
# Prism54 o Intel 2100/2200 con su licencia aceptada) pasa al sistema.
paso_controladores() { # RAIZ
	pc_lc=/usr/sbin/lazaro-controladores
	[ -x "$pc_lc" ] || return 0
	install -Dm755 "$pc_lc" "$1/usr/local/sbin/lazaro-controladores"
	for pc_f in huellas.ids firmware-paquetes.tsv; do
		[ ! -e "$DATOS/$pc_f" ] || install -Dm644 "$DATOS/$pc_f" "$1/usr/share/lazaro/$pc_f"
	done
	if [ -d "$DATOS/firmware-licencia" ]; then
		mkdir -p "$1/usr/share/lazaro"
		cp -a "$DATOS/firmware-licencia" "$1/usr/share/lazaro/"
	fi
	install -Dm755 "$DATOS/lazaro-controladores.initd" "$1/etc/init.d/lazaro-controladores"
	mkdir -p "$1/etc/runlevels/default"
	ln -sf /etc/init.d/lazaro-controladores "$1/etc/runlevels/default/lazaro-controladores"
	if [ ! -e "$1/etc/lazaro/sin-escritorio" ]; then
		install -Dm644 /usr/share/applications/lazaro-controladores.desktop \
			"$1/usr/share/applications/lazaro-controladores.desktop"
		install -Dm644 /etc/xdg/autostart/lazaro-controladores.desktop \
			"$1/etc/xdg/autostart/lazaro-controladores.desktop"
		# Con la ruta completa, como la Bienvenida: hay sesiones
		# gráficas sin /usr/local/sbin en el PATH.
		sed -i 's|^Exec=lazaro-controladores|Exec=/usr/local/sbin/lazaro-controladores|' \
			"$1/usr/share/applications/lazaro-controladores.desktop" \
			"$1/etc/xdg/autostart/lazaro-controladores.desktop"
	fi
	# Decisiones y firmware de la live.
	if [ -e /etc/lazaro/controladores.conf ]; then
		install -Dm644 /etc/lazaro/controladores.conf "$1/etc/lazaro/controladores.conf"
	fi
	for pc_f in b43 b43legacy; do
		[ ! -d "/lib/firmware/$pc_f" ] || { mkdir -p "$1/lib/firmware"; cp -a "/lib/firmware/$pc_f" "$1/lib/firmware/"; }
	done
	for pc_f in /lib/firmware/isl38* /lib/firmware/ipw2[12]00*.fw; do
		[ -f "$pc_f" ] || continue
		mkdir -p "$1/lib/firmware"
		cp -a "$pc_f" "$1/lib/firmware/"
	done
	[ ! -d /usr/share/licenses/ipw2x00 ] || { mkdir -p "$1/usr/share/licenses"; cp -a /usr/share/licenses/ipw2x00 "$1/usr/share/licenses/"; }
	log "Controladores: revisando el hardware..."
	pc_lista="$(en_destino "$1" /usr/local/sbin/lazaro-controladores --revisar 2>>"$LOG")" || true
	printf '%s\n' "$pc_lista" | sed '/^$/d; s/^/  /' >>"$LOG"
	# Las pruebas en QEMU buscan esta línea en la consola.
	log "LAZARO-CONTROLADORES-FALTAN $(printf '%s\n' "$pc_lista" | cut -f2 | tr '\n' ' ')"
	avance_iniciar "los controladores"
	# En la Completa, desde el USB (trae todos los controladores de
	# Alpine); con internet solo si desde el USB faltó algo.
	pc_usb=no
	if completa_usb && repos_solo_usb "$1"; then
		pc_usb=si
		log "Controladores: se instalan desde el USB, sin descargar nada."
	fi
	pc_rc=0
	pc_salida="$(en_destino "$1" /usr/local/sbin/lazaro-controladores --instalar-alpine </dev/null 2>&1)" || pc_rc=$?
	if [ "$pc_usb" = si ]; then
		if [ "$pc_rc" != 0 ] && repos_antes_con_red "$1"; then
			log "Aviso: desde el USB faltaron controladores; se intenta de nuevo con internet."
			repos_volver "$1"
			pc_rc=0
			pc_salida="$pc_salida
$(en_destino "$1" /usr/local/sbin/lazaro-controladores --instalar-alpine </dev/null 2>&1)" || pc_rc=$?
		fi
		repos_volver "$1"
	fi
	# Licencia aceptada en la live pero el firmware no alcanzó a copiarse.
	for pc_c in ipw2100 ipw2200; do
		printf '%s\n' "$pc_lista" | grep -q "	$pc_c	" || continue
		grep -qx "$pc_c=aceptado" "$1/etc/lazaro/controladores.conf" 2>/dev/null || continue
		pc_salida="$pc_salida
$(en_destino "$1" /usr/local/sbin/lazaro-controladores --instalar "$pc_c" </dev/null 2>&1)" || pc_rc=1
	done
	avance_parar
	printf '%s\n' "$pc_salida" >>"$LOG"
	# Las pruebas en QEMU buscan estas líneas en la consola.
	printf '%s\n' "$pc_salida" | grep '^LAZARO-CONTROLADOR-' | while read -r pc_l; do log "$pc_l"; done
	[ "$pc_rc" = 0 ] || log "Aviso: faltaron controladores; se instalarán al arrancar con internet."
}

# Bienvenida: la ventana que presenta Lázaro y reúne sus herramientas
# (menú "Bienvenida"; se abre sola al iniciar sesión hasta que la persona
# desmarca la casilla). Los botones son los archivos de
# /usr/share/lazaro/bienvenida/funciones. lazaro-flatpak es su botón para
# activar Flatpak y abrir la tienda.
paso_bienvenida() { # RAIZ
	[ -x /usr/sbin/lazaro-bienvenida ] || return 0
	[ ! -e "$1/etc/lazaro/sin-escritorio" ] || return 0
	install -Dm755 /usr/sbin/lazaro-bienvenida "$1/usr/local/sbin/lazaro-bienvenida"
	[ ! -x /usr/sbin/lazaro-flatpak ] ||
		install -Dm755 /usr/sbin/lazaro-flatpak "$1/usr/local/sbin/lazaro-flatpak"
	# Botón "Nubes": lazaro-nubes y la aplicación Lázaro Nubes, que cada
	# persona instala en su carpeta con ese botón.
	if [ -x /usr/sbin/lazaro-nubes ] && [ -d "$DATOS/nubes-rclone" ]; then
		install -Dm755 /usr/sbin/lazaro-nubes "$1/usr/local/sbin/lazaro-nubes"
		rm -rf "$1/usr/share/lazaro/nubes-rclone"
		mkdir -p "$1/usr/share/lazaro"
		cp -a "$DATOS/nubes-rclone" "$1/usr/share/lazaro/"
	fi
	# La ventana de "Actualizar el sistema", con el aspecto de la Bienvenida.
	install -Dm755 /usr/sbin/lazaro-actualizador "$1/usr/local/sbin/lazaro-actualizador"
	mkdir -p "$1/usr/share/lazaro"
	rm -rf "$1/usr/share/lazaro/bienvenida"
	cp -a "$DATOS/bienvenida" "$1/usr/share/lazaro/"
	for pb_t in 64x64 256x256; do
		install -Dm644 "/usr/share/icons/hicolor/$pb_t/apps/lazaro-bienvenida.png" \
			"$1/usr/share/icons/hicolor/$pb_t/apps/lazaro-bienvenida.png"
	done
	install -Dm644 /usr/share/applications/lazaro-bienvenida.desktop \
		"$1/usr/share/applications/lazaro-bienvenida.desktop"
	install -Dm644 "$DATOS/lazaro-bienvenida-sesion.desktop" \
		"$1/etc/xdg/autostart/lazaro-bienvenida.desktop"
	# Con la ruta completa: hay sesiones gráficas que no traen
	# /usr/local/sbin en el PATH y no encontrarían el programa.
	sed -i 's|^Exec=lazaro-bienvenida|Exec=/usr/local/sbin/lazaro-bienvenida|' \
		"$1/usr/share/applications/lazaro-bienvenida.desktop" \
		"$1/etc/xdg/autostart/lazaro-bienvenida.desktop"
	log "LAZARO-BIENVENIDA-INSTALADA"
}

# Afinador (lazaro-afinador): ajustes para que el equipo responda mejor,
# todos reversibles. Se deja la herramienta, su servicio de arranque y el
# menú "Afinador", y se aplica lo recomendado para este hardware. Va al
# final, después de desktop-postinstall.sh, porque el script también
# toca /etc/default/grub (el bloque del afinador queda aparte y se
# conserva cuando el script vuelve a generar el menú de arranque).
paso_afinador() { # RAIZ
	pa_af=/usr/sbin/lazaro-afinador
	[ -x "$pa_af" ] || return 0
	install -Dm755 "$pa_af" "$1/usr/local/sbin/lazaro-afinador"
	install -Dm755 "$DATOS/lazaro-afinador.initd" "$1/etc/init.d/lazaro-afinador"
	# Kernel Lázaro: solo la herramienta; se instala si el usuario lo pide
	# (menú Afinador o lazaro-kernel --instalar).
	# (La ISO de 32 bits no lo trae: el kernel Lázaro es de 64 bits.)
	if [ -x /usr/sbin/lazaro-kernel ]; then
		install -Dm755 /usr/sbin/lazaro-kernel "$1/usr/local/sbin/lazaro-kernel"
		install -Dm644 "$DATOS/lazaro-kernel.initd" "$1/usr/share/lazaro/lazaro-kernel.initd"
	fi
	# Repositorio de Lázaro: con él las herramientas se actualizan solas
	# (paquete lazaro-herramientas, que se instala en el primer arranque
	# con internet).
	# También en 32 bits: el repositorio publica un índice aparte para x86
	# con las mismas herramientas (sin el kernel Lázaro, que es de 64).
	if [ -x /usr/sbin/lazaro-repositorio ]; then
		pa_r="$(/usr/sbin/lazaro-repositorio --activar --raiz "$1" 2>>"$LOG")" ||
			log "Aviso: no se pudo preparar el repositorio de Lázaro."
		# Las pruebas en QEMU buscan esta línea en la consola.
		[ -z "${pa_r:-}" ] || log "$pa_r"
	fi
	# Mejoras para equipos ya instalados (lazaro-arreglos): este sistema
	# ya las trae todas, así que se anotan como hechas sin correrlas.
	# lazaro-actualizar-raiz es lo que corre "Actualizar el sistema".
	if [ -x /usr/sbin/lazaro-arreglos ]; then
		install -Dm755 /usr/sbin/lazaro-arreglos "$1/usr/local/sbin/lazaro-arreglos"
		install -Dm755 /usr/sbin/lazaro-actualizar-raiz "$1/usr/local/sbin/lazaro-actualizar-raiz"
		rm -rf "$1/usr/share/lazaro/arreglos"
		cp -a "$DATOS/arreglos" "$1/usr/share/lazaro/"
		log "$("$1/usr/local/sbin/lazaro-arreglos" --marcar --raiz "$1" 2>>"$LOG")"
	fi
	[ -e "$1/etc/lazaro/sin-escritorio" ] ||
		install -Dm644 "$DATOS/lazaro-afinador.desktop" "$1/usr/share/applications/lazaro-afinador.desktop"
	[ ! -f "$1/usr/share/applications/lazaro-afinador.desktop" ] ||
		sed -i 's|^Exec=lazaro-afinador|Exec=/usr/local/sbin/lazaro-afinador|' \
			"$1/usr/share/applications/lazaro-afinador.desktop"
	pa_salida="$("$pa_af" --aplicar --raiz "$1" 2>>"$LOG")" || {
		log "Aviso: el afinador no pudo aplicar sus ajustes (se pueden poner después desde el menú)."
		return 0
	}
	"$pa_af" --revisar --raiz "$1" 2>/dev/null | sed 's/^/  /' >>"$LOG"
	# Las pruebas en QEMU buscan esta línea en la consola.
	log "$pa_salida"
	if grep -q 'lazaro-afinador: inicio' "$1/etc/default/grub" 2>/dev/null &&
		! en_destino "$1" grub-mkconfig -o /boot/grub/grub.cfg </dev/null >>"$LOG" 2>&1; then
		log "Aviso: no se pudo actualizar el menú de arranque con los ajustes del afinador."
	fi
}

# --- Paso 3: ajustes y desktop-postinstall.sh ----------------------------
paso_ajustes() {
	raiz="${1%/}"
	usuario="$2"
	idioma="${3:-es_CO.UTF-8}"
	teclado="${4:-latam}"
	variante="${5:-}"
	zona="${6:-America/Bogota}"
	extras="${7:-base flatpak}"
	# Programas para desktop-postinstall.sh --con. El script ya se encarga
	# de las dependencias: las apps de Flathub activan Flatpak y, sin
	# escritorio, descarta todo lo gráfico.
	con="firefox,actualizaciones"
	# 32 bits: Firefox solo si se marcó (llega como "firefox" en EXTRAS).
	[ "$BITS32" = no ] || con="actualizaciones"
	[ -e "$raiz/etc/lazaro/sin-escritorio" ] || con="$con,impresoras"
	for e in $extras; do
		case "$e" in
			base) ;;
			firefox) [ "$BITS32" = no ] || con="$con,firefox" ;;
			flatpak|onlyoffice|chrome|brave)
				# Flathub no publica aplicaciones de 32 bits.
				[ "$BITS32" = si ] || con="$con,$e" ;;
			fastfetch|btop|vlc|youtube|libreoffice)
				con="$con,$e" ;;
			*) log "Aviso: programa adicional desconocido '$e'; se omite." ;;
		esac
	done

	if [ -e "$raiz/usr/share/zoneinfo/$zona" ]; then
		ln -sf "/usr/share/zoneinfo/$zona" "$raiz/etc/localtime"
		echo "$zona" > "$raiz/etc/timezone"
	else
		log "Aviso: zona horaria desconocida '$zona'; se deja UTC."
	fi

	mkdir -p "$raiz/etc/profile.d"
	cat > "$raiz/etc/profile.d/00-idioma.sh" <<-EOF
	# Idioma elegido en el instalador de Lázaro Linux
	export LANG=$idioma
	EOF

	# Teclado de la sesión gráfica (Xorg)...
	mkdir -p "$raiz/etc/X11/xorg.conf.d"
	{
		echo 'Section "InputClass"'
		echo '    Identifier "system-keyboard"'
		echo '    MatchIsKeyboard "on"'
		echo "    Option \"XkbLayout\" \"$teclado\""
		[ -z "$variante" ] || echo "    Option \"XkbVariant\" \"$variante\""
		echo 'EndSection'
	} > "$raiz/etc/X11/xorg.conf.d/00-keyboard.conf"
	# ...y de la consola. setup-keymap instala kbd-bkeymaps con apk, que
	# antes de instalar renueva las listas de paquetes: en la Completa,
	# solo desde el USB (con internet bajaba las de Alpine y, con la red
	# cortándose, esperaba: VM, 23 de noviembre de 2026).
	tc_usb=no
	if completa_usb && repos_solo_usb "$raiz"; then
		tc_usb=si
	fi
	if ! en_destino "$raiz" setup-keymap "$teclado" "${variante:-$teclado}" \
		</dev/null >>"$LOG" 2>&1; then
		en_destino "$raiz" setup-keymap "$teclado" "$teclado" </dev/null >>"$LOG" 2>&1 \
			|| log "Aviso: no se pudo configurar el teclado de consola '$teclado'."
	fi
	[ "$tc_usb" = no ] || repos_volver "$raiz"

	mkdir -p "$raiz/etc/doas.d"
	# setenv: doas borra el entorno, y sin LANG los programas de
	# terminal abiertos con doas (btop, por ejemplo) no ven el UTF-8 ni
	# el idioma elegido.
	echo 'permit persist setenv { LANG LC_ALL } :wheel' > "$raiz/etc/doas.d/20-wheel.conf"
	chmod 0600 "$raiz/etc/doas.d/20-wheel.conf"

	preinstalar_extras "$raiz" "$idioma" "$extras"
	paso_controladores "$raiz"


	# desktop-postinstall.sh sin preguntas: --minimo deja todo en "no" y
	# --con marca lo elegido en Calamares. Las opciones se guardan para
	# repetirlas en el primer arranque si ahora no hay internet.
	install -Dm755 "$DATOS/desktop-postinstall.sh" \
		"$raiz/usr/libexec/lazaro/desktop-postinstall.sh"
	opt_teclado=no
	[ "$teclado" = latam ] && opt_teclado=latam
	# NVIDIA: "optimus" es el modo automático del script (decide según la
	# tarjeta, con las mismas reglas que lazaro-graficas en la live). Si
	# al arrancar la live se eligió lazaro.nvidia=activa o =seguro, se
	# respeta esa elección.
	nvidia=optimus
	if [ -r /run/lazaro/graficas ]; then
		nv_decision=$(sed -n 's/^DECISION=//p' /run/lazaro/graficas)
		if grep -qx 'MOTIVO=elegido' /run/lazaro/graficas; then
			nvidia="$nv_decision"
		fi
	fi
	args="--minimo --usuario $usuario --idioma $idioma --nvidia $nvidia --teclado $opt_teclado --con $con"
	mkdir -p "$raiz/etc/lazaro"
	echo "$args" > "$raiz/etc/lazaro/postinstall.args"

	install -Dm755 "$DATOS/lazaro-postinstalacion" "$raiz/usr/libexec/lazaro/lazaro-postinstalacion"
	red_ajustes=no
	esperar_red && red_ajustes=si
	# Solo con el repositorio de la ISO (sin repositorios de internet, el
	# script no espera la red y todo lo que instala viene en la ISO):
	# - Edición Completa: siempre, también con internet (ver completa_usb).
	# - 32 bits: cuando no hay internet.
	solo_usb=no
	if completa_usb; then
		solo_usb=si
		log "La configuración final se hace con lo que trae el USB, sin descargar nada."
	elif [ "$red_ajustes" = no ] && [ -n "$(repo_iso)" ] && [ "$BITS32" = si ]; then
		solo_usb=si
		log "Sin internet: la configuración final se hace con lo que trae el USB."
	fi
	if [ "$red_ajustes" = si ] || [ "$solo_usb" = si ]; then
		# Con internet (Ligera), el repositorio de la ISO sigue a mano
		# junto a los de internet: si la conexión se corta (wifi
		# inestable), lo que está en la ISO se instala igual.
		red_script="$red_ajustes"
		[ "$solo_usb" = no ] || red_script=no
		iso="$(repo_iso)"
		if [ -n "$iso" ] && montar_si_falta bind "$iso" "$raiz$iso"; then
			escribir_repos "$raiz/etc/apk/repositories" "$iso" "$red_script"
		fi
		# El script corre desde la sesión live: con --destino monta el
		# sistema nuevo y se ejecuta dentro de él.
		log "Ejecutando desktop-postinstall.sh --destino $raiz $args"
		avance_iniciar "la configuración final"
		pi=0
		# shellcheck disable=SC2086
		sh "$DATOS/desktop-postinstall.sh" --destino "$raiz" $args \
			</dev/null >>"$LOG" 2>&1 || pi=$?
		# Desde el USB falló y hay internet: otra vez, ahora con internet
		# (el script salta lo que ya quedó hecho).
		if [ "$pi" != 0 ] && [ "$red_script" = no ] && [ "$red_ajustes" = si ] && [ -n "$iso" ]; then
			log "Aviso: con lo del USB la configuración final terminó con error $pi; se intenta de nuevo con internet."
			escribir_repos "$raiz/etc/apk/repositories" "$iso" si
			pi=0
			# shellcheck disable=SC2086
			sh "$DATOS/desktop-postinstall.sh" --destino "$raiz" $args \
				</dev/null >>"$LOG" 2>&1 || pi=$?
		fi
		avance_parar
		desmontar_propios
		repos_definitivos "$raiz"
		# La lista de programas de la tienda de aplicaciones (catálogo de
		# Alpine) no viene en ningún paquete ni en el USB: sin repositorios
		# de internet el script no pudo bajarla. Con internet se baja ya
		# (unos pocos MB, no instala nada); si no, la tarea de cada hora
		# lo hace cuando haya conexión.
		# Es opcional: con una red lenta o que corta las descargas, la
		# tarea podía tener la instalación esperando hasta 20 minutos
		# (10 para instalar el programa que la baja y 10 para bajarla).
		# Aquí espera como mucho TIENDA_LIMITE segundos; lo que siga
		# vivo lo corta matar_restos al salir del sistema nuevo, y como
		# la tarea no dejó su marca de hecha, la tarea de cada hora lo
		# vuelve a intentar con el equipo ya instalado.
		if [ "$red_script" = no ] && [ "$red_ajustes" = si ] &&
			[ -x "$raiz/etc/periodic/hourly/alpine-tienda-catalogo" ]; then
			log "Descargando la lista de programas de la tienda (no instala nada; espera como mucho $((TIENDA_LIMITE / 60)) minutos)..."
			ti=0
			ti_desde=$(date +%s)
			en_destino "$raiz" timeout "$TIENDA_LIMITE" /etc/periodic/hourly/alpine-tienda-catalogo </dev/null >>"$LOG" 2>&1 || ti=$?
			if [ "$ti" = 0 ]; then
				log "LAZARO-TIENDA-AL-INSTALAR lista"
			# busybox timeout y el de coreutils no devuelven el mismo
			# número al cortar: se mira el tiempo que pasó.
			elif [ $(($(date +%s) - ti_desde)) -ge "$TIENDA_LIMITE" ]; then
				log "Aviso: la lista de la tienda no llegó en $((TIENDA_LIMITE / 60)) minutos (internet lento); se bajará sola una hora después del primer arranque con internet."
				log "LAZARO-TIENDA-AL-INSTALAR tiempo"
			else
				log "Aviso: no se pudo bajar la lista de la tienda; se bajará sola con internet."
				log "LAZARO-TIENDA-AL-INSTALAR fallo"
			fi
			cat "$raiz/var/log/alpine-tienda-catalogo.log" >>"$LOG" 2>/dev/null || true
		fi
		flatpak_desde_usb "$raiz" "$extras"
		if [ "$pi" = 0 ]; then
			log "desktop-postinstall.sh terminó bien."
		else
			log "Aviso: desktop-postinstall.sh falló; se repetirá en el primer arranque."
			programar_primer_arranque "$raiz"
		fi
	else
		repos_definitivos "$raiz"
		log "Sin internet: desktop-postinstall.sh se ejecutará en el primer arranque con red."
		programar_primer_arranque "$raiz"
	fi

	paso_firefox_32 "$raiz" "$extras"
	paso_firefox_idiomas "$raiz"
	paso_mpv_32 "$raiz"

	# 32 bits con SDDM (LXQt): las gráficas de esos equipos (Intel 945 y
	# parecidas) no logran dibujar las letras de la pantalla de inicio con
	# OpenGL: no se ve lo que se escribe ni los menús de arriba. Se dibuja
	# sin la tarjeta de video, que para esa pantalla alcanza de sobra.
	if [ "$BITS32" = si ] && [ -e "$raiz/usr/bin/sddm" ]; then
		mkdir -p "$raiz/etc/sddm.conf.d"
		cat > "$raiz/etc/sddm.conf.d/60-lazaro-32-bits.conf" <<-EOF
			# Lázaro Linux de 32 bits: la pantalla de inicio se dibuja sin OpenGL.
			[General]
			GreeterEnvironment=QT_QUICK_BACKEND=software
		EOF
		log "LAZARO-SDDM-SOFTWARE"
	fi
	paso_afinador "$raiz"
	paso_bienvenida "$raiz"

	cp "$LOG" "$raiz/var/log/lazaro-instalar.log" 2>/dev/null || true
	log "Instalación terminada."
}

# --- 32 bits: Firefox para equipos de 1 GB -------------------------------
# Si se marcó Firefox: tres extensiones y menos memoria, con la política
# de Firefox para todo el sistema (/etc/firefox/policies/policies.json).
#   - uBlock Origin: bloquea publicidad y rastreadores, que son buena
#     parte del trabajo del procesador al abrir una página.
#   - h264ify: YouTube en H.264, el formato que menos le cuesta a estos
#     procesadores (VP9 y AV1 los saturan).
#   - ff2mpv: clic derecho en un video > "Play in MPV": el video se abre
#     en mpv, mucho más liviano que dentro de Firefox (paquete
#     ff2mpv-rust, que hace de puente).
# Las extensiones van en la ISO (build.sh las descarga al compilar):
# Firefox las instala desde el disco la primera vez que abre, sin
# internet, y después se actualizan solas desde addons.mozilla.org.
# Menos procesos: 2 para las páginas y 1 por sitio; las pestañas en
# segundo plano se descargan si falta memoria.
paso_firefox_32() { # RAIZ EXTRAS
	[ "$BITS32" = si ] || return 0
	case " $2 " in *" firefox "*) ;; *) return 0 ;; esac
	ext=/usr/share/lazaro/firefox
	if ! ls "$ext"/*.xpi >/dev/null 2>&1; then
		log "Aviso: la ISO no trae las extensiones de Firefox; se omiten."
		return 0
	fi
	mkdir -p "$1$ext" "$1/etc/firefox/policies"
	cp "$ext"/*.xpi "$1$ext/"
	lista=""
	for x in "$1$ext"/*.xpi; do
		lista="$lista${lista:+, }\"${x#"$1"}\""
	done
	cat > "$1/etc/firefox/policies/policies.json" <<-EOF
	{
	  "policies": {
	    "Extensions": { "Install": [ $lista ] },
	    "DisableTelemetry": true,
	    "DisableFirefoxStudies": true,
	    "DisablePocket": true,
	    "Preferences": {
	      "dom.ipc.processCount": { "Value": 2, "Status": "default" },
	      "dom.ipc.processCount.webIsolated": { "Value": 1, "Status": "default" },
	      "browser.tabs.unloadOnLowMemory": { "Value": true, "Status": "default" },
	      "browser.sessionstore.interval": { "Value": 60000, "Status": "default" }
	    }
	  }
	}
	EOF
	# Puente de ff2mpv: Firefox lo busca por este nombre.
	mkdir -p "$1/usr/lib/mozilla/native-messaging-hosts"
	cat > "$1/usr/lib/mozilla/native-messaging-hosts/ff2mpv.json" <<-EOF
	{
	  "name": "ff2mpv",
	  "description": "ff2mpv: abre en mpv el video de la página",
	  "path": "/usr/bin/ff2mpv-rust",
	  "type": "stdio",
	  "allowed_extensions": ["ff2mpv@yossarian.net"]
	}
	EOF
	[ -x "$1/usr/bin/ff2mpv-rust" ] || log "Aviso: falta ff2mpv-rust; \"Play in MPV\" no funcionará."
	log "LAZARO-FIREFOX-32 extensiones=$(ls "$1$ext"/*.xpi | wc -l) ff2mpv=$([ -x "$1/usr/bin/ff2mpv-rust" ] && echo si || echo no)"
}

# --- 64 bits: Firefox en el idioma del sistema ------------------------------
# El Firefox de Alpine viene solo en inglés. La ISO trae los paquetes de
# idioma de Mozilla de su misma versión (build.sh): se dejan en el
# sistema nuevo, Firefox los instala desde el disco al abrir por primera
# vez (sin internet) y usa el idioma del sistema (intl.locale.requested
# vacío). Después se actualizan solos desde addons.mozilla.org.
paso_firefox_idiomas() { # RAIZ
	[ "$BITS32" = no ] || return 0
	[ -x "$1/usr/bin/firefox" ] || return 0
	fi_dir=/usr/share/lazaro/firefox-idiomas
	if ! ls "$fi_dir"/*.xpi >/dev/null 2>&1; then
		log "Aviso: la ISO no trae los idiomas de Firefox; Firefox los ofrecerá con internet."
		return 0
	fi
	# Ya hay reglas para Firefox (puestas a mano): no se pisan.
	if [ -e "$1/etc/firefox/policies/policies.json" ]; then
		log "Aviso: Firefox ya tiene reglas propias; no se agregan sus idiomas."
		return 0
	fi
	mkdir -p "$1$fi_dir" "$1/etc/firefox/policies"
	cp "$fi_dir"/*.xpi "$1$fi_dir/"
	fi_lista=""
	for x in "$1$fi_dir"/*.xpi; do
		fi_lista="$fi_lista${fi_lista:+, }\"${x#"$1"}\""
	done
	cat > "$1/etc/firefox/policies/policies.json" <<-EOF
	{
	  "policies": {
	    "Extensions": { "Install": [ $fi_lista ] },
	    "Preferences": {
	      "intl.locale.requested": { "Value": "", "Status": "default" }
	    }
	  }
	}
	EOF
	log "LAZARO-FIREFOX-IDIOMAS $(ls "$1$fi_dir"/*.xpi | wc -l)"
}

# --- 32 bits: mpv para procesadores viejos ---------------------------------
# desktop-postinstall.sh deja /etc/mpv/mpv.conf (480p, H.264, 360p con un
# núcleo). En 32 bits se agrega: escalado barato (perfil "fast"), sin el
# filtro de bloques de H.264 (lo más caro de decodificar; casi no se nota
# a 480p) y descartar cuadros antes que atrasar el audio.
paso_mpv_32() { # RAIZ
	[ "$BITS32" = si ] || return 0
	conf="$1/etc/mpv/mpv.conf"
	[ -f "$conf" ] || return 0
	grep -q '^# Lázaro de 32 bits' "$conf" && return 0
	cat >> "$conf" <<-'EOF'

	# Lázaro de 32 bits: menos trabajo para procesadores viejos.
	profile=fast
	vd-lavc-skiploopfilter=all
	vd-lavc-fast=yes
	framedrop=vo
	EOF
	log "LAZARO-MPV-32"
}

# --- Aplicaciones de Flathub desde el USB (edición Completa) -------------
# La ISO trae en flatpak/ un repositorio de Flatpak con OnlyOffice, Brave
# y su runtime (lo arma el flujo de GitHub Actions con las mismas
# versiones de Flathub). Se instalan con el flatpak de la sesión live
# directamente en /var/lib/flatpak del sistema nuevo: dentro del sistema
# montado flatpak no funciona bien (falta /proc/sys/kernel/random/boot_id).
# El repositorio del USB se agrega con el nombre "flathub" y, al terminar,
# se cambia por el Flathub de verdad (la descripción viene en la ISO):
# así las aplicaciones se actualizan desde Flathub como si se hubieran
# descargado de ahí. Lo que se instala sale de la lista de pendientes que
# deja desktop-postinstall.sh (/etc/flatpak-pendientes), para que el
# primer arranque no las descargue otra vez. Si algo falla, quedan
# pendientes como en la edición Ligera.
FP_INSTALACION=lazarodestino
flatpak_desde_usb() { # RAIZ EXTRAS
	fu_iso="$(repo_iso)"
	fu_dir="${fu_iso%/apks}/flatpak"
	[ -n "$fu_iso" ] && [ -d "$fu_dir/repo" ] || return 0
	[ ! -e "$1/etc/lazaro/sin-escritorio" ] || return 0
	fu_apps=""
	for e in $2; do
		case "$e" in
			onlyoffice) fu_app=org.onlyoffice.desktopeditors ;;
			brave) fu_app=com.brave.Browser ;;
			*) continue ;;
		esac
		grep -qx "$fu_app" "$fu_dir/aplicaciones" 2>/dev/null && fu_apps="$fu_apps $fu_app"
	done
	# Con Flatpak elegido sin OnlyOffice ni Brave, igual se deja Flathub
	# puesto desde el USB: desktop-postinstall.sh ya no lo agrega por
	# internet cuando instala solo desde el USB.
	if [ -z "$fu_apps" ]; then
		case " $2 " in *" flatpak "* | *" chrome "*) ;; *) return 0 ;; esac
	else
		log "Instalando desde el USB (Flathub):$fu_apps"
	fi
	if ! command -v flatpak >/dev/null 2>&1 &&
		! lz_apk add --no-network flatpak >>"$LOG" 2>&1; then
		log "Aviso: no se pudo preparar Flatpak en la sesión live; las aplicaciones se descargarán después del primer arranque."
		return 0
	fi
	mkdir -p "$1/var/lib/flatpak" /etc/flatpak/installations.d
	cat > "/etc/flatpak/installations.d/$FP_INSTALACION.conf" <<-EOF
	[Installation "$FP_INSTALACION"]
	Path=$1/var/lib/flatpak
	DisplayName=Sistema nuevo
	StorageType=harddisk
	EOF
	fp() { flatpak --installation="$FP_INSTALACION" "$@" </dev/null >>"$LOG" 2>&1; }
	# Borra Flathub solo si está (si no, flatpak deja "error: Remote
	# flathub not found" en el registro, que asusta y no es un error).
	fp_quitar_flathub() {
		flatpak --installation="$FP_INSTALACION" remotes 2>/dev/null | grep -q '^flathub' || return 0
		fp remote-delete --force flathub || true
	}
	fp_quitar_flathub
	if ! fp remote-add --no-gpg-verify flathub "file://$fu_dir/repo"; then
		log "Aviso: no se pudo abrir el repositorio de Flatpak del USB."
		fu_apps=""
	fi
	avance_iniciar "las aplicaciones de Flathub" "$1"
	fu_ok=""
	for a in $fu_apps; do
		if fp install -y --noninteractive flathub "$a"; then
			fu_ok="$fu_ok $a"
		else
			log "Aviso: $a no se pudo instalar desde el USB; se descargará después del primer arranque."
		fi
	done
	avance_parar
	fp_quitar_flathub
	# Agregar Flathub también intenta bajar su descripción por internet:
	# si la red se corta, flatpak esperaba hasta agotar su tiempo ("Timeout
	# was reached"). Con 60 segundos alcanza; si se corta antes de tiempo,
	# Flathub queda puesto igual y la descripción se baja en la primera
	# actualización.
	fu_rc=0
	timeout 60 flatpak --installation="$FP_INSTALACION" remote-add --if-not-exists --from flathub \
		"$fu_dir/flathub.flatpakrepo" </dev/null >>"$LOG" 2>&1 || fu_rc=$?
	if [ "$fu_rc" != 0 ] && ! flatpak --installation="$FP_INSTALACION" remotes 2>/dev/null | grep -q '^flathub'; then
		log "Aviso: no se pudo dejar Flathub configurado; se agregará después del primer arranque."
	fi
	rm -f "/etc/flatpak/installations.d/$FP_INSTALACION.conf"
	pend="$1/etc/flatpak-pendientes"
	for a in $fu_ok; do
		[ -e "$pend" ] || break
		{ grep -vx "$a" "$pend" || true; } > "$pend.nuevo"
		mv "$pend.nuevo" "$pend"
	done
	if [ -e "$pend" ] && [ ! -s "$pend" ]; then
		rm -f "$pend" "$1/etc/local.d/flatpak-pendientes.start"
	fi
	[ -z "$fu_ok" ] || log "Instaladas desde el USB:$fu_ok"
}

# Repositorios definitivos: los de internet (el de la ISO deja de
# existir al reiniciar), y fuera la llave que solo firmaba la ISO.
repos_definitivos() { # RAIZ
	escribir_repos "$1/etc/apk/repositories" "" si
	[ -z "${LAZARO_LLAVE:-}" ] || rm -f "$1/etc/apk/keys/$LAZARO_LLAVE"
}

# Inicio automático: queda anotado en /etc/lazaro/autologin y el
# servicio lazaro-autologin lo aplica en cada arranque a la pantalla de
# inicio que haya (también a una que se instale después).
paso_autologin() { # RAIZ USUARIO
	raiz="${1%/}"
	[ -n "$2" ] || return 0
	mkdir -p "$raiz/etc/lazaro"
	echo "$2" > "$raiz/etc/lazaro/autologin"
	install -Dm755 "$DATOS/lazaro-autologin" "$raiz/usr/libexec/lazaro/lazaro-autologin"
	install -Dm755 "$DATOS/lazaro-autologin.initd" "$raiz/etc/init.d/lazaro-autologin"
	mkdir -p "$raiz/etc/runlevels/default"
	ln -sf /etc/init.d/lazaro-autologin "$raiz/etc/runlevels/default/lazaro-autologin"
	en_destino "$raiz" /usr/libexec/lazaro/lazaro-autologin >>"$LOG" 2>&1 \
		|| log "Aviso: no se pudo configurar el inicio automático ahora; se hará al arrancar."
	log "Inicio automático de la sesión para '$2'."
}

programar_primer_arranque() {
	install -Dm755 "$DATOS/lazaro-primer-arranque.initd" \
		"$1/etc/init.d/lazaro-primer-arranque"
	mkdir -p "$1/etc/runlevels/default"
	ln -sf /etc/init.d/lazaro-primer-arranque "$1/etc/runlevels/default/lazaro-primer-arranque"
	aviso_consola "$1"
	avisar_primer_arranque
}

# Mientras falte la configuración final, el sistema arranca a la consola de
# texto: el aviso va en /etc/issue (se ve sobre "login:") y en /etc/motd
# (se ve al entrar). lazaro-primer-arranque devuelve los originales al
# terminar.
aviso_consola() { # RAIZ
	mkdir -p "$1/etc/lazaro"
	if [ -e "$1/etc/lazaro/sin-escritorio" ]; then
		falta="los programas y ajustes elegidos"
		luego="se completa solo."
	else
		falta="la barra completa, la pantalla de inicio y los programas elegidos"
		luego="se completa solo y luego aparece la pantalla de inicio."
	fi
	for f in issue motd; do
		[ -e "$1/etc/lazaro/$f.original" ] || cp -p "$1/etc/$f" "$1/etc/lazaro/$f.original" 2>/dev/null \
			|| : > "$1/etc/lazaro/$f.original"
		{
			cat "$1/etc/lazaro/$f.original"
			cat <<AVISO

  *** Lázaro Linux todavía está terminando de configurarse ***
  Falta instalar $falta,
  porque no hubo internet al final de la instalación.

  Conecta el equipo a internet y espera unos minutos:
  $luego
  No hace falta reiniciar.

  Sin cable de red, conecta el wifi entrando aquí y escribiendo:
      nmcli device wifi connect "NOMBRE-DE-LA-RED" --ask
  Registro: /var/log/desktop-postinstall.log

AVISO
		} > "$1/etc/$f"
	done
}

# Calamares termina igual con o sin la configuración final, así que se
# avisa aparte de que queda para el primer arranque. La ventana queda
# abierta junto a "Terminado" (no detiene la instalación). Sin pantalla
# (pruebas automáticas) no se muestra nada.
avisar_primer_arranque() {
	[ -n "${DISPLAY:-}" ] && command -v zenity >/dev/null 2>&1 || return 0
	setsid zenity --info --title="$(_ 'Lázaro Linux')" --width=520 --text="$(_ '<b>La instalación terminó, pero falta la configuración final.</b>

No hubo internet al final de la instalación, así que la barra completa, la pantalla de inicio y los programas elegidos se instalarán en el primer arranque.

<b>Qué hacer:</b> al encender el equipo, conéctate a internet y espera unos minutos. Cuando termine, la pantalla de inicio aparece sola; entra desde ella (no desde la consola de texto). No hace falta reiniciar.

<small><b>Explicación técnica:</b> la configuración final la hace desktop-postinstall.sh, que descarga paquetes y por eso necesita red. En el primer arranque un servicio de OpenRC (lazaro-primer-arranque) lo ejecuta en segundo plano en cuanto hay internet. OpenRC enciende los servicios del arranque una sola vez y en orden: lo que el script habilita después (la pantalla de inicio, elogind, polkit, cupsd...) quedaría apagado hasta el siguiente arranque. Por eso, al terminar, ese servicio los enciende él mismo. La barra, el idioma y los grupos del usuario se leen al iniciar sesión: una sesión abierta por consola antes de terminar sigue con lo anterior. Registros: /var/log/desktop-postinstall.log y /var/log/lazaro-primer-arranque.log</small>')" \
		</dev/null >/dev/null 2>&1 &
}

# --- Instalación desatendida (pruebas automáticas) -----------------------
# Los archivos que solo usan las pruebas están en $PRUEBAS y se copian al
# sistema instalado; aquí queda solo lo que depende de esta instalación.
PRUEBAS="$DATOS/pruebas"

# Borra el disco, lo particiona (GPT con partición EFI en UEFI, MBR en
# BIOS) y monta la raíz en $raiz.
auto_particionar() { # DISCO
	case "$1" in
		*[0-9]) p="${1}p" ;;
		*) p="$1" ;;
	esac
	if [ -d /sys/firmware/efi ]; then
		printf 'label: gpt\nsize=300M, type=uefi\ntype=linux\n' | sfdisk --wipe always "$1" >>"$LOG" 2>&1
		udevadm settle 2>/dev/null || sleep 2
		mkfs.vfat -F 32 -n EFI "${p}1" >>"$LOG" 2>&1
		mkfs.ext4 -q -F -L lazaro "${p}2"
		mkdir -p "$raiz"
		mount -t ext4 "${p}2" "$raiz" || die "no se pudo montar ${p}2 en $raiz"
		mkdir -p "$raiz/boot/efi"
		mount -t vfat "${p}1" "$raiz/boot/efi" || die "no se pudo montar ${p}1 en $raiz/boot/efi"
	else
		printf 'label: dos\ntype=83, bootable\n' | sfdisk --wipe always "$1" >>"$LOG" 2>&1
		udevadm settle 2>/dev/null || sleep 2
		mkfs.ext4 -q -F -L lazaro "${p}1"
		mkdir -p "$raiz"
		mount -t ext4 "${p}1" "$raiz" || die "no se pudo montar ${p}1 en $raiz"
	fi
}

# Lo que en Calamares hace el módulo "users" (los mismos grupos que
# users.conf). Con CLAVE_ROOT=si, root recibe la misma contraseña, como
# hace Calamares con doReusePassword.
crear_usuario() { # USUARIO NOMBRE CLAVE EQUIPO [CLAVE_ROOT]
	en_destino "$raiz" adduser -D -g "$2" -s /bin/ash "$1" >>"$LOG" 2>&1 \
		|| die "no se pudo crear el usuario $1"
	printf '%s:%s\n' "$1" "$3" | en_destino "$raiz" chpasswd >>"$LOG" 2>&1 \
		|| die "no se pudo poner la contraseña de $1"
	if [ "${5:-no}" = si ]; then
		printf 'root:%s\n' "$3" | en_destino "$raiz" chpasswd >>"$LOG" 2>&1 || true
	fi
	for g in wheel audio video netdev input plugdev lp users; do
		en_destino "$raiz" addgroup "$1" "$g" >>"$LOG" 2>&1 || true
	done
	echo "$4" > "$raiz/etc/hostname"
	printf '127.0.0.1\tlocalhost\n127.0.1.1\t%s\n::1\t\tlocalhost\n' "$4" > "$raiz/etc/hosts"
}

# Flatpak viene por defecto: con red, Flathub debe quedar agregado.
auto_revisar_flatpak() {
	[ "$BITS32" = no ] || return 0
	[ ! -e "$raiz/etc/lazaro/sin-escritorio" ] && hay_red || return 0
	# Se lee la configuración en vez de ejecutar flatpak dentro del
	# sistema instalado: un proceso que quede vivo ahí impide desmontarlo.
	if grep -q '^\[remote "flathub"\]' "$raiz/var/lib/flatpak/repo/config" 2>/dev/null; then
		echo "LAZARO-FLATPAK-OK"
	else
		echo "LAZARO-FLATPAK-NO"
		grep -n -i -A6 "flatpak" "$raiz/var/log/desktop-postinstall.log" 2>&1 | head -n 40
	fi
}

# Recorrido real de la resolución: "prueba" entra sola a su sesión,
# cambia la pantalla a 800x600, la prueba cierra la sesión y la
# pantalla de inicio debe volver con 800x600 (LightDM o SDDM). Con
# GDM la prueba reinicia, porque GDM solo la toma al arrancar.
auto_prueba_resolucion() { # ESCRITORIO
	pdm=""
	[ -f "$raiz/etc/lightdm/lightdm.conf.d/50-pantalla-inicio.conf" ] && pdm=lightdm
	[ -f "$raiz/etc/sddm.conf.d/50-pantalla-inicio.conf" ] && pdm=sddm
	[ -f "$raiz/etc/init.d/pantalla-inicio-gdm" ] && pdm=gdm
	# Inicio automático de "prueba" según la pantalla de inicio.
	if [ "$pdm" = lightdm ]; then
		en_destino "$raiz" addgroup -S autologin >>"$LOG" 2>&1 || true
		en_destino "$raiz" addgroup prueba autologin >>"$LOG" 2>&1 || true
		# IceWM entra por la sesión con apariencia de LXDE (icewm.desktop,
		# del paquete, abre IceWM solo, sin lxsession).
		psesion="$1"
		if [ "$1" = icewm ] && [ -f "$raiz/usr/share/xsessions/icewm-lxde.desktop" ]; then
			psesion=icewm-lxde
		fi
		cat > "$raiz/etc/lightdm/lightdm.conf.d/90-lazaro-prueba.conf" <<-EOF
		[Seat:*]
		autologin-user=prueba
		autologin-user-timeout=0
		autologin-session=$psesion
		EOF
	elif [ "$pdm" = sddm ]; then
		# Plasma entra en su sesión Wayland (la predeterminada).
		sesion=""
		for f in "$raiz/usr/share/wayland-sessions/$1.desktop" \
			"$raiz/usr/share/xsessions/$1.desktop"; do
			[ -f "$f" ] && { sesion="${f##*/}"; break; }
		done
		cat > "$raiz/etc/sddm.conf.d/90-lazaro-prueba.conf" <<-EOF
		[Autologin]
		User=prueba
		Session=${sesion:-$1.desktop}
		EOF
	elif [ "$pdm" = gdm ]; then
		# Se guarda el custom.conf original y zz-lazaro-prueba.start lo
		# repone antes de reiniciar.
		mkdir -p "$raiz/etc/gdm"
		if [ -f "$raiz/etc/gdm/custom.conf" ]; then
			cp "$raiz/etc/gdm/custom.conf" "$raiz/etc/lazaro/gdm-custom.conf.orig"
		fi
		cat > "$raiz/etc/gdm/custom.conf" <<-EOF
		[daemon]
		AutomaticLoginEnable=True
		AutomaticLogin=prueba
		EOF
	fi
	[ -n "$pdm" ] || return 0
	# zz-lazaro-prueba.start sabe así qué pantalla de inicio revisar.
	echo "$pdm" > "$raiz/etc/lazaro/prueba-pantalla"
	# Traza de "guardar" para el diagnóstico.
	sed -i 's|^Exec=.*|Exec=sh -c "sh -x /usr/local/libexec/pantalla-inicio/guardar 2>/tmp/guardar-traza.log"|' \
		"$raiz/etc/xdg/autostart/pantalla-inicio.desktop"
	# Al entrar, la sesión del usuario elige 800x600.
	mkdir -p "$raiz/usr/local/bin"
	install -m 755 "$PRUEBAS/lazaro-prueba-800x600" "$raiz/usr/local/bin/lazaro-prueba-800x600"
	install -m 644 "$PRUEBAS/zz-lazaro-prueba-resolucion.desktop" \
		"$raiz/etc/xdg/autostart/zz-lazaro-prueba-resolucion.desktop"
}

# Al arrancar el sistema instalado: mirar la pantalla de arranque
# mientras está en pie (lazaro-prueba-plymouth, en el nivel boot: al
# llegar a "local" puede haberla cerrado ya la pantalla de inicio) y
# luego informar por el puerto serie y apagar (zz-lazaro-prueba.start).
auto_prueba_arranque() {
	install -m 755 "$PRUEBAS/lazaro-prueba-plymouth" "$raiz/etc/init.d/lazaro-prueba-plymouth"
	mkdir -p "$raiz/etc/runlevels/boot"
	ln -sf /etc/init.d/lazaro-prueba-plymouth "$raiz/etc/runlevels/boot/lazaro-prueba-plymouth"
	mkdir -p "$raiz/etc/local.d"
	install -m 755 "$PRUEBAS/zz-lazaro-prueba.start" "$raiz/etc/local.d/zz-lazaro-prueba.start"
	ln -sf /etc/init.d/local "$raiz/etc/runlevels/default/local"
}

# Instalación completa en un disco entero, sin Calamares (la usan "auto"
# y "texto"): lo mismo que hace Calamares con particionado automático.
instalar_disco() { # DISCO ESCRITORIO USUARIO NOMBRE CLAVE EQUIPO IDIOMA TECLADO VARIANTE ZONA EXTRAS CLAVE_ROOT
	disco="$1"; de="$2"
	validar_escritorio "$de"
	[ -b "$disco" ] || die "$disco no es un disco"
	raiz=/mnt/lazaro
	# Antes de borrar el disco: que se puedan conseguir los paquetes.
	# paso_base lo vuelve a revisar, pero ahí el disco ya está borrado.
	if ! escritorio_offline "$de" || [ -z "$(repo_iso)" ]; then
		esperar_red || die "Sin internet: no se puede instalar '$de' (no se cambió nada en el disco). Conéctate a una red o elige XFCE, MATE, LXQt, Sway o XFCE Wayland."
	fi
	auto_particionar "$disco"
	paso_base "$raiz" "$de"
	crear_usuario "$3" "$4" "$5" "$6" "${12}"
	paso_escritorio "$raiz" "$de"
	# Si los ajustes se cuelgan, la prueba debe mostrar dónde: cada 4
	# minutos se informa por el puerto serie qué está corriendo.
	vigia=""
	if [ "${LAZARO_VIGIA:-no}" = si ]; then
		(
			while sleep 240; do
				echo "--- vigilancia $(date +%H:%M:%S) ---"
				tail -n 12 "$raiz/var/log/desktop-postinstall.log" 2>/dev/null
				ps -o pid,etime,args 2>/dev/null | grep -v -e '\[' -e 'ps -o' -e 'sleep 240' | tail -n 25
			done
		) >&2 &
		vigia=$!
	fi
	paso_ajustes "$raiz" "$3" "$7" "$8" "$9" "${10}" "${11}"
	[ -z "$vigia" ] || kill "$vigia" 2>/dev/null || true
}

desmontar_destino() {
	sync
	[ ! -d "$raiz/boot/efi" ] || ! mountpoint -q "$raiz/boot/efi" || umount "$raiz/boot/efi"
	umount "$raiz"
}

# Edición Completa: OnlyOffice y Brave deben quedar instalados desde el
# USB (también sin internet), con Flathub como origen.
auto_flathub=""
[ "$LAZARO_EDICION" != completa ] || auto_flathub=" onlyoffice brave"
# 32 bits: como en Calamares, con la casilla de Firefox marcada.
[ "$BITS32" = no ] || auto_flathub=" firefox"
auto_revisar_flatpak_usb() {
	[ "$LAZARO_EDICION" = completa ] || return 0
	for a in org.onlyoffice.desktopeditors com.brave.Browser; do
		if [ -d "$raiz/var/lib/flatpak/app/$a/current" ] && ! grep -qx "$a" "$raiz/etc/flatpak-pendientes" 2>/dev/null; then
			echo "LAZARO-FLATPAK-USB-OK $a"
		else
			echo "LAZARO-FLATPAK-USB-NO $a"
			grep -n -i -B2 -A8 "$a" "$LOG" 2>&1 | tail -n 40
		fi
	done
	if grep -q '^\[remote "flathub"\]' "$raiz/var/lib/flatpak/repo/config" 2>/dev/null &&
		grep -A3 '^\[remote "flathub"\]' "$raiz/var/lib/flatpak/repo/config" | grep -q 'dl.flathub.org'; then
		echo "LAZARO-FLATHUB-ORIGEN-OK"
	else
		echo "LAZARO-FLATHUB-ORIGEN-NO"
		cat "$raiz/var/lib/flatpak/repo/config" 2>&1 | head -n 30
	fi
}

paso_auto() {
	log "Instalación desatendida en $1 con '$2' (se borra el disco)"
	# Usuario "prueba", contraseña "lazaro". Fastfetch, el programa
	# adicional más liviano: la prueba comprueba que lo marcado en
	# "Software adicional" se instala.
	# lazaro.capturas=si (pruebas/qemu.sh capturas): en lugar de las
	# pruebas, el sistema instalado fotografía sus programas para el
	# Manual de Lázaro. Lleva todo el software adicional y entra solo.
	if grep -qw 'lazaro.capturas=si' /proc/cmdline 2>/dev/null; then
		LAZARO_VIGIA=si instalar_disco "$1" "$2" prueba "Prueba" lazaro lazaro-prueba \
			es_ES.UTF-8 es "" Europe/Madrid "base flatpak fastfetch btop youtube libreoffice vlc" no
		paso_autologin "$raiz" prueba
		mkdir -p "$raiz/etc/local.d"
		install -m 755 "$PRUEBAS/zz-lazaro-capturas.start" "$raiz/etc/local.d/zz-lazaro-capturas.start"
		ln -sf /etc/init.d/local "$raiz/etc/runlevels/default/local"
		desmontar_destino
		log "Instalación desatendida terminada (capturas para el manual)."
		return 0
	fi
	LAZARO_VIGIA=si instalar_disco "$1" "$2" prueba "Prueba" lazaro lazaro-prueba \
		es_CO.UTF-8 latam "" America/Bogota "base flatpak fastfetch btop youtube$auto_flathub" no
	auto_revisar_flatpak
	auto_revisar_flatpak_usb
	auto_prueba_resolucion "$2"
	auto_prueba_arranque
	desmontar_destino
	log "Instalación desatendida terminada."
}

# Instalación desde la consola (lazaro-instalar-texto, cuando la sesión
# gráfica no abre). La contraseña llega en LAZARO_CLAVE, no como
# argumento, para que no se vea en la lista de procesos; root recibe la
# misma, como en Calamares.
paso_texto() { # DISCO ESCRITORIO USUARIO NOMBRE EQUIPO IDIOMA TECLADO VARIANTE ZONA [EXTRAS]
	# Se saca del entorno enseguida: si no, la heredaban todos los
	# programas que corre la instalación.
	clave_texto="${LAZARO_CLAVE:-}"
	unset LAZARO_CLAVE
	[ -n "$clave_texto" ] || die "falta la contraseña (LAZARO_CLAVE)"
	log "Instalación desde la consola en $1 con '$2' (se borra el disco)"
	instalar_disco "$1" "$2" "$3" "$4" "$clave_texto" "$5" "$6" "$7" "$8" "$9" "${10:-base}" si
	clave_texto=""
	desmontar_destino
	log "Instalación terminada."
}

orden="${1:-}"
[ $# -gt 0 ] && shift
[ -z "$orden" ] || hora "paso $orden"
case "$orden" in
	base)       [ $# -eq 2 ] || die "uso: lazaro-instalar base RAIZ ESCRITORIO"; paso_base "$@" ;;
	escritorio) [ $# -eq 2 ] || die "uso: lazaro-instalar escritorio RAIZ ESCRITORIO"; paso_escritorio "$@" ;;
	ajustes)    [ $# -ge 2 ] || die "uso: lazaro-instalar ajustes RAIZ USUARIO [IDIOMA TECLADO VARIANTE ZONA EXTRAS]"; paso_ajustes "$@" ;;
	autologin)  [ $# -eq 2 ] || die "uso: lazaro-instalar autologin RAIZ USUARIO"; paso_autologin "$@" ;;
	auto)       [ $# -eq 2 ] || die "uso: lazaro-instalar auto DISCO ESCRITORIO"; paso_auto "$@" ;;
	red)        esperar_red ;;
	texto)      [ $# -ge 9 ] || die "uso: lazaro-instalar texto DISCO ESCRITORIO USUARIO NOMBRE EQUIPO IDIOMA TECLADO VARIANTE ZONA [EXTRAS]"; paso_texto "$@" ;;
	*)
		sed -n '2,/^$/s/^# \{0,1\}//p' "$0" >&2
		exit 1
		;;
esac
