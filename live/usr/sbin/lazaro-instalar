#!/bin/sh
# lazaro-instalar: pasos de instalación de Lázaro Linux.
#
# Calamares llama a cada paso desde sus módulos shellprocess (ver
# /etc/calamares/modules/shellprocess-*.conf). Las pruebas automáticas
# usan "auto", que hace lo mismo sin interfaz gráfica.
#
# El trabajo pesado lo hacen las herramientas oficiales de Alpine:
#   setup-disk    sistema base, fstab, initramfs, kernel, firmware y GRUB
#                 (BIOS y UEFI) sobre la raíz que montó Calamares
#   setup-desktop el escritorio elegido
# y al final se ejecuta desktop-postinstall.sh.
#
# Uso:
#   lazaro-instalar base RAIZ ESCRITORIO
#   lazaro-instalar escritorio RAIZ ESCRITORIO
#   lazaro-instalar ajustes RAIZ USUARIO IDIOMA TECLADO VARIANTE ZONA [EXTRAS]
#     EXTRAS: lo marcado en "Software adicional", separado por espacios,
#     detrás de "base": fastfetch btop vlc libreoffice (Alpine) y
#     flatpak onlyoffice chrome brave (Flathub). Sin EXTRAS: "base flatpak".
#   lazaro-instalar autologin RAIZ USUARIO
#     Inicio de sesión automático para USUARIO (casilla de Calamares).
#   lazaro-instalar texto DISCO ESCRITORIO USUARIO NOMBRE EQUIPO IDIOMA
#     TECLADO VARIANTE ZONA [EXTRAS]           (¡BORRA EL DISCO COMPLETO!)
#     Instalación desde la consola (lazaro-instalar-texto); la contraseña
#     va en la variable LAZARO_CLAVE.
#   lazaro-instalar red
#     Termina bien si hay internet (lo usa lazaro-instalar-texto).
#   lazaro-instalar auto DISCO ESCRITORIO     (¡BORRA EL DISCO COMPLETO!)
#     Solo pruebas: además deja en el disco las comprobaciones de
#     /usr/share/lazaro/pruebas, que informan por el puerto serie.

set -eu

LOG=/var/log/lazaro-instalar.log
DATOS=/usr/share/lazaro
# ALPINE_BRANCH, ALPINE_MIRROR, ISO_VERSION, LAZARO_LLAVE (de build.sh)
. "$DATOS/version.env"
ARCH="$(apk --print-arch)"
ESCRITORIOS="xfce xfce-wayland gnome plasma mate sway lxqt ninguno"
# El único escritorio cuyos paquetes van dentro de la ISO.
# Escritorios que vienen completos en la ISO (LAZARO_ESCRITORIOS en
# perfil/mkimg.lazaro.sh); los demás se descargan.
ESCRITORIOS_OFFLINE="xfce mate lxqt sway xfce-wayland ninguno"

log() { printf '[lazaro] %s\n' "$*" | tee -a "$LOG" >&2; }
die() { log "ERROR: $*"; exit 1; }

# --- Avance visible en Calamares ----------------------------------------
# Calamares muestra en "Toggle log" lo que este programa escribe, pero la
# salida completa de setup-disk, setup-desktop y desktop-postinstall.sh va
# solo a $LOG. Mientras trabajan, un vigía en segundo plano revisa $LOG
# cada 5 s y escribe un resumen (igual que hace el script en la consola):
#   - una línea por paquete: "(12/80) Instalando firefox";
#   - si pasan 20 s sin novedades, "... sigue trabajando (1 min 20 s)".
# setup-disk llama a apk con --quiet y no escribe una línea por paquete:
# para ese paso se muestra cuánto ocupa ya el sistema nuevo en el disco.
# avance_iniciar QUÉ [RAÍZ] arranca el vigía; avance_parar lo detiene.
AVANCE_PID=""
AVANCE_LEIDAS=/tmp/lazaro-avance.leidas

# Traduce a español las líneas de apk ("( 1/12) Installing x (1.0-r0)")
# y deja pasar las que ya trae traducidas desktop-postinstall.sh.
avance_traducir() {
	awk '
		{ sub(/^[ \t]+/, ""); sub(/^\( +/, "(") }
		/^\([0-9]+\/[0-9]+\) (Installing|Upgrading|Downgrading|Reinstalling) / {
			print "[lazaro] " $1 " Instalando " $3; next
		}
		/^\([0-9]+\/[0-9]+\) Purging / { print "[lazaro] " $1 " Quitando " $3; next }
		/^\([0-9]+\/[0-9]+\) (Instalando|Quitando|Descargando) / { print "[lazaro] " $0; next }
		/^\.\.\. sigue trabajando/ { print "[lazaro] " $0 }
	'
}

# Escribe a la salida de error las líneas de avance que llegaron a $LOG
# desde la última lectura (cuántas se leyeron queda en $AVANCE_LEIDAS, para
# que avance_parar muestre también las últimas). Devuelve 1 si no hubo.
avance_leer() {
	leidas=$(cat "$AVANCE_LEIDAS" 2>/dev/null || echo 0)
	lineas=$(wc -l <"$LOG")
	[ "$lineas" -gt "$leidas" ] || return 1
	nuevas=$(sed -n "$((leidas + 1)),${lineas}p" "$LOG" | avance_traducir)
	echo "$lineas" >"$AVANCE_LEIDAS"
	[ -n "$nuevas" ] || return 1
	printf '%s\n' "$nuevas" >&2
}

avance_vigia() { # QUÉ [RAÍZ]
	total=0
	silencio=0
	# sleep sin la salida de Calamares: al parar el vigía no la deja abierta.
	while sleep 5 >/dev/null 2>&1; do
		total=$((total + 5))
		silencio=$((silencio + 5))
		if avance_leer; then
			silencio=0
			continue
		fi
		if [ "$silencio" -ge 20 ]; then
			silencio=0
			if [ "$total" -ge 60 ]; then
				tiempo="$((total / 60)) min $((total % 60)) s"
			else
				tiempo="$total s"
			fi
			if [ -n "${2:-}" ] && mb=$(df -Pm "$2" 2>/dev/null | awk 'NR == 2 { print $3 }') && [ -n "$mb" ]; then
				tiempo="$tiempo, $mb MB en el disco"
			fi
			printf '[lazaro] ... %s sigue trabajando (%s)\n' "$1" "$tiempo" >&2
		fi
	done
}

avance_iniciar() { # QUÉ [RAÍZ]
	avance_parar
	touch "$LOG"
	wc -l <"$LOG" >"$AVANCE_LEIDAS"
	avance_vigia "$@" </dev/null &
	AVANCE_PID=$!
}

avance_parar() {
	[ -n "$AVANCE_PID" ] || return 0
	kill "$AVANCE_PID" 2>/dev/null || true
	wait "$AVANCE_PID" 2>/dev/null || true
	AVANCE_PID=""
	# Lo que el paso escribió después de la última vuelta del vigía.
	avance_leer || true
}

# Si el programa termina por un error (die), el vigía no debe quedar vivo:
# Calamares espera a que se cierre la salida.
trap avance_parar EXIT

# Toda llamada a apk del instalador pasa por esta función: si cambia la
# forma de usar apk (apk v3, por ejemplo), se cambia en un solo sitio.
lz_apk() {
	apk "$@"
}

# Repositorio de la ISO tal como lo dejó el arranque live
# (/media/cdrom/apks, /media/sdb/apks...). Vacío si no hay.
repo_iso() {
	grep -m1 '^/media/.*/apks$' /etc/apk/repositories 2>/dev/null || true
}

hay_red() {
	wget -q --spider -T 8 \
		"$ALPINE_MIRROR/$ALPINE_BRANCH/main/$ARCH/APKINDEX.tar.gz" 2>/dev/null
}

# Como hay_red, pero tolera un corte breve (pasos base y ajustes): espera
# a NetworkManager y prueba hasta 4 veces (unos 45 s como mucho). Si aun
# así no llega al servidor, anota en el registro el motivo que da wget.
esperar_red() {
	command -v nm-online >/dev/null 2>&1 && nm-online -s -q -t 10 || true
	for _intento in 1 2 3 4; do
		hay_red && return 0
		[ "$_intento" = 4 ] || sleep 3
	done
	log "Sin respuesta de $ALPINE_MIRROR tras 4 intentos. Motivo:"
	wget --spider -T 8 "$ALPINE_MIRROR/$ALPINE_BRANCH/main/$ARCH/APKINDEX.tar.gz" >>"$LOG" 2>&1 || true
	return 1
}

# escribir_repos ARCHIVO REPO_ISO(vacío=no) RED(si/no)
escribir_repos() {
	{
		[ -z "$2" ] || echo "$2"
		if [ "$3" = si ]; then
			echo "$ALPINE_MIRROR/$ALPINE_BRANCH/main"
			echo "$ALPINE_MIRROR/$ALPINE_BRANCH/community"
		fi
	} > "$1.lazaro-nuevo"
	mv "$1.lazaro-nuevo" "$1"
}

escritorio_offline() {
	case " $ESCRITORIOS_OFFLINE " in *" $1 "*) return 0 ;; esac
	return 1
}

validar_escritorio() {
	case " $ESCRITORIOS " in
		*" $1 "*) ;;
		*) die "Escritorio desconocido: '$1' (opciones: $ESCRITORIOS)" ;;
	esac
}

# --- Ejecutar comandos dentro del sistema instalado ----------------------
MONTADOS=""

# Cada montaje que falla se informa y devuelve error. Hace falta decirlo
# así: en_destino se llama casi siempre dentro de un "if" o con "||", y
# ahí "set -e" no detiene nada.
montar_si_falta() { # TIPO ORIGEN DESTINO
	mountpoint -q "$3" && return 0
	mkdir -p "$3" || { log "ERROR: no se pudo crear $3"; return 1; }
	if [ "$1" = bind ]; then
		mount --bind "$2" "$3" || { log "ERROR: no se pudo montar $2 en $3"; return 1; }
	else
		mount -t "$1" "$2" "$3" || { log "ERROR: no se pudo montar $1 en $3"; return 1; }
	fi
	MONTADOS="$3 $MONTADOS"
}

# Lo que necesita un chroot al sistema instalado: /proc, /sys, /dev, las
# variables EFI y el repositorio de la ISO (para instalar sin internet).
montar_destino() { # RAIZ
	montar_si_falta proc proc "$1/proc" || return 1
	montar_si_falta sysfs sys "$1/sys" || return 1
	montar_si_falta bind /dev "$1/dev" || return 1
	if [ -d /sys/firmware/efi/efivars ]; then
		montar_si_falta efivarfs efivarfs "$1/sys/firmware/efi/efivars" || return 1
	fi
	md_iso="$(repo_iso)"
	if [ -n "$md_iso" ]; then
		montar_si_falta bind "$md_iso" "$1$md_iso" || return 1
	fi
	return 0
}

desmontar_propios() {
	for m in $MONTADOS; do
		umount "$m" 2>/dev/null || umount -l "$m" || true
	done
	MONTADOS=""
}

# en_destino RAIZ [VAR=valor...] COMANDO [ARGS...]
en_destino() {
	raiz="$1"
	shift
	if ! montar_destino "$raiz"; then
		desmontar_propios
		return 1
	fi
	cp /etc/resolv.conf "$raiz/etc/resolv.conf" 2>/dev/null || true
	rc=0
	chroot "$raiz" /usr/bin/env -i \
		PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root TERM=linux \
		"$@" || rc=$?
	matar_restos "$raiz"
	desmontar_propios
	return $rc
}

# Procesos que siguen vivos dentro del sistema instalado (por ejemplo,
# servicios de D-Bus que arranca flatpak) impiden desmontarlo al final.
matar_restos() {
	mr_raiz="${1%/}"
	for mr_senal in TERM KILL; do
		mr_quedan=""
		for mr_p in /proc/[0-9]*; do
			[ "$(readlink "$mr_p/root" 2>/dev/null)" = "$mr_raiz" ] || continue
			[ "$mr_senal" = KILL ] || log "Aviso: se cierra un proceso que quedó vivo en $mr_raiz: $(tr '\0' ' ' < "$mr_p/cmdline" 2>/dev/null)"
			kill -s "$mr_senal" "${mr_p#/proc/}" 2>/dev/null && mr_quedan=1
		done
		[ -n "$mr_quedan" ] || return 0
		sleep 1
	done
}

# --- Paso 1: sistema base -------------------------------------------------
paso_base() {
	raiz="${1%/}"
	de="$2"
	validar_escritorio "$de"
	mountpoint -q "$raiz" || die "$raiz no es un punto de montaje"

	iso="$(repo_iso)"
	red=no
	esperar_red && red=si
	log "Lázaro Linux $ISO_VERSION sobre Alpine $ALPINE_BRANCH"
	log "Repositorio de la ISO: ${iso:-ninguno}; internet: $red"
	if ! escritorio_offline "$de" && [ "$red" = no ]; then
		die "El escritorio '$de' se descarga de internet y no hay conexión. Conéctate a una red o elige uno de los que vienen en el USB: XFCE, MATE, LXQt, Sway o XFCE Wayland."
	fi
	[ -n "$iso" ] || [ "$red" = si ] || die "No se encontró el repositorio de la ISO ni hay internet."

	# setup-disk instala con los repositorios del sistema live.
	escribir_repos /etc/apk/repositories "$iso" "$red"
	lz_apk update >>"$LOG" 2>&1 || log "Aviso: apk update terminó con errores (ver $LOG)."

	# Configuración inicial del destino. setup-disk la desempaqueta en la
	# raíz (opción -o, como si fuera un respaldo de lbu) y luego instala
	# todo lo que diga etc/apk/world.
	ovl="$(mktemp -d)"
	mkdir -p "$ovl/etc/apk"
	grep -v '^#' "$DATOS/paquetes-base" | grep -v '^$' > "$ovl/etc/apk/world"
	escribir_repos "$ovl/etc/apk/repositories" "$iso" "$red"
	echo lazaro > "$ovl/etc/hostname"
	for s in devfs:sysinit dmesg:sysinit mdev:sysinit hwdrivers:sysinit \
		hwclock:boot modules:boot sysctl:boot hostname:boot bootmisc:boot \
		syslog:boot networkmanager:default chronyd:default acpid:default \
		crond:default mount-ro:shutdown killprocs:shutdown savecache:shutdown; do
		mkdir -p "$ovl/etc/runlevels/${s#*:}"
		ln -s "/etc/init.d/${s%:*}" "$ovl/etc/runlevels/${s#*:}/${s%:*}"
	done
	tar -C "$ovl" -czf /tmp/lazaro-destino.apkovl.tar.gz etc
	rm -rf "$ovl"

	log "Instalando el sistema base con setup-disk (puede tardar)..."
	# "splash" enciende la pantalla de arranque con el pulso (Plymouth).
	# No se usa en dos casos:
	# - Sin escritorio: el arranque se ve en texto, como en la consola, y
	#   ese sistema no tiene udev, que Plymouth necesita para encontrar la
	#   pantalla.
	# - GNOME: con Plymouth, GDM no logra abrir su pantalla de inicio al
	#   encender (prueba el modo X, que no está instalado, y se rinde).
	splash=" splash"
	case "$de" in ninguno | gnome) splash="" ;; esac
	avance_iniciar "el sistema base" "$raiz"
	if ! BOOTLOADER=grub KERNELOPTS="${LAZARO_KERNELOPTS:-quiet}$splash" \
		setup-disk -v -m sys -o /tmp/lazaro-destino.apkovl.tar.gz "$raiz" \
		>>"$LOG" 2>&1; then
		die "setup-disk falló (detalles en $LOG)"
	fi
	avance_parar
	# El tema del pulso no viene en ningún paquete: se copia el de la ISO.
	mkdir -p "$raiz/usr/share/plymouth/themes" "$raiz/etc/plymouth"
	cp -a /usr/share/plymouth/themes/lazaro "$raiz/usr/share/plymouth/themes/"
	cp /etc/plymouth/plymouthd.conf "$raiz/etc/plymouth/plymouthd.conf"
	if [ -n "$splash" ]; then
		install -m 755 /usr/share/lazaro/plymouth-salir "$raiz/etc/init.d/plymouth-salir"
		mkdir -p "$raiz/etc/runlevels/default"
		ln -sf /etc/init.d/plymouth-salir "$raiz/etc/runlevels/default/plymouth-salir"
	fi
	log "Sistema base instalado."
}

# setup-desktop agrega la pantalla de inicio y sus servicios con
# "rc-update add" sin decir en qué nivel. Dentro del chroot no hay nivel
# en curso y OpenRC los pone en sysinit: la pantalla de inicio arrancaba
# entonces al principio del encendido y cerraba la animación del pulso.
# Se pasan al nivel default, donde van (también si quedaron de una
# instalación anterior en la misma partición).
servicios_a_default() {
	for svc in dbus elogind lightdm sddm gdm greetd; do
		[ -L "$1/etc/runlevels/sysinit/$svc" ] || continue
		rm -f "$1/etc/runlevels/sysinit/$svc"
		mkdir -p "$1/etc/runlevels/default"
		ln -sf "/etc/init.d/$svc" "$1/etc/runlevels/default/$svc"
		log "Servicio $svc: del nivel sysinit al default."
	done
}

# --- Paso 2: escritorio ---------------------------------------------------
paso_escritorio() {
	raiz="${1%/}"
	de="$2"
	validar_escritorio "$de"
	if [ "$de" = ninguno ]; then
		# Solo consola: queda una marca para que los ajustes no instalen
		# programas gráficos.
		mkdir -p "$raiz/etc/lazaro"
		: > "$raiz/etc/lazaro/sin-escritorio"
		# Si se reutilizó sin formatear una partición con un escritorio
		# anterior, su pantalla de inicio no debe volver a arrancar.
		for dm in lightdm sddm gdm greetd; do
			rm -f "$raiz"/etc/runlevels/*/"$dm"
		done
		servicios_a_default "$raiz"
		log "Sin escritorio: el sistema arrancará en modo texto."
		return 0
	fi
	log "Instalando el escritorio '$de' con setup-desktop..."
	avance_iniciar "el escritorio"
	if ! en_destino "$raiz" setup-desktop "$de" </dev/null >>"$LOG" 2>&1; then
		die "setup-desktop $de falló (detalles en $LOG)"
	fi
	avance_parar
	servicios_a_default "$raiz"
	log "Escritorio '$de' instalado."
}

# Programas adicionales que vienen en la ISO (ver LAZARO_EXTRAS en
# perfil/mkimg.lazaro.sh): se instalan desde el USB, sin internet y más
# rápido. desktop-postinstall.sh los encuentra después ya instalados; si
# algo falla aquí, el script lo intenta de nuevo por internet.
preinstalar_extras() { # RAIZ IDIOMA EXTRAS
	pe_iso="$(repo_iso)"
	[ -n "$pe_iso" ] || return 0
	pe_grafico=si
	[ ! -e "$1/etc/lazaro/sin-escritorio" ] || pe_grafico=no
	pe_paq=""
	# Las mismas tipografías que el script pone con cualquier escritorio.
	[ "$pe_grafico" = no ] || pe_paq="font-dejavu font-liberation font-liberation-sans-narrow font-noto font-noto-emoji"
	for e in $3; do
		case "$e" in
			fastfetch|btop) pe_paq="${pe_paq:+$pe_paq }$e" ;;
			flatpak) [ "$pe_grafico" = no ] || pe_paq="$pe_paq flatpak" ;;
			vlc) [ "$pe_grafico" = no ] || pe_paq="$pe_paq vlc vlc-qt" ;;
			libreoffice)
				[ "$pe_grafico" = no ] && continue
				pe_paq="$pe_paq libreoffice"
				case "$2" in es|es_*|es.*) pe_paq="$pe_paq libreoffice-lang-es" ;; esac ;;
		esac
	done
	[ -n "$pe_paq" ] || return 0
	log "Instalando desde el USB: $pe_paq"
	avance_iniciar "los programas adicionales"
	pe_rc=0
	# --no-network: solo el repositorio de la ISO, aunque haya internet.
	# shellcheck disable=SC2086
	en_destino "$1" apk add --no-network $pe_paq </dev/null >>"$LOG" 2>&1 || pe_rc=$?
	avance_parar
	if [ "$pe_rc" = 0 ]; then
		log "Programas adicionales instalados desde el USB."
	else
		log "Aviso: no se pudieron instalar desde el USB (código $pe_rc); se descargarán."
	fi
}

# --- Paso 3: ajustes y desktop-postinstall.sh ----------------------------
paso_ajustes() {
	raiz="${1%/}"
	usuario="$2"
	idioma="${3:-es_CO.UTF-8}"
	teclado="${4:-latam}"
	variante="${5:-}"
	zona="${6:-America/Bogota}"
	extras="${7:-base flatpak}"
	# Programas para desktop-postinstall.sh --con. El script ya se encarga
	# de las dependencias: las apps de Flathub activan Flatpak y, sin
	# escritorio, descarta todo lo gráfico.
	con="firefox,actualizaciones"
	[ -e "$raiz/etc/lazaro/sin-escritorio" ] || con="$con,impresoras"
	for e in $extras; do
		case "$e" in
			base) ;;
			fastfetch|btop|vlc|libreoffice|flatpak|onlyoffice|chrome|brave)
				con="$con,$e" ;;
			*) log "Aviso: programa adicional desconocido '$e'; se omite." ;;
		esac
	done

	if [ -e "$raiz/usr/share/zoneinfo/$zona" ]; then
		ln -sf "/usr/share/zoneinfo/$zona" "$raiz/etc/localtime"
		echo "$zona" > "$raiz/etc/timezone"
	else
		log "Aviso: zona horaria desconocida '$zona'; se deja UTC."
	fi

	mkdir -p "$raiz/etc/profile.d"
	cat > "$raiz/etc/profile.d/00-idioma.sh" <<-EOF
	# Idioma elegido en el instalador de Lázaro Linux
	export LANG=$idioma
	EOF

	# Teclado de la sesión gráfica (Xorg)...
	mkdir -p "$raiz/etc/X11/xorg.conf.d"
	{
		echo 'Section "InputClass"'
		echo '    Identifier "system-keyboard"'
		echo '    MatchIsKeyboard "on"'
		echo "    Option \"XkbLayout\" \"$teclado\""
		[ -z "$variante" ] || echo "    Option \"XkbVariant\" \"$variante\""
		echo 'EndSection'
	} > "$raiz/etc/X11/xorg.conf.d/00-keyboard.conf"
	# ...y de la consola.
	if ! en_destino "$raiz" setup-keymap "$teclado" "${variante:-$teclado}" \
		</dev/null >>"$LOG" 2>&1; then
		en_destino "$raiz" setup-keymap "$teclado" "$teclado" </dev/null >>"$LOG" 2>&1 \
			|| log "Aviso: no se pudo configurar el teclado de consola '$teclado'."
	fi

	mkdir -p "$raiz/etc/doas.d"
	echo 'permit persist :wheel' > "$raiz/etc/doas.d/20-wheel.conf"
	chmod 0600 "$raiz/etc/doas.d/20-wheel.conf"

	preinstalar_extras "$raiz" "$idioma" "$extras"


	# desktop-postinstall.sh sin preguntas: --minimo deja todo en "no" y
	# --con marca lo elegido en Calamares. Las opciones se guardan para
	# repetirlas en el primer arranque si ahora no hay internet.
	install -Dm755 "$DATOS/desktop-postinstall.sh" \
		"$raiz/usr/libexec/lazaro/desktop-postinstall.sh"
	opt_teclado=no
	[ "$teclado" = latam ] && opt_teclado=latam
	# NVIDIA: "optimus" es el modo automático del script (decide según la
	# tarjeta, con las mismas reglas que lazaro-graficas en la live). Si
	# al arrancar la live se eligió lazaro.nvidia=activa o =seguro, se
	# respeta esa elección.
	nvidia=optimus
	if [ -r /run/lazaro/graficas ]; then
		nv_decision=$(sed -n 's/^DECISION=//p' /run/lazaro/graficas)
		if grep -qx 'MOTIVO=elegido' /run/lazaro/graficas; then
			nvidia="$nv_decision"
		fi
	fi
	args="--minimo --usuario $usuario --idioma $idioma --nvidia $nvidia --teclado $opt_teclado --con $con"
	mkdir -p "$raiz/etc/lazaro"
	echo "$args" > "$raiz/etc/lazaro/postinstall.args"

	install -Dm755 "$DATOS/lazaro-postinstalacion" "$raiz/usr/libexec/lazaro/lazaro-postinstalacion"
	if esperar_red; then
		# Mientras corre el script, el repositorio de la ISO sigue a mano
		# junto a los de internet: si la conexión se corta (wifi
		# inestable), lo que está en la ISO se instala igual.
		iso="$(repo_iso)"
		if [ -n "$iso" ] && montar_si_falta bind "$iso" "$raiz$iso"; then
			escribir_repos "$raiz/etc/apk/repositories" "$iso" si
		fi
		# El script corre desde la sesión live: con --destino monta el
		# sistema nuevo y se ejecuta dentro de él.
		log "Ejecutando desktop-postinstall.sh --destino $raiz $args"
		avance_iniciar "la configuración final"
		pi=0
		# shellcheck disable=SC2086
		sh "$DATOS/desktop-postinstall.sh" --destino "$raiz" $args \
			</dev/null >>"$LOG" 2>&1 || pi=$?
		avance_parar
		desmontar_propios
		repos_definitivos "$raiz"
		if [ "$pi" = 0 ]; then
			log "desktop-postinstall.sh terminó bien."
		else
			log "Aviso: desktop-postinstall.sh falló; se repetirá en el primer arranque."
			programar_primer_arranque "$raiz"
		fi
	else
		repos_definitivos "$raiz"
		log "Sin internet: desktop-postinstall.sh se ejecutará en el primer arranque con red."
		programar_primer_arranque "$raiz"
	fi

	cp "$LOG" "$raiz/var/log/lazaro-instalar.log" 2>/dev/null || true
	log "Instalación terminada."
}

# Repositorios definitivos: los de internet (el de la ISO deja de
# existir al reiniciar), y fuera la llave que solo firmaba la ISO.
repos_definitivos() { # RAIZ
	escribir_repos "$1/etc/apk/repositories" "" si
	[ -z "${LAZARO_LLAVE:-}" ] || rm -f "$1/etc/apk/keys/$LAZARO_LLAVE"
}

# Inicio automático: queda anotado en /etc/lazaro/autologin y el
# servicio lazaro-autologin lo aplica en cada arranque a la pantalla de
# inicio que haya (también a una que se instale después).
paso_autologin() { # RAIZ USUARIO
	raiz="${1%/}"
	[ -n "$2" ] || return 0
	mkdir -p "$raiz/etc/lazaro"
	echo "$2" > "$raiz/etc/lazaro/autologin"
	install -Dm755 "$DATOS/lazaro-autologin" "$raiz/usr/libexec/lazaro/lazaro-autologin"
	install -Dm755 "$DATOS/lazaro-autologin.initd" "$raiz/etc/init.d/lazaro-autologin"
	mkdir -p "$raiz/etc/runlevels/default"
	ln -sf /etc/init.d/lazaro-autologin "$raiz/etc/runlevels/default/lazaro-autologin"
	en_destino "$raiz" /usr/libexec/lazaro/lazaro-autologin >>"$LOG" 2>&1 \
		|| log "Aviso: no se pudo configurar el inicio automático ahora; se hará al arrancar."
	log "Inicio automático de la sesión para '$2'."
}

programar_primer_arranque() {
	install -Dm755 "$DATOS/lazaro-primer-arranque.initd" \
		"$1/etc/init.d/lazaro-primer-arranque"
	mkdir -p "$1/etc/runlevels/default"
	ln -sf /etc/init.d/lazaro-primer-arranque "$1/etc/runlevels/default/lazaro-primer-arranque"
	aviso_consola "$1"
	avisar_primer_arranque
}

# Mientras falte la configuración final, el sistema arranca a la consola de
# texto: el aviso va en /etc/issue (se ve sobre "login:") y en /etc/motd
# (se ve al entrar). lazaro-primer-arranque devuelve los originales al
# terminar.
aviso_consola() { # RAIZ
	mkdir -p "$1/etc/lazaro"
	if [ -e "$1/etc/lazaro/sin-escritorio" ]; then
		falta="los programas y ajustes elegidos"
		luego="se completa solo."
	else
		falta="la barra completa, la pantalla de inicio y los programas elegidos"
		luego="se completa solo y luego aparece la pantalla de inicio."
	fi
	for f in issue motd; do
		[ -e "$1/etc/lazaro/$f.original" ] || cp -p "$1/etc/$f" "$1/etc/lazaro/$f.original" 2>/dev/null \
			|| : > "$1/etc/lazaro/$f.original"
		{
			cat "$1/etc/lazaro/$f.original"
			cat <<AVISO

  *** Lázaro Linux todavía está terminando de configurarse ***
  Falta instalar $falta,
  porque no hubo internet al final de la instalación.

  Conecta el equipo a internet y espera unos minutos:
  $luego
  No hace falta reiniciar.

  Sin cable de red, conecta el wifi entrando aquí y escribiendo:
      nmcli device wifi connect "NOMBRE-DE-LA-RED" --ask
  Registro: /var/log/desktop-postinstall.log

AVISO
		} > "$1/etc/$f"
	done
}

# Calamares termina igual con o sin la configuración final, así que se
# avisa aparte de que queda para el primer arranque. La ventana queda
# abierta junto a "Terminado" (no detiene la instalación). Sin pantalla
# (pruebas automáticas) no se muestra nada.
avisar_primer_arranque() {
	[ -n "${DISPLAY:-}" ] && command -v zenity >/dev/null 2>&1 || return 0
	setsid zenity --info --title="Lázaro Linux" --width=520 --text="<b>La instalación terminó, pero falta la configuración final.</b>

No hubo internet al final de la instalación, así que la barra completa, la pantalla de inicio y los programas elegidos se instalarán en el primer arranque.

<b>Qué hacer:</b> al encender el equipo, conéctate a internet y espera unos minutos. Cuando termine, la pantalla de inicio aparece sola; entra desde ella (no desde la consola de texto). No hace falta reiniciar.

<small><b>Explicación técnica:</b> la configuración final la hace desktop-postinstall.sh, que descarga paquetes y por eso necesita red. En el primer arranque un servicio de OpenRC (lazaro-primer-arranque) lo ejecuta en segundo plano en cuanto hay internet. OpenRC enciende los servicios del arranque una sola vez y en orden: lo que el script habilita después (la pantalla de inicio, elogind, polkit, cupsd...) quedaría apagado hasta el siguiente arranque. Por eso, al terminar, ese servicio los enciende él mismo. La barra, el idioma y los grupos del usuario se leen al iniciar sesión: una sesión abierta por consola antes de terminar sigue con lo anterior. Registros: /var/log/desktop-postinstall.log y /var/log/lazaro-primer-arranque.log</small>" \
		</dev/null >/dev/null 2>&1 &
}

# --- Instalación desatendida (pruebas automáticas) -----------------------
# Los archivos que solo usan las pruebas están en $PRUEBAS y se copian al
# sistema instalado; aquí queda solo lo que depende de esta instalación.
PRUEBAS="$DATOS/pruebas"

# Borra el disco, lo particiona (GPT con partición EFI en UEFI, MBR en
# BIOS) y monta la raíz en $raiz.
auto_particionar() { # DISCO
	case "$1" in
		*[0-9]) p="${1}p" ;;
		*) p="$1" ;;
	esac
	if [ -d /sys/firmware/efi ]; then
		printf 'label: gpt\nsize=300M, type=uefi\ntype=linux\n' | sfdisk --wipe always "$1" >>"$LOG" 2>&1
		udevadm settle 2>/dev/null || sleep 2
		mkfs.vfat -F 32 -n EFI "${p}1" >>"$LOG" 2>&1
		mkfs.ext4 -q -F -L lazaro "${p}2"
		mkdir -p "$raiz"
		mount -t ext4 "${p}2" "$raiz" || die "no se pudo montar ${p}2 en $raiz"
		mkdir -p "$raiz/boot/efi"
		mount -t vfat "${p}1" "$raiz/boot/efi" || die "no se pudo montar ${p}1 en $raiz/boot/efi"
	else
		printf 'label: dos\ntype=83, bootable\n' | sfdisk --wipe always "$1" >>"$LOG" 2>&1
		udevadm settle 2>/dev/null || sleep 2
		mkfs.ext4 -q -F -L lazaro "${p}1"
		mkdir -p "$raiz"
		mount -t ext4 "${p}1" "$raiz" || die "no se pudo montar ${p}1 en $raiz"
	fi
}

# Lo que en Calamares hace el módulo "users" (los mismos grupos que
# users.conf). Con CLAVE_ROOT=si, root recibe la misma contraseña, como
# hace Calamares con doReusePassword.
crear_usuario() { # USUARIO NOMBRE CLAVE EQUIPO [CLAVE_ROOT]
	en_destino "$raiz" adduser -D -g "$2" -s /bin/ash "$1" >>"$LOG" 2>&1 \
		|| die "no se pudo crear el usuario $1"
	printf '%s:%s\n' "$1" "$3" | en_destino "$raiz" chpasswd >>"$LOG" 2>&1 \
		|| die "no se pudo poner la contraseña de $1"
	if [ "${5:-no}" = si ]; then
		printf 'root:%s\n' "$3" | en_destino "$raiz" chpasswd >>"$LOG" 2>&1 || true
	fi
	for g in wheel audio video netdev input plugdev lp users; do
		en_destino "$raiz" addgroup "$1" "$g" >>"$LOG" 2>&1 || true
	done
	echo "$4" > "$raiz/etc/hostname"
	printf '127.0.0.1\tlocalhost\n127.0.1.1\t%s\n::1\t\tlocalhost\n' "$4" > "$raiz/etc/hosts"
}

# Flatpak viene por defecto: con red, Flathub debe quedar agregado.
auto_revisar_flatpak() {
	[ ! -e "$raiz/etc/lazaro/sin-escritorio" ] && hay_red || return 0
	# Se lee la configuración en vez de ejecutar flatpak dentro del
	# sistema instalado: un proceso que quede vivo ahí impide desmontarlo.
	if grep -q '^\[remote "flathub"\]' "$raiz/var/lib/flatpak/repo/config" 2>/dev/null; then
		echo "LAZARO-FLATPAK-OK"
	else
		echo "LAZARO-FLATPAK-NO"
		grep -n -i -A6 "flatpak" "$raiz/var/log/desktop-postinstall.log" 2>&1 | head -n 40
	fi
}

# Recorrido real de la resolución: "prueba" entra sola a su sesión,
# cambia la pantalla a 800x600, la prueba cierra la sesión y la
# pantalla de inicio debe volver con 800x600 (LightDM o SDDM). Con
# GDM la prueba reinicia, porque GDM solo la toma al arrancar.
auto_prueba_resolucion() { # ESCRITORIO
	pdm=""
	[ -f "$raiz/etc/lightdm/lightdm.conf.d/50-pantalla-inicio.conf" ] && pdm=lightdm
	[ -f "$raiz/etc/sddm.conf.d/50-pantalla-inicio.conf" ] && pdm=sddm
	[ -f "$raiz/etc/init.d/pantalla-inicio-gdm" ] && pdm=gdm
	# Inicio automático de "prueba" según la pantalla de inicio.
	if [ "$pdm" = lightdm ]; then
		en_destino "$raiz" addgroup -S autologin >>"$LOG" 2>&1 || true
		en_destino "$raiz" addgroup prueba autologin >>"$LOG" 2>&1 || true
		cat > "$raiz/etc/lightdm/lightdm.conf.d/90-lazaro-prueba.conf" <<-EOF
		[Seat:*]
		autologin-user=prueba
		autologin-user-timeout=0
		autologin-session=$1
		EOF
	elif [ "$pdm" = sddm ]; then
		# Plasma entra en su sesión Wayland (la predeterminada).
		sesion=""
		for f in "$raiz/usr/share/wayland-sessions/$1.desktop" \
			"$raiz/usr/share/xsessions/$1.desktop"; do
			[ -f "$f" ] && { sesion="${f##*/}"; break; }
		done
		cat > "$raiz/etc/sddm.conf.d/90-lazaro-prueba.conf" <<-EOF
		[Autologin]
		User=prueba
		Session=${sesion:-$1.desktop}
		EOF
	elif [ "$pdm" = gdm ]; then
		# Se guarda el custom.conf original y zz-lazaro-prueba.start lo
		# repone antes de reiniciar.
		mkdir -p "$raiz/etc/gdm"
		if [ -f "$raiz/etc/gdm/custom.conf" ]; then
			cp "$raiz/etc/gdm/custom.conf" "$raiz/etc/lazaro/gdm-custom.conf.orig"
		fi
		cat > "$raiz/etc/gdm/custom.conf" <<-EOF
		[daemon]
		AutomaticLoginEnable=True
		AutomaticLogin=prueba
		EOF
	fi
	[ -n "$pdm" ] || return 0
	# zz-lazaro-prueba.start sabe así qué pantalla de inicio revisar.
	echo "$pdm" > "$raiz/etc/lazaro/prueba-pantalla"
	# Traza de "guardar" para el diagnóstico.
	sed -i 's|^Exec=.*|Exec=sh -c "sh -x /usr/local/libexec/pantalla-inicio/guardar 2>/tmp/guardar-traza.log"|' \
		"$raiz/etc/xdg/autostart/pantalla-inicio.desktop"
	# Al entrar, la sesión del usuario elige 800x600.
	mkdir -p "$raiz/usr/local/bin"
	install -m 755 "$PRUEBAS/lazaro-prueba-800x600" "$raiz/usr/local/bin/lazaro-prueba-800x600"
	install -m 644 "$PRUEBAS/zz-lazaro-prueba-resolucion.desktop" \
		"$raiz/etc/xdg/autostart/zz-lazaro-prueba-resolucion.desktop"
}

# Al arrancar el sistema instalado: mirar la pantalla de arranque
# mientras está en pie (lazaro-prueba-plymouth, en el nivel boot: al
# llegar a "local" puede haberla cerrado ya la pantalla de inicio) y
# luego informar por el puerto serie y apagar (zz-lazaro-prueba.start).
auto_prueba_arranque() {
	install -m 755 "$PRUEBAS/lazaro-prueba-plymouth" "$raiz/etc/init.d/lazaro-prueba-plymouth"
	mkdir -p "$raiz/etc/runlevels/boot"
	ln -sf /etc/init.d/lazaro-prueba-plymouth "$raiz/etc/runlevels/boot/lazaro-prueba-plymouth"
	mkdir -p "$raiz/etc/local.d"
	install -m 755 "$PRUEBAS/zz-lazaro-prueba.start" "$raiz/etc/local.d/zz-lazaro-prueba.start"
	ln -sf /etc/init.d/local "$raiz/etc/runlevels/default/local"
}

# Instalación completa en un disco entero, sin Calamares (la usan "auto"
# y "texto"): lo mismo que hace Calamares con particionado automático.
instalar_disco() { # DISCO ESCRITORIO USUARIO NOMBRE CLAVE EQUIPO IDIOMA TECLADO VARIANTE ZONA EXTRAS CLAVE_ROOT
	disco="$1"; de="$2"
	validar_escritorio "$de"
	[ -b "$disco" ] || die "$disco no es un disco"
	raiz=/mnt/lazaro
	# Antes de borrar el disco: que se puedan conseguir los paquetes.
	# paso_base lo vuelve a revisar, pero ahí el disco ya está borrado.
	if ! escritorio_offline "$de" || [ -z "$(repo_iso)" ]; then
		esperar_red || die "Sin internet: no se puede instalar '$de' (no se cambió nada en el disco). Conéctate a una red o elige XFCE, MATE, LXQt, Sway o XFCE Wayland."
	fi
	auto_particionar "$disco"
	paso_base "$raiz" "$de"
	crear_usuario "$3" "$4" "$5" "$6" "${12}"
	paso_escritorio "$raiz" "$de"
	# Si los ajustes se cuelgan, la prueba debe mostrar dónde: cada 4
	# minutos se informa por el puerto serie qué está corriendo.
	vigia=""
	if [ "${LAZARO_VIGIA:-no}" = si ]; then
		(
			while sleep 240; do
				echo "--- vigilancia $(date +%H:%M:%S) ---"
				tail -n 12 "$raiz/var/log/desktop-postinstall.log" 2>/dev/null
				ps -o pid,etime,args 2>/dev/null | grep -v -e '\[' -e 'ps -o' -e 'sleep 240' | tail -n 25
			done
		) >&2 &
		vigia=$!
	fi
	paso_ajustes "$raiz" "$3" "$7" "$8" "$9" "${10}" "${11}"
	[ -z "$vigia" ] || kill "$vigia" 2>/dev/null || true
}

desmontar_destino() {
	sync
	[ ! -d "$raiz/boot/efi" ] || ! mountpoint -q "$raiz/boot/efi" || umount "$raiz/boot/efi"
	umount "$raiz"
}

paso_auto() {
	log "Instalación desatendida en $1 con '$2' (se borra el disco)"
	# Usuario "prueba", contraseña "lazaro". Fastfetch, el programa
	# adicional más liviano: la prueba comprueba que lo marcado en
	# "Software adicional" se instala.
	LAZARO_VIGIA=si instalar_disco "$1" "$2" prueba "Prueba" lazaro lazaro-prueba \
		es_CO.UTF-8 latam "" America/Bogota "base flatpak fastfetch" no
	auto_revisar_flatpak
	auto_prueba_resolucion "$2"
	auto_prueba_arranque
	desmontar_destino
	log "Instalación desatendida terminada."
}

# Instalación desde la consola (lazaro-instalar-texto, cuando la sesión
# gráfica no abre). La contraseña llega en LAZARO_CLAVE, no como
# argumento, para que no se vea en la lista de procesos; root recibe la
# misma, como en Calamares.
paso_texto() { # DISCO ESCRITORIO USUARIO NOMBRE EQUIPO IDIOMA TECLADO VARIANTE ZONA [EXTRAS]
	[ -n "${LAZARO_CLAVE:-}" ] || die "falta la contraseña (LAZARO_CLAVE)"
	log "Instalación desde la consola en $1 con '$2' (se borra el disco)"
	instalar_disco "$1" "$2" "$3" "$4" "$LAZARO_CLAVE" "$5" "$6" "$7" "$8" "$9" "${10:-base}" si
	desmontar_destino
	log "Instalación terminada."
}

orden="${1:-}"
[ $# -gt 0 ] && shift
case "$orden" in
	base)       [ $# -eq 2 ] || die "uso: lazaro-instalar base RAIZ ESCRITORIO"; paso_base "$@" ;;
	escritorio) [ $# -eq 2 ] || die "uso: lazaro-instalar escritorio RAIZ ESCRITORIO"; paso_escritorio "$@" ;;
	ajustes)    [ $# -ge 2 ] || die "uso: lazaro-instalar ajustes RAIZ USUARIO [IDIOMA TECLADO VARIANTE ZONA EXTRAS]"; paso_ajustes "$@" ;;
	autologin)  [ $# -eq 2 ] || die "uso: lazaro-instalar autologin RAIZ USUARIO"; paso_autologin "$@" ;;
	auto)       [ $# -eq 2 ] || die "uso: lazaro-instalar auto DISCO ESCRITORIO"; paso_auto "$@" ;;
	red)        esperar_red ;;
	texto)      [ $# -ge 9 ] || die "uso: lazaro-instalar texto DISCO ESCRITORIO USUARIO NOMBRE EQUIPO IDIOMA TECLADO VARIANTE ZONA [EXTRAS]"; paso_texto "$@" ;;
	*)
		sed -n '2,/^$/s/^# \{0,1\}//p' "$0" >&2
		exit 1
		;;
esac
