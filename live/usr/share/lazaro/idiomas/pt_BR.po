msgstr "Memória: o kernel não tem Multi-Gen LRU"

#: live/usr/sbin/lazaro-afinador
msgid "Memoria: Multi-Gen LRU con protección contra congelones al quedarse sin RAM"
msgstr "Memória: Multi-Gen LRU com proteção contra travamentos quando a RAM acaba"

#: live/usr/sbin/lazaro-afinador
msgid "Memoria: protección contra congelones al quedarse sin RAM (Multi-Gen LRU)"
msgstr "Memória: proteção contra travamentos quando a RAM acaba (Multi-Gen LRU)"

