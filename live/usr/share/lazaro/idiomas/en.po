msgstr "Processor: %s mode, chosen by hand; left alone"

#: live/usr/sbin/lazaro-afinador
msgid "Protecciones del procesador APAGADAS (más rápido, menos seguro al navegar)"
msgstr "Processor protections OFF (faster, less safe when browsing)"

#: live/usr/sbin/lazaro-afinador
