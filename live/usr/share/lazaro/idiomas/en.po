msgstr "Compressed memory (zram) active"

#: live/usr/sbin/lazaro-afinador
msgid "Memoria comprimida (zram) todavía no está activa (la pone la configuración final)"
msgstr "Compressed memory (zram) not active yet (the final setup turns it on)"

