#!/sbin/openrc-run
description="Prueba: tema de Plymouth cargado"
start() {
	(
		t=0
		traza=""
		while [ $t -lt 30 ]; do
			ppid="$(pidof plymouthd 2>/dev/null | cut -d' ' -f1)"
			if [ -n "$ppid" ] && grep -qs 'plymouth/script.so' "/proc/$ppid/maps"; then
				echo OK > /run/lazaro-plymouth
				exit 0
			fi
			# Qué se vio en cada vuelta, para entender un fallo.
			mods="$([ -n "$ppid" ] && grep -o 'plymouth/[^ ]*\.so' "/proc/$ppid/maps" 2>/dev/null | sort -u | tr '\n' ' ')"
			traza="$traza
t=$t $(cut -d' ' -f1 /proc/uptime)s plymouthd=${ppid:-no} drm=$(ls /dev/dri 2>/dev/null | tr '\n' ' ') mods=$mods"
			t=$((t + 1))
			sleep 1
		done
		{
			echo NO
			echo "$traza"
			ps -ef | grep -i '[p]lymouth'
			dmesg | grep -i -e drm -e fb0 -e plymouth | tail -n 15
		} > /run/lazaro-plymouth 2>&1
	) &
	return 0
}
