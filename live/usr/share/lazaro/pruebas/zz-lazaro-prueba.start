#!/bin/sh
# Idioma de la sesión del usuario: el panel de cada escritorio debe
# correr con el idioma elegido (es_CO en la prueba). Se mira una sola
# vez, mientras la sesión sigue abierta.
idioma_sesion() {
	[ -z "${idioma_visto:-}" ] || return 0
	idioma_visto=1
	t=0
	panel=""
	while [ -z "$panel" ] && [ $t -lt 90 ]; do
		for c in /proc/[0-9]*/comm; do
			case "$(cat "$c" 2>/dev/null)" in
			xfce4-panel|mate-panel|lxqt-panel|plasmashell|gnome-shell|sway) ;;
			*) continue ;;
			esac
			# Dueño por el Uid real (/proc/PID puede figurar como de
			# root si el proceso no es "dumpable").
			[ "$(awk '/^Uid:/ { print $2 }' "${c%/comm}/status" 2>/dev/null)" = "$(id -u prueba)" ] || continue
			panel="${c%/comm}"
			break
		done
		[ -n "$panel" ] || { sleep 3; t=$((t + 3)); }
	done
	if [ -z "$panel" ]; then
		echo "LAZARO-IDIOMA-SIN-PANEL"
		for c in /proc/[0-9]*/comm; do
			[ "$(awk '/^Uid:/ { print $2 }' "${c%/comm}/status" 2>/dev/null)" = "$(id -u prueba)" ] \
				&& echo "  $(cat "$c" 2>/dev/null)"
		done | sort -u | head -n 30
		echo "  --- .xsession-errors ---"
		tail -n 25 /home/prueba/.xsession-errors 2>/dev/null | sed 's/^/  /'
		return 0
	fi
	idioma="$(tr '\0' '\n' < "$panel/environ" 2>/dev/null | sed -n 's/^LANG=//p')"
	echo "LAZARO-IDIOMA-SESION $(cat "$panel/comm") ${idioma:-sin-LANG}"
	# En Sway la barra es waybar: también se mira su idioma.
	if [ "$(cat "$panel/comm")" = sway ]; then
		for c in /proc/[0-9]*/comm; do
			[ "$(cat "$c" 2>/dev/null)" = waybar ] || continue
			idioma="$(tr '\0' '\n' < "${c%/comm}/environ" 2>/dev/null | sed -n 's/^LANG=//p')"
			echo "LAZARO-IDIOMA-SESION waybar ${idioma:-sin-LANG}"
			break
		done
	fi
}
{
	echo "LAZARO-INSTALADO-ARRANCO"
	rc-status default
	# Nada en la carpeta del usuario debe ser de otro dueño (si
	# no, Plasma y otros no pueden guardar su configuración).
	if [ ! -d /home/prueba ]; then
		ajenos="falta /home/prueba"
	else
		ajenos="$(find /home/prueba ! -user prueba 2>/dev/null | head -n 5)"
	fi
	# Lo marcado en "Software adicional" (la prueba marca fastfetch) se
	# instala con desktop-postinstall.sh: solo se mira cuando ya corrió
	# (sin internet queda para el primer arranque con red).
	if grep -q -e "--con .*fastfetch" /etc/lazaro/postinstall.args 2>/dev/null \
		&& [ ! -e /etc/runlevels/default/lazaro-primer-arranque ]; then
		if command -v fastfetch >/dev/null 2>&1; then
			echo "LAZARO-EXTRAS-OK"
		else
			echo "LAZARO-EXTRAS-NO"
		fi
	fi
	# btop (la prueba lo marca) con el permiso para medir la GPU sin
	# doas, que le pone el gancho de apk.
	if command -v btop >/dev/null 2>&1; then
		if setcap -v cap_perfmon=+ep /usr/bin/btop >/dev/null 2>&1; then
			echo "LAZARO-BTOP-GPU-OK"
		else
			echo "LAZARO-BTOP-GPU-NO $(ls -l /etc/apk/commit_hooks.d/ 2>&1 | tr '\n' ' ')"
		fi
	fi
	# YouTube ligero (la prueba lo marca): los programas vienen del USB y
	# se instalan aun sin internet; la configuración y el lanzador los
	# pone desktop-postinstall.sh (solo se miran cuando ya corrió).
	if grep -q -e "--con .*youtube" /etc/lazaro/postinstall.args 2>/dev/null \
		&& [ ! -e /etc/lazaro/sin-escritorio ]; then
		falta=""
		for f in /usr/bin/gtk-pipe-viewer /usr/bin/mpv /usr/bin/yt-dlp /usr/bin/qjs; do
			[ -e "$f" ] || falta="$falta $f"
		done
		! command -v deno >/dev/null 2>&1 || falta="$falta (sobra-deno)"
		if [ ! -e /etc/runlevels/default/lazaro-primer-arranque ]; then
			for f in /etc/yt-dlp.conf /etc/mpv/mpv.conf \
				/usr/share/applications/lazaro-youtube.desktop \
				/home/prueba/.config/pipe-viewer/gtk-pipe-viewer.conf; do
				[ -e "$f" ] || falta="$falta $f"
			done
			grep -q '^--js-runtimes quickjs' /etc/yt-dlp.conf 2>/dev/null || falta="$falta quickjs-en-yt-dlp.conf"
			# Sin 3D (como en estas VM) mpv necesita la salida por procesador.
			grep -q '^vo=.*x11' /etc/mpv/mpv.conf 2>/dev/null || falta="$falta vo-en-mpv.conf"
		fi
		if [ -z "$falta" ]; then
			echo "LAZARO-YOUTUBE-OK"
		else
			echo "LAZARO-YOUTUBE-NO$falta"
		fi
	fi
	# Tienda de aplicaciones: el servicio que usa GNOME Software para los
	# paquetes de Alpine (apk-polkit-server) activo y en marcha, y la
	# lista de programas para instalar (catálogo AppStream) descargada.
	# Solo cuando desktop-postinstall.sh ya corrió y hubo internet.
	if [ ! -e /etc/runlevels/default/lazaro-primer-arranque ] \
		&& { command -v gnome-software || command -v plasma-discover; } >/dev/null 2>&1; then
		falta=""
		if command -v gnome-software >/dev/null 2>&1; then
			[ -e /etc/runlevels/default/apk-polkit-server ] || falta="$falta servicio-sin-activar"
			rc-service apk-polkit-server status >/dev/null 2>&1 || falta="$falta servicio-detenido"
		fi
		[ -x /etc/periodic/hourly/alpine-tienda-catalogo ] || falta="$falta sin-tarea-diaria"
		programas="$(appstreamcli status 2>/dev/null | sed -n 's/.* \([0-9][0-9]*\) software components.*/\1/p')"
		[ "${programas:-0}" -ge 300 ] || falta="$falta catalogo-con-${programas:-0}-programas"
		if [ -z "$falta" ]; then
			echo "LAZARO-TIENDA-OK $programas programas"
		else
			echo "LAZARO-TIENDA-NO$falta"
			ls -la /var/lib/swcatalog/xml 2>&1 | head -n 5
		fi
	fi
	if [ -z "$ajenos" ]; then
		echo "LAZARO-HOME-OK"
	else
		echo "LAZARO-HOME-AJENO"
		echo "$ajenos"
	fi
	# La pantalla de inicio y sus servicios van en el nivel default: en
	# sysinit arrancan al principio y cierran la animación del pulso.
	temprano="$(ls /etc/runlevels/sysinit 2>/dev/null | grep -x -e dbus -e elogind -e lightdm -e sddm -e gdm -e greetd | tr '\n' ' ')"
	[ -z "$temprano" ] || echo "LAZARO-SERVICIOS-EN-SYSINIT $temprano"
	# Cuánto pesan las traducciones (paquetes *-lang): descarga e
	# instalado, en MiB, y las 10 más grandes.
	awk -F: '/^P:/ { p = $2 } /^S:/ { s[p] = $2 } /^I:/ { i[p] = $2 }
		END { for (p in s) if (p ~ /-lang$/) { n++; ts += s[p]; ti += i[p]
			print s[p], i[p], p > "/tmp/lang-tamanos" }
			printf "LAZARO-LANG-TAMANO paquetes=%d descarga=%.0fMiB instalado=%.0fMiB\n",
				n, ts / 1048576, ti / 1048576 }' /lib/apk/db/installed
	sort -rn /tmp/lang-tamanos 2>/dev/null | head -n 10 \
		| awk '{ printf "  %s descarga=%.1fMiB instalado=%.1fMiB\n", $3, $1 / 1048576, $2 / 1048576 }'
	# La pantalla de inicio sobre Xorg (LightDM, SDDM) tiene que estar
	# al frente, no escondida detrás de la consola de texto. GNOME no se
	# mira: su pantalla de inicio no usa Xorg y su prueba no puede esperar.
	t=0
	vt=""
	while { rc-service --exists lightdm || rc-service --exists sddm; } \
		&& [ -z "$vt" ] && [ $t -lt 30 ]; do
		vt="$(for c in /proc/[0-9]*/cmdline; do
			case "$(tr '\0' ' ' < "$c")" in
			*Xorg*) tr '\0' '\n' < "$c" | sed -n 's/^vt\([0-9][0-9]*\)$/\1/p' ;;
			esac
		done 2>/dev/null | head -n 1)"
		[ -n "$vt" ] || { sleep 1; t=$((t + 1)); }
	done
	if [ -n "$vt" ]; then
		# La pantalla de inicio puede tardar unos segundos en pasar a su
		# consola después de arrancar su Xorg.
		t=0
		activa="$(cat /sys/class/tty/tty0/active 2>/dev/null)"
		while [ "$activa" != "tty$vt" ] && [ $t -lt 20 ]; do
			sleep 1
			t=$((t + 1))
			activa="$(cat /sys/class/tty/tty0/active 2>/dev/null)"
		done
		# Al frente también puede estar la sesión gráfica ya abierta en
		# su propia consola: Plasma Wayland entra solo (prueba) en una
		# consola nueva, aparte del Xorg de SDDM.
		sesion_al_frente=""
		for s in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{ print $1 }'); do
			case "$(loginctl show-session "$s" -p Type -p TTY -p Active 2>/dev/null | sort | tr '\n' ' ')" in
			"Active=yes TTY=$activa Type=wayland "|"Active=yes TTY=$activa Type=x11 ")
				sesion_al_frente="$s" ;;
			esac
		done
		if [ "$activa" = "tty$vt" ]; then
			echo "LAZARO-VT-OK"
		elif [ -n "$sesion_al_frente" ]; then
			echo "LAZARO-VT-OK sesion grafica $sesion_al_frente en $activa"
		else
			echo "LAZARO-VT-ESCONDIDA al frente $activa, pantalla de inicio en tty$vt"
			# Para entender el fallo: todos los Xorg, las sesiones y lo
			# que la pantalla de inicio dejó en el registro.
			for c in /proc/[0-9]*/cmdline; do
				case "$(tr '\0' ' ' < "$c")" in
				*Xorg*) echo "  xorg ${c#/proc/} $(tr '\0' ' ' < "$c")" ;;
				esac
			done 2>/dev/null
			loginctl list-sessions --no-legend 2>/dev/null | sed 's/^/  sesion /'
			grep -i -e sddm -e lightdm /var/log/messages 2>/dev/null | tail -n 40 | sed 's/^/  log /'
		fi
	elif rc-service --exists lightdm || rc-service --exists sddm; then
		echo "LAZARO-VT-SIN-XORG"
	fi
	# La pantalla de arranque (Plymouth) cargó el tema del pulso: el
	# servicio lazaro-prueba-plymouth vio a plymouthd con el módulo
	# "script", que solo usa el tema de Lázaro (el de Alpine es otro).
	# Sin escritorio no hay pantalla de arranque ("splash"): plymouthd
	# puede estar en pie igual, pero sin el tema cargado.
	# Sin "splash" no se espera: GNOME necesita que la prueba siga
	# enseguida para confirmar "¿Mantener los cambios?" a tiempo.
	t=0
	while grep -qw splash /proc/cmdline && [ ! -s /run/lazaro-plymouth ] && [ $t -lt 40 ]; do
		t=$((t + 1))
		sleep 1
	done
	ply="$(head -n 1 /run/lazaro-plymouth 2>/dev/null)"
	if ! grep -qw splash /proc/cmdline && [ "$ply" != OK ]; then
		echo "LAZARO-PLYMOUTH-SIN-SPLASH"
	elif grep -qw splash /proc/cmdline && [ "$ply" = OK ] &&
		grep -qsx 'Theme=lazaro' /etc/plymouth/plymouthd.conf; then
		echo "LAZARO-PLYMOUTH-OK"
	elif [ -d /sys/firmware/efi ] && [ "$ply" = NO ] &&
		grep -qsx 'Theme=lazaro' /etc/plymouth/plymouthd.conf; then
		# En UEFI la tarjeta de video de QEMU a veces aparece tarde y
		# el arranque llega a la pantalla de inicio antes de que
		# Plymouth dibuje. No es un fallo: el tema ya se prueba en BIOS.
		echo "LAZARO-PLYMOUTH-UEFI-SIN-VER"
	else
		echo "LAZARO-PLYMOUTH-NO"
		cat /proc/cmdline
		cat /run/lazaro-plymouth 2>&1
		cat /etc/plymouth/plymouthd.conf 2>&1
		ls /usr/share/plymouth/themes/lazaro 2>&1 | head -n 5
		echo "--- fin de plymouth ---"
	fi
	# Resolución de la pantalla de inicio (LightDM o SDDM): la que
	# quedó anotada en ~/.config/pantalla-inicio.
	pdm="$(cat /etc/lazaro/prueba-pantalla 2>/dev/null)"
	reiniciar=""
	if [ "$pdm" = gdm ] && [ ! -f /etc/lazaro/prueba-reiniciada ]; then
		# Primera vuelta: la sesión de GNOME elige 800x600.
		t=0
		until [ -f /tmp/lazaro-confirmar ] || [ $t -ge 240 ]; do
			sleep 3
			t=$((t + 3))
		done
		idioma_sesion
		# qemu.sh pulsa Intro en "¿Mantener los cambios?".
		echo "LAZARO-CONFIRMAR"
		t=0
		until grep -qs '<width>800</width>' /home/prueba/.config/monitors.xml || [ $t -ge 120 ]; do
			sleep 3
			t=$((t + 3))
		done
		if grep -qs '<width>800</width>' /home/prueba/.config/monitors.xml; then
			echo "LAZARO-GUARDADO-OK"
		else
			echo "LAZARO-GUARDADO-NO"
			echo "--- diagnóstico del guardado ---"
			ls -la /home/prueba/.config 2>&1
			cat /home/prueba/.config/monitors.xml 2>&1
			echo "- cambio a 800x600:"
			tail -n 30 /tmp/prueba-800x600.log 2>&1
			echo "--- fin del diagnóstico ---"
		fi
		if [ -f /etc/lazaro/gdm-custom.conf.orig ]; then
			mv /etc/lazaro/gdm-custom.conf.orig /etc/gdm/custom.conf
		else
			rm -f /etc/gdm/custom.conf
		fi
		touch /etc/lazaro/prueba-reiniciada
		echo "LAZARO-REINICIANDO"
		reiniciar=1
	elif [ "$pdm" = gdm ]; then
		# Segunda vuelta: GDM debe mostrarse en 800x600 (qemu.sh
		# mide la pantalla). Se espera al gnome-shell del saludo.
		t=0
		saludo=""
		while [ -z "$saludo" ] && [ $t -lt 180 ]; do
			for c in /proc/[0-9]*/comm; do
				[ "$(cat "$c" 2>/dev/null)" = gnome-shell ] \
					&& [ "$(stat -c %U "${c%/comm}" 2>/dev/null)" = gdm ] && saludo=1
			done
			[ -n "$saludo" ] || { sleep 3; t=$((t + 3)); }
		done
		sleep 20
		echo "LAZARO-SALUDO-${saludo:+LISTO}"
		# Modo actual del saludo, preguntado al Mutter de GDM.
		modo_gdm() {
			for c in /proc/[0-9]*/comm; do
				p="${c%/comm}"
				[ "$(cat "$c" 2>/dev/null)" = gnome-shell ] \
					&& [ "$(stat -c %U "$p" 2>/dev/null)" = gdm ] || continue
				bus="$(tr '\0' '\n' < "$p/environ" | sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p')"
				[ -n "$bus" ] || continue
				su -s /bin/sh gdm -c "DBUS_SESSION_BUS_ADDRESS='$bus' gdbus call --session \
					--dest org.gnome.Mutter.DisplayConfig --object-path /org/gnome/Mutter/DisplayConfig \
					--method org.gnome.Mutter.DisplayConfig.GetCurrentState" 2>/dev/null \
					| grep -o "('[0-9]*x[0-9]*@[0-9.]*', [^)]*'is-current': <true>" | cut -d"'" -f2
				return 0
			done
		}
		echo "LAZARO-GDM-MODO $(modo_gdm)"
		# Datos breves por si falla (qemu.sh los muestra solo entonces).
		echo "--- datos de GDM ---"
		rc-service pantalla-inicio-gdm status 2>&1
		stat -c '%n acceso=%x cambio=%y' /var/lib/gdm/.config/monitors.xml /home/prueba/.config/monitors.xml 2>&1
		echo "- greeter.log:"
		grep -iE 'monitor|config' /var/log/gdm/greeter.log 2>/dev/null | head -n 20
		echo "--- fin de los datos ---"
	elif [ -n "$pdm" ]; then
		# 1) La sesión debe anotar la resolución que eligió.
		t=0
		until grep -qs 800x600 /home/prueba/.config/pantalla-inicio || [ $t -ge 240 ]; do
			sleep 3
			t=$((t + 3))
		done
		idioma_sesion
		if grep -qs 800x600 /home/prueba/.config/pantalla-inicio; then
			echo "LAZARO-GUARDADO-OK"
		else
			echo "LAZARO-GUARDADO-NO"
			echo "--- diagnóstico del guardado ---"
			cat /home/prueba/.config/pantalla-inicio 2>&1
			ps -ef 2>/dev/null | grep -E '[g]uardar|[x]fce4-session|[m]ate-session|[p]lasma|[k]win|[l]ightdm|[s]ddm'
			loginctl list-sessions --no-pager 2>&1 | cat
			for pid in $(pgrep -f pantalla-inicio/guardar); do
				tr '\0' '\n' < /proc/$pid/environ | grep -E '^(DISPLAY|XAUTHORITY|XDG_SESSION_ID|WAYLAND_DISPLAY|HOME)='
			done
			echo "- cambio a 800x600:"
			tail -n 30 /tmp/prueba-800x600.log 2>&1
			echo "- guardar:"
			tail -n 40 /tmp/guardar-traza.log 2>&1
			echo "- lightdm (inicio automático):"
			grep -iE 'autolog|prueba|fail|error' /var/log/lightdm/lightdm.log 2>&1 | head -n 25
			tail -n 15 /var/log/lightdm/x-0.log 2>/dev/null
			ls -la /home/prueba/.xsession-errors 2>/dev/null && tail -n 20 /home/prueba/.xsession-errors
			echo "--- fin del diagnóstico ---"
		fi
		# 2) Se cierra la sesión (sin volver a entrar sola).
		rm -f /etc/lightdm/lightdm.conf.d/90-lazaro-prueba.conf /etc/sddm.conf.d/90-lazaro-prueba.conf
		# Los Xorg de la sesión del usuario: no cuentan como saludo.
		viejos=" $(ps -eo pid,args | awk '/[X]org/ { printf "%s ", $1 }')"
		if [ "$pdm" = sddm ]; then
			# Como al cerrar sesión: SDDM vuelve a su pantalla de
			# inicio (sin "Relogin" no entra sola de nuevo).
			loginctl terminate-user prueba >/dev/null 2>&1
		else
			rc-service lightdm restart >/dev/null 2>&1
		fi
		# Se reintenta: X puede tardar en aceptar conexiones y la
		# resolución se aplica justo antes de mostrar el saludo.
		# La llave de X queda atada al nombre del equipo, que cambia
		# al arrancar: se usa una copia válida para cualquier nombre
		# (familia "ffff"). La llave y la pantalla salen de Xorg.
		llave=/tmp/lazaro-llave-x
		t=0
		modo=""
		while [ "$modo" != 800x600 ] && [ $t -lt 120 ]; do
			sleep 3
			t=$((t + 3))
			x="$(ps -eo pid,args | awk -v viejos="$viejos" '/[X]org/ && index(viejos, " " $1 " ") == 0 { for (i = 3; i <= NF; i++) { if ($i ~ /^:[0-9]+$/) d = $i; if ($i == "-auth") a = $(i + 1) } } END { print d, a }')"
			pantalla="${x%% *}"
			rm -f "$llave"
			xauth -f "${x#* }" nlist 2>/dev/null | sed 's/^..../ffff/' \
				| xauth -f "$llave" nmerge - 2>/dev/null
			modo="$(DISPLAY="${pantalla:-:0}" XAUTHORITY="$llave" xrandr --current 2>/dev/null \
				| awk '$2 == "connected" { for (i = 3; i <= NF; i++) if ($i ~ /^[0-9]+x[0-9]+[+]/) { sub(/[+].*/, "", $i); print $i; exit } }')"
		done
		echo "LAZARO-PANTALLA-${modo:-desconocida}"
		if [ "$modo" != 800x600 ]; then
			echo "--- diagnóstico de la resolución ---"
			command -v xrandr || echo "sin xrandr"
			echo "Xorg: $x"
			ls -la /usr/local/libexec/pantalla-inicio 2>&1
			cat /etc/lightdm/lightdm.conf.d/50-pantalla-inicio.conf /etc/sddm.conf.d/50-pantalla-inicio.conf 2>/dev/null
			ps -ef 2>/dev/null | grep -E '[X]org|[l]ightdm|[s]ddm'
			command -v xauth || echo "sin xauth"
			DISPLAY="${pantalla:-:0}" XAUTHORITY="$llave" xrandr --current 2>&1 | head -n 5
			grep pantalla-inicio /var/log/messages 2>/dev/null | tail -n 5
			tail -n 25 /var/log/lightdm/lightdm.log 2>/dev/null
			grep -i sddm /var/log/messages 2>/dev/null | tail -n 25
			echo "--- fin del diagnóstico ---"
		fi
	else
		echo "LAZARO-PANTALLA-SIN-AJUSTE"
	fi
	# Pantalla de inicio greetd (Sway, XFCE Wayland): debe mostrarse
	# gtkgreet, en el idioma elegido, y dejar entrar a la sesión.
	if grep -qs 'gtkgreet' /etc/greetd/config.toml; then
		grep '^command' /etc/greetd/config.toml
		t=0
		until cat /proc/[0-9]*/comm 2>/dev/null | grep -qx gtkgreet || [ $t -ge 120 ]; do
			sleep 3
			t=$((t + 3))
		done
		if cat /proc/[0-9]*/comm 2>/dev/null | grep -qx gtkgreet; then
			# El idioma que de verdad usa gtkgreet (su LANG), no solo
			# lo que dice la configuración.
			for c in /proc/[0-9]*/comm; do
				[ "$(cat "$c" 2>/dev/null)" = gtkgreet ] || continue
				idioma_saludo="$(tr '\0' '\n' < "${c%/comm}/environ" 2>/dev/null | sed -n 's/^LANG=//p')"
				break
			done
			echo "LAZARO-GTKGREET-LANG ${idioma_saludo:-sin-LANG}"
			grep -qs '^command = "env LANG=es_CO.UTF-8 ' /etc/greetd/config.toml \
				&& [ "$idioma_saludo" = es_CO.UTF-8 ] \
				&& echo "LAZARO-GREETD-IDIOMA-OK"
			sleep 10
			echo "LAZARO-GTKGREET-LISTO"
			# qemu.sh toma la captura de la pantalla de inicio.
			sleep 10
		else
			echo "LAZARO-GTKGREET-NO"
		fi
		# Entrar como "prueba" sin escribir la contraseña: lo mismo
		# que hace gtkgreet al aceptar el usuario.
		ses="$(head -n 1 /etc/greetd/environments 2>/dev/null)"
		if [ -n "$ses" ]; then
			printf '\n[initial_session]\ncommand = "%s"\nuser = "prueba"\n' "$ses" \
				>> /etc/greetd/config.toml
			# greetd usa initial_session solo la primera vez que
			# arranca: lo recuerda en su runfile.
			rm -f /run/greetd.run
			rc-service greetd restart
			t=0
			# "dbus-run-session sway" -> el proceso se llama "sway".
			proc="${ses##* }"
			until cat /proc/[0-9]*/comm 2>/dev/null | grep -qx "$proc" || [ $t -ge 120 ]; do
				sleep 3
				t=$((t + 3))
			done
			if cat /proc/[0-9]*/comm 2>/dev/null | grep -qx "$proc"; then
				sleep 20
				echo "LAZARO-SESION-GREETD-OK $ses"
				# Sway: barra waybar con el icono de wifi (nm-applet).
				if [ "$proc" = sway ]; then
					for b in waybar nm-applet polkit-gnome-au; do
						cat /proc/[0-9]*/comm 2>/dev/null | grep -qx "$b" \
							&& echo "LAZARO-SWAY-CORRE $b"
					done
					cat /etc/sway/config.d/*.conf 2>/dev/null
					# Lista de atajos del botón de la barra, en español.
					LANG=es_CO.UTF-8 HOME=/home/prueba sway-atajos --lista 2>&1 \
						| grep -q 'Super+F1  →  Ver esta lista de atajos' \
						&& echo "LAZARO-SWAY-CORRE atajos"
				fi
			else
				echo "LAZARO-SESION-GREETD-NO $ses"
				grep -iE 'greetd|sway|seat|logind' /var/log/messages 2>/dev/null | tail -n 30
			fi
		fi
	fi
	for s in lightdm sddm gdm greetd; do
		rc-service --exists "$s" && rc-service "$s" status
	done
	# El servicio de SDDM de Alpine espera solo 2 segundos a la
	# pantalla de inicio: en una máquina lenta OpenRC lo marca como
	# fallido aunque esté corriendo. Se mira el proceso.
	for s in lightdm sddm gdm greetd; do
		cat /proc/[0-9]*/comm 2>/dev/null | grep -qx "$s" && echo "LAZARO-DM-ACTIVO $s"
	done
	# Ajustes del afinador en el sistema en marcha: el servicio puso la
	# protección de memoria y el arranque trae preempt=full (con
	# escritorio), que el kernel confirma con "Dynamic Preempt: full".
	echo "LAZARO-AFINADOR-ARRANQUE $(dmesg | grep -o 'Dynamic Preempt: [a-z]*' | tail -n 1) ttl=$(cat /sys/kernel/mm/lru_gen/min_ttl_ms 2>/dev/null)"
	# Manual de Lázaro: el PDF y su acceso en el menú, en el sistema
	# instalado (la ISO de GitHub Actions siempre lo trae).
	if [ "$(head -c 5 /usr/share/doc/lazaro/manual-lazaro.pdf 2>/dev/null)" = "%PDF-" ] &&
		[ -x /usr/local/bin/lazaro-manual ] && [ -r /usr/share/applications/lazaro-manual.desktop ]; then
		echo "LAZARO-MANUAL-OK $(wc -c < /usr/share/doc/lazaro/manual-lazaro.pdf) bytes"
	else
		echo "LAZARO-MANUAL-NO"
	fi
	# Informe de diagnóstico (lazaro-diagnostico, como root): debe dejar
	# un archivo con sus secciones. Y la ISO dejó su sello de compilación
	# (con fecha) en el sistema instalado. Se mira el archivo y no el
	# informe: con internet, lazaro-diagnostico puede venir del
	# repositorio de Lázaro (la versión publicada de main).
	if [ -z "$reiniciar" ]; then
		diag_sal="$(timeout 300 /usr/local/sbin/lazaro-diagnostico 2>&1 | sed -n 's/^Listo: //p')"
		if [ -n "$diag_sal" ] && grep -q '==== Servicios (OpenRC)' "$diag_sal" 2>/dev/null &&
			grep -q '^LAZARO_FECHA="[0-9]' /usr/share/lazaro/version.env; then
			echo "LAZARO-DIAGNOSTICO-OK $(wc -l < "$diag_sal") líneas"
			rm -f "$diag_sal"
		else
			echo "LAZARO-DIAGNOSTICO-NO ${diag_sal:-sin archivo}"
		fi
	fi
	# Bienvenida: con escritorio, el programa quedó instalado, sus
	# archivos de funciones están bien escritos y Python encuentra GTK 3
	# (sin eso la ventana no abre).
	# El Actualizador depende del programa que instala el script de
	# escritorio. Sin internet ese script aún no corrió (se hace al
	# primer arranque con red) y el botón queda escondido: ahí basta con
	# que la ventana esté instalada.
	actualizador_listo() {
		if [ -x /usr/local/bin/alpine-update-root.sh ]; then
			/usr/local/sbin/lazaro-actualizador --comprobar
		else
			[ -x /usr/local/sbin/lazaro-actualizador ] &&
				echo "actualizador: instalado, falta la configuración final"
		fi
	}
	if [ -x /usr/local/sbin/lazaro-bienvenida ]; then
		bien="$(/usr/local/sbin/lazaro-bienvenida --comprobar 2>&1)" &&
			bien="$bien; $(python3 -c 'import gi; gi.require_version("Gtk", "3.0"); from gi.repository import Gtk; print("GTK", Gtk.get_minor_version())' 2>&1)" &&
			[ -e /etc/xdg/autostart/lazaro-bienvenida.desktop ] &&
			bien="$bien; $(actualizador_listo 2>&1)" &&
			echo "LAZARO-BIENVENIDA-OK $bien" ||
			echo "LAZARO-BIENVENIDA-NO $(printf '%s' "$bien" | tail -n 2 | tr '\n' ' ')"
	fi
	# doas: la regla de administradores es válida, se aplica al usuario
	# y conserva el idioma (LANG). doas -C lee el archivo como el
	# usuario, así que se revisa una copia legible.
	install -m644 /etc/doas.d/20-wheel.conf /tmp/doas-prueba.conf 2>/dev/null
	doas_c="$(su prueba -c 'doas -C /tmp/doas-prueba.conf true' 2>&1)"
	rm -f /tmp/doas-prueba.conf
	if [ "$doas_c" = permit ] && grep -q 'setenv { LANG' /etc/doas.d/20-wheel.conf 2>/dev/null; then
		echo "LAZARO-DOAS-OK"
	else
		echo "LAZARO-DOAS-NO $(printf '%s' "$doas_c" | head -n 2 | tr '\n' ' ')"
	fi
	# Idioma de la sesión (si no se miró antes de cerrarla).
	[ -n "$reiniciar" ] || idioma_sesion
	[ -n "$reiniciar" ] || echo "LAZARO-PRUEBA-FIN"
} > /dev/ttyS0 2>&1
if [ -n "$reiniciar" ]; then
	reboot
	exit 0
fi
sleep 20
poweroff
