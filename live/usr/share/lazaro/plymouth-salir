#!/sbin/openrc-run
# Lázaro Linux: cierra la pantalla de arranque (Plymouth) justo antes de
# la pantalla de inicio de sesión. Si Plymouth sigue en pie, o deja su
# imagen puesta (--retain-splash), GNOME arranca su pantalla de inicio
# en la resolución del monitor y no en la que eligió el usuario.

description="Cierra la pantalla de arranque antes de la de inicio de sesión"

depend() {
	before gdm lightdm sddm greetd
}

start() {
	command -v plymouth >/dev/null 2>&1 || return 0
	plymouth --ping 2>/dev/null || return 0
	ebegin "Cerrando la pantalla de arranque"
	plymouth quit
	eend 0
}
