#!/sbin/openrc-run
# Termina la configuración de Lázaro Linux (desktop-postinstall.sh) en
# cuanto haya internet, si no se pudo durante la instalación. Corre en
# segundo plano para no retrasar el arranque; al terminar bien enciende
# los servicios nuevos (pantalla de inicio incluida) y se desactiva.
# Registro: /var/log/lazaro-primer-arranque.log. Si no hay red en 30 minutos, lo
# intenta en el siguiente arranque.

description="Configuración final de Lázaro Linux"

depend() {
	after networkmanager
}

start() {
	ebegin "Lázaro Linux: la configuración final se hará al tener internet"
	(
		repo="$(grep -m1 '^http' /etc/apk/repositories)"
		indice="$repo/$(apk --print-arch)/APKINDEX.tar.gz"
		i=0
		while [ $i -lt 360 ]; do
			if wget -q --spider -T 8 "$indice"; then
				if /usr/libexec/lazaro/lazaro-postinstalacion; then
					rc-update del lazaro-primer-arranque default
					# Fuera el aviso de la consola (ver lazaro-instalar).
					for f in issue motd; do
						[ -e "/etc/lazaro/$f.original" ] || continue
						cp -p "/etc/lazaro/$f.original" "/etc/$f" \
							&& rm -f "/etc/lazaro/$f.original"
					done
					# Lo que el script dejó en el arranque (elogind,
					# polkit, cupsd, la pantalla de inicio...) no corría
					# en este arranque: se enciende ya, sin pedir otro
					# reinicio. La pantalla de inicio va al final. Se
					# llama fuera del entorno de este servicio: con las
					# variables de OpenRC heredadas, rc-service no
					# enciende las dependencias ("greetd ... seatd would
					# not start").
					limpio="env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin"
					dms=""
					for s in /etc/runlevels/default/*; do
						s="${s##*/}"
						case "$s" in
							lazaro-primer-arranque) continue ;;
							lightdm|sddm|gdm|greetd) dms="$dms $s"; continue ;;
						esac
						$limpio rc-service -q "$s" status || $limpio rc-service "$s" start
					done
					# Si se pidió el inicio automático, también para
					# la pantalla de inicio que el script acaba de poner.
					[ ! -x /usr/libexec/lazaro/lazaro-autologin ] \
						|| /usr/libexec/lazaro/lazaro-autologin
					for s in $dms; do
						$limpio rc-service -q "$s" status || $limpio rc-service "$s" start
					done
				fi
				exit 0
			fi
			i=$((i + 1))
			sleep 5
		done
	) >>/var/log/lazaro-primer-arranque.log 2>&1 </dev/null &
	eend 0
}
