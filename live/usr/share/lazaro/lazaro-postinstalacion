#!/bin/sh
# Experimento (no fusionar): ejecuta desktop-postinstall.sh con OPCIONES
# (--minimo --con ...) en vez de variables OPT_*. Con --argumentos solo
# imprime las opciones (lazaro-instalar las usa con --destino).
env_file="${LAZARO_ENV:-/etc/lazaro/postinstall.env}"
# Sin "set -a": las variables NO pasan al script por el entorno.
. "$env_file"
con=""
[ "$OPT_CUPS" = yes ] && con="$con,impresoras"
[ "$OPT_LIBREOFFICE" = yes ] && con="$con,libreoffice"
[ "$OPT_FIREFOX" = yes ] && con="$con,firefox"
[ "$OPT_FLATPAK" = yes ] && con="$con,flatpak"
[ "$OPT_ONLYOFFICE" = yes ] && con="$con,onlyoffice"
[ "$OPT_CHROME" = yes ] && con="$con,chrome"
[ "$OPT_BRAVE" = yes ] && con="$con,brave"
[ "$OPT_UPDATE_SHORTCUT" = yes ] && con="$con,actualizaciones"
for e in ${LAZARO_EXTRAS_APK:-}; do con="$con,$e"; done
args="--minimo --idioma $OPT_LANG --usuario $DOAS_USER --nvidia $OPT_NVIDIA_MODE"
if [ "$OPT_KEYBOARD" = yes ]; then args="$args --teclado latam"; else args="$args --teclado no"; fi
[ -z "$con" ] || args="$args --con ${con#,}"
if [ "${1:-}" = "--argumentos" ]; then
	echo "$args"
	exit 0
fi
echo "desktop-postinstall.sh $args"
# shellcheck disable=SC2086
exec /bin/sh /usr/libexec/lazaro/desktop-postinstall.sh $args </dev/null
