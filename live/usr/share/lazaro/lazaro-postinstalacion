#!/bin/sh
# Primer arranque: ejecuta desktop-postinstall.sh con las opciones que dejó
# el instalador en /etc/lazaro/postinstall.args (si durante la instalación
# no hubo internet o el script falló). El propio script deja la carpeta
# personal a nombre del usuario.
args="$(cat /etc/lazaro/postinstall.args)"
echo "desktop-postinstall.sh $args"
# shellcheck disable=SC2086
exec /bin/sh /usr/libexec/lazaro/desktop-postinstall.sh $args </dev/null
