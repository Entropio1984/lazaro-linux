[Desktop Entry]
Type=Application
Name=Controladores
Name[en]=Drivers
Name[pt_BR]=Drivers
GenericName=Controladores del hardware
GenericName[en]=Hardware drivers
GenericName[pt_BR]=Drivers do hardware
Comment=Revisa el equipo e instala lo que le falta (wifi, impresoras, sonido, huellas...)
