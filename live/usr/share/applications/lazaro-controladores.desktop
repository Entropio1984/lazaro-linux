Comment[pt_BR]=Verifica o computador e instala o que falta (wi-fi, impressoras, som, digitais...)
Exec=lazaro-controladores --ventana
Icon=system-software-install
Terminal=false
Categories=System;Settings;HardwareSettings;
Keywords=drivers;controladores;firmware;wifi;impresora;hardware;
