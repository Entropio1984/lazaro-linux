#!/sbin/openrc-run
# Prepara la sesión live de Lázaro Linux: usuario "lazaro" con inicio
# automático, acceso directo al instalador y, en las pruebas automáticas
# (QEMU), avisos por el puerto serie e instalación desatendida.

description="Sesión live de Lázaro Linux"

depend() {
	need localmount
	after udev-settle
	before lightdm
}

# Todo lo que va al puerto serie (avisos para las pruebas en QEMU) pasa
# por aquí, y solo se escribe si el puerto existe:
#   serie TEXTO...           una línea
#   ORDEN | serie            la salida de una orden
#   serie -- ORDEN [ARGS]    ejecuta la orden con su salida al puerto y
#                            devuelve su resultado
serie() {
	if [ "${1:-}" = -- ]; then
		shift
		if [ -c /dev/ttyS0 ]; then
			"$@" > /dev/ttyS0 2>&1
		else
			"$@" > /dev/null 2>&1
		fi
		return
	fi
	if [ ! -c /dev/ttyS0 ]; then
		[ $# -gt 0 ] || cat > /dev/null
		return 0
	fi
	if [ $# -gt 0 ]; then
		printf '%s\n' "$*"
	else
		cat
	fi > /dev/ttyS0 2>/dev/null || true
}

parametro() {
	# Valor de "nombre=valor" en la línea de comandos del kernel.
	for p in $(cat /proc/cmdline); do
		case "$p" in "$1"=*) echo "${p#*=}"; return 0 ;; esac
	done
	return 1
}

revisar_discos() {
	# Calamares escribe en su registro la lista de discos donde se puede
	# instalar (después de "LIST OF DETECTED DEVICES:"). Si está vacía, la
	# bienvenida bloquea con "There are no partitions to install on".
	registro=""
	i=0
	while [ $i -lt 24 ]; do
		registro=$(find /root/.cache -name session.log 2>/dev/null | head -n 1)
		[ -n "$registro" ] && grep -q 'LIST OF DETECTED DEVICES' "$registro" && break
		i=$((i + 1))
		sleep 5
	done
	if [ -n "$registro" ] && grep -A 4 'LIST OF DETECTED DEVICES' "$registro" |
		grep -q '/dev/'; then
		serie "LAZARO-DISCOS-OK"
	else
		serie "LAZARO-DISCOS-FALLO"
		# Para saber por qué: memoria, si el núcleo cerró algún programa
		# por falta de memoria, si Calamares sigue abierto y qué escribió.
		serie -- free -m
		serie -- df -m /
		dmesg | grep -i -e 'out of memory' -e oom -e 'killed process' | tail -n 20 | serie
		for c in /proc/[0-9]*/cmdline; do
			tr '\0' ' ' < "$c" 2>/dev/null | grep -q 'calamares' && echo "calamares vivo: ${c%/cmdline}"
		done | serie
		[ -z "$registro" ] && serie "sin session.log" || tail -n 40 "$registro" | serie
	fi
	# Todas las pantallas y pasos de settings.conf tienen que cargar (por
	# ejemplo netinstall y el módulo propio lazaroextras).
	if [ -n "$registro" ] && grep -q -e 'not found in module search paths' \
		-e 'exists but not loaded' -e 'cannot be created from descriptor' \
		-e 'loading FAILED' "$registro"; then
		serie "LAZARO-MODULOS-FALLO"
		serie -- grep -e 'not found in module' -e 'not loaded' -e 'cannot be created' -e 'loading FAILED' "$registro"
	elif [ -n "$registro" ]; then
		serie "LAZARO-MODULOS-OK"
	fi
	serie -- lsblk --nodeps --paths --json --output type,name
	[ -z "$registro" ] || serie -- grep -A 4 'LIST OF DETECTED DEVICES' "$registro"
	return 0
}

# La live no debe apagar la pantalla ni suspenderse: se pregunta a
# elogind qué hará con la inactividad y la tapa, y se mira en el registro
# de Xorg que el ahorro de energía del monitor (DPMS) quedó apagado.
revisar_energia() {
	energia=""
	for p in IdleAction HandleLidSwitch HandleSuspendKey; do
		v=$(dbus-send --system --print-reply --dest=org.freedesktop.login1 \
			/org/freedesktop/login1 org.freedesktop.DBus.Properties.Get \
			string:org.freedesktop.login1.Manager "string:$p" 2>/dev/null |
			sed -n 's/.*string "\(.*\)"/\1/p')
		energia="$energia $p=${v:-?}"
	done
	if [ "$energia" = " IdleAction=ignore HandleLidSwitch=ignore HandleSuspendKey=ignore" ]; then
		serie "LAZARO-ELOGIND-OK"
	else
		serie "LAZARO-ELOGIND-NO$energia"
	fi
	if grep -qs 'Extension "DPMS" is disabled' /var/log/Xorg.0.log /var/log/lightdm/x-0.log; then
		serie "LAZARO-DPMS-OK"
	else
		serie "LAZARO-DPMS-NO"
		serie -- grep -h -i -e dpms -e blank -e 'xorg.conf.d' /var/log/Xorg.0.log /var/log/lightdm/x-0.log
	fi
}

start() {
	ebegin "Preparando la sesión live de Lázaro Linux"
	if ! id lazaro >/dev/null 2>&1; then
		addgroup -S autologin 2>/dev/null || true
		adduser -D -g "Lázaro Linux" -s /bin/ash lazaro
		passwd -d lazaro >/dev/null
		for g in autologin wheel audio video netdev input plugdev users; do
			addgroup lazaro "$g" 2>/dev/null || true
		done
	fi
	# Sin salvapantallas en la live: apagaba y bloqueaba la pantalla a
	# los pocos minutos aunque la instalación siguiera trabajando (y el
	# usuario lazaro no tiene contraseña para desbloquearla).
	mkdir -p /home/lazaro/.config/autostart
	printf '[Desktop Entry]\nType=Application\nName=xfce4-screensaver\nHidden=true\n' \
		> /home/lazaro/.config/autostart/xfce4-screensaver.desktop
	# El administrador de energía de XFCE apagaba la pantalla a los 10
	# minutos por su cuenta: en modo presentación no apaga ni suspende
	# nada, y deja la tapa a elogind (que en la live la ignora).
	xfpm=/home/lazaro/.config/xfce4/xfconf/xfce-perchannel-xml
	mkdir -p "$xfpm"
	cat > "$xfpm/xfce4-power-manager.xml" <<-'EOF'
		<?xml version="1.0" encoding="UTF-8"?>
		<channel name="xfce4-power-manager" version="1.0">
		  <property name="xfce4-power-manager" type="empty">
		    <property name="presentation-mode" type="bool" value="true"/>
		    <property name="dpms-enabled" type="bool" value="false"/>
		    <property name="blank-on-ac" type="int" value="0"/>
		    <property name="blank-on-battery" type="int" value="0"/>
		    <property name="inactivity-on-ac" type="uint" value="14"/>
		    <property name="inactivity-on-battery" type="uint" value="14"/>
		    <property name="logind-handle-lid-switch" type="bool" value="true"/>
		    <property name="sleep-button-action" type="uint" value="0"/>
		    <property name="hibernate-button-action" type="uint" value="0"/>
		  </property>
		</channel>
	EOF
	escritorio=/home/lazaro/Escritorio
	mkdir -p "$escritorio"
	cp /usr/share/applications/lazaro-instalador.desktop "$escritorio"/
	chmod +x "$escritorio"/lazaro-instalador.desktop
	chown -R lazaro:lazaro /home/lazaro
	serie "LAZARO-LIVE-LISTO"
	# Cuánto ocupa la sesión live en la RAM y cuánto le queda.
	serie "LAZARO-RAIZ $(df -m / | awk 'NR == 2 { print "usado=" $3 "MB total=" $2 "MB" }')"
	# "doas" debe dar root al usuario de la sesión (doas.d/lazaro-live.conf)
	# para cualquier orden: se pide una que no sea la de Calamares y se
	# mira que corra como UID 0.
	if [ "$(su -s /bin/sh lazaro -c 'doas -n /bin/sh -c "id -u"' 2>/dev/null)" = 0 ]; then
		serie "LAZARO-DOAS-OK"
	else
		serie "LAZARO-DOAS-NO"
	fi

	# En una máquina virtual con SPICE (Virt Manager): el agente que
	# comparte el portapapeles con el equipo anfitrión. En un equipo real
	# no existe ese puerto y no se arranca.
	if [ -e /dev/virtio-ports/com.redhat.spice.0 ]; then
		rc-service spice-vdagentd start >/dev/null 2>&1 || true
	fi

	# Aviso para las pruebas: Calamares llegó a abrirse en pantalla.
	(
		i=0
		while [ $i -lt 120 ]; do
			if pidof calamares >/dev/null 2>&1; then
				serie "LAZARO-CALAMARES-ABIERTO"
				# Nada debe apagar la pantalla mientras se instala.
				if pidof xfce4-screensaver >/dev/null 2>&1; then
					serie "LAZARO-SALVAPANTALLAS-ACTIVO"
				else
					serie "LAZARO-SALVAPANTALLAS-NO"
				fi
				revisar_energia
				revisar_discos
				# Portapapeles compartido: el servicio y el agente de la
				# sesión del usuario deben estar corriendo.
				if [ -e /dev/virtio-ports/com.redhat.spice.0 ]; then
					# El agente de la sesión puede arrancar un poco después.
					j=0
					until { pidof spice-vdagentd && pidof spice-vdagent; } >/dev/null 2>&1 || [ $j -ge 12 ]; do
						j=$((j + 1))
						sleep 5
					done
					if pidof spice-vdagentd >/dev/null 2>&1 && pidof spice-vdagent >/dev/null 2>&1; then
						serie "LAZARO-SPICE-OK"
					else
						serie "LAZARO-SPICE-NO"
						ps -ef 2>&1 | grep -i '[s]pice' | serie
						serie -- ls /etc/xdg/autostart
					fi
				fi
				exit 0
			fi
			i=$((i + 1))
			sleep 5
		done
		serie "LAZARO-CALAMARES-NO-ABRIO"
	) &

	# Instalación desatendida, solo para pruebas:
	#   lazaro.autoinstall=ESCRITORIO lazaro.disco=/dev/vda
	if de=$(parametro lazaro.autoinstall) && disco=$(parametro lazaro.disco); then
		(
			if serie -- env LAZARO_KERNELOPTS="console=tty0 console=ttyS0,115200 plymouth.ignore-serial-consoles" \
				lazaro-instalar auto "$disco" "$de"; then
				serie "LAZARO-AUTOINSTALL-OK"
			else
				serie "LAZARO-AUTOINSTALL-FALLO"
				serie -- tail -n 80 /var/log/lazaro-instalar.log
			fi
			sync
			poweroff
		) &
	fi
	eend 0
}
