# Maintainer: Julián <173747797+Entropio1984@users.noreply.github.com>
#
# Quickshell: la base de Claudito Shell Fusion, la barra de Sway de Lázaro
# (paquete lazaro-claudito). No está en Alpine (ni 3.24 ni edge; revisado
# en aports el 2026-11-24); Chimera Linux (también con musl) y Void lo
# empaquetan sin parches. Compila en unos 7 minutos.
#
# - CLI11 (solo cabeceras) no está en Alpine: se arma dentro del paquete.
# - cpptrace tampoco: se apaga el informe de fallos (CRASH_HANDLER=OFF).
# - Quickshell usa partes internas de Qt: hay que recompilarlo cada vez que
#   Alpine cambia de versión de Qt. Deja anotada en
#   /usr/share/quickshell/qt-version la versión con la que se compiló: el
#   repositorio de Lázaro lo recompila cuando Alpine la cambia. No se fija
#   con una dependencia exacta: eso trabaría "Actualizar el sistema"
#   entero hasta tener el Quickshell nuevo.
pkgname=quickshell
pkgver=0.3.2
pkgrel=0
_cli11ver=2.5.0
pkgdesc="Herramientas QtQuick para barras y escritorios (compilado para Lázaro Linux)"
url="https://quickshell.org"
arch="x86_64"
license="LGPL-3.0-only"
depends="qt6-qtsvg"
makedepends="
	cmake
	samurai
	pkgconf
	qt6-qtbase-dev
	qt6-qtbase-private-dev
	qt6-qtdeclarative-dev
	qt6-qtdeclarative-private-dev
	qt6-qtwayland-dev
	qt6-qtshadertools-dev
	qt6-qtsvg-dev
	spirv-tools
	wayland-dev
	wayland-protocols
	libdrm-dev
	mesa-dev
	vulkan-headers
	libxcb-dev
	pipewire-dev
	linux-pam-dev
	polkit-dev
	glib-dev
	jemalloc-dev
	"
options="!check"
source="quickshell-$pkgver.tar.gz::https://git.outfoxxed.me/quickshell/quickshell/archive/v$pkgver.tar.gz
	CLI11-$_cli11ver.tar.gz::https://github.com/CLIUtils/CLI11/archive/refs/tags/v$_cli11ver.tar.gz
	"
builddir="$srcdir/quickshell"

prepare() {
	default_prepare
	cmake -S "$srcdir/CLI11-$_cli11ver" -B "$srcdir/cli11-build" -G Ninja \
		-DCMAKE_INSTALL_PREFIX="$srcdir/cli11" \
		-DCLI11_BUILD_TESTS=OFF -DCLI11_BUILD_EXAMPLES=OFF -DCLI11_BUILD_DOCS=OFF
	cmake --build "$srcdir/cli11-build"
	cmake --install "$srcdir/cli11-build"
}

build() {
	cmake -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DCMAKE_PREFIX_PATH="$srcdir/cli11" \
		-DDISTRIBUTOR="Lázaro Linux" \
		-DINSTALL_QML_PREFIX=lib/qt6/qml \
		-DCRASH_HANDLER=OFF \
		-DBUILD_TESTING=OFF \
		-DNO_PCH=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	# Con qué Qt se compiló: el repositorio de Lázaro lo recompila cuando
	# Alpine cambia esa versión (y lazaro-claudito vuelve a waybar si
	# Quickshell no arranca).
	awk '/^P:/ { p = ($0 == "P:qt6-qtdeclarative") } p && /^V:/ { print substr($0, 3); exit }' \
		/lib/apk/db/installed > "$srcdir/qt-version"
	[ -s "$srcdir/qt-version" ] || die "no se sabe la versión de qt6-qtdeclarative"
	install -Dm644 "$srcdir/qt-version" "$pkgdir/usr/share/quickshell/qt-version"
}

sha512sums="
c1f945af518bcdde69eb3084e4c845da2bf63b9396f197d6d97d3c71b3651e6b457adbf6b6e988bfd478d5b3963bb902cb1e3d2897a1407e260456a0afe2c99f  quickshell-0.3.2.tar.gz
895fb61e4c9974ee8e8d4681fb880a10126a412f24bb147d558d465d78fe784a044c5443edf1ce20fc9936901073073d795b034e0c02bdb3c8aa74c9d6ac811c  CLI11-2.5.0.tar.gz
"
