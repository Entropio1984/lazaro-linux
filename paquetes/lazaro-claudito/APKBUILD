# y revisar que lazaro.patch siga aplicando.
#
# Solo se baja lo que usa la barra de Sway (GitLab entrega carpetas
# sueltas del repositorio, que entero pesa 1,2 GB):
#   - .config/quickshell: la barra sway-bar y sus ajustes de entrada,
#   - los iconos Reversal-blue y Reversal-blue-dark (modo claro y oscuro),
#   - el fondo claudito-01, claudito-theme (tema claro/oscuro para GTK y
#     Qt) y su paleta.
# lazaro.patch agrega a la barra el botón de actualizaciones (el aviso que
# tenía waybar).
pkgname=lazaro-claudito
_commit=3aaa56b9c7b6a0a2b85b8a99661f4ce0891b3bbb
_fecha=20261120
pkgver=0.$_fecha
pkgrel=0
pkgdesc="Claudito Shell Fusion: la barra y el escritorio de Sway en Lázaro Linux"
url="https://gitlab.com/linux-en-casa/claudito-shell-fusion"
arch="noarch"
license="GPL-3.0-only"
# Lo que usan los módulos de la barra (README de sway-bar): Quickshell, la
# fuente de los iconos, red (nmcli), batería (UPower), bloqueo (swaylock),
# brillo, música, notificaciones, portapapeles, el tema claro/oscuro
# (claudito-theme es de bash y usa adw-gtk3 y gsettings) y waybar, que
# queda por si Quickshell no arranca.
depends="
	quickshell
	font-jetbrains-mono-nerd
	bash
	adw-gtk3
	glib
	upower
	networkmanager-cli
	swaylock
	brightnessctl
	playerctl
	libnotify
	wl-clipboard
	waybar
	"
options="!check"
_url="https://gitlab.com/linux-en-casa/claudito-shell-fusion/-/archive/$_commit/claudito-shell-fusion-$_commit.tar.gz?path="
source="
	claudito-quickshell-$_fecha.tar.gz::$_url.config/quickshell
	claudito-iconos-claros-$_fecha.tar.gz::${_url}usr/share/icons/Reversal-blue
	claudito-iconos-oscuros-$_fecha.tar.gz::${_url}usr/share/icons/Reversal-blue-dark
	claudito-fondos-$_fecha.tar.gz::${_url}usr/share/wallpapers
	claudito-programas-$_fecha.tar.gz::${_url}usr/local/bin
	claudito-paleta-$_fecha.tar.gz::${_url}usr/share/claudito-shell
	lazaro.patch
	lazaro-claudito
	60-lazaro-claudito.conf
	"
builddir="$srcdir/claudito"

unpack() {
	# Cada carpeta viene en su propio archivo; se juntan en una sola.
	mkdir -p "$builddir"
	for f in $source; do
		case "${f%%::*}" in
		*.tar.gz) tar -xzf "$srcdir/${f%%::*}" -C "$builddir" --strip-components=1 ;;
		esac
	done
}

prepare() {
	default_prepare
}

package() {
	local d="$pkgdir/usr/share/lazaro/claudito"
	mkdir -p "$d"
	cp -r .config/quickshell/sway-bar "$d/"
	for f in bar-layout.tsv launcher-size.txt wallpaper-fillmode.txt; do
		install -m644 ".config/quickshell/$f" "$d/$f"
	done
	echo "$pkgver-r$pkgrel" > "$d/version"

	mkdir -p "$pkgdir/usr/share/icons"
	cp -r usr/share/icons/Reversal-blue usr/share/icons/Reversal-blue-dark "$pkgdir/usr/share/icons/"
	# En el repositorio de Claudito los iconos repetidos son copias (386 MB);
	# como enlaces quedan en unos 57 MB.
	(
		cd "$pkgdir/usr/share/icons"
		find Reversal-blue Reversal-blue-dark -type f -print0 | xargs -0 sha1sum | sort |
			awk '{ h = $1; sub(/^[^ ]+  /, ""); if (h == prev) print first "\t" $0; else { prev = h; first = $0 } }' |
			while IFS="$(printf '\t')" read -r original copia; do
				ln -sf "/usr/share/icons/$original" "$copia"
			done
	)
	install -Dm644 usr/share/wallpapers/claudito-01.png "$pkgdir/usr/share/wallpapers/claudito-01.png"
	install -Dm755 usr/local/bin/claudito-theme "$pkgdir/usr/bin/claudito-theme"
	install -Dm644 usr/share/claudito-shell/palette.conf "$pkgdir/usr/share/claudito-shell/palette.conf"

	install -Dm755 "$srcdir/lazaro-claudito" "$pkgdir/usr/bin/lazaro-claudito"
	install -Dm644 "$srcdir/60-lazaro-claudito.conf" "$pkgdir/etc/sway/config.d/60-lazaro-claudito.conf"
}

