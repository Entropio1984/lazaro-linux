diff -ruN a/quickshell/sway-bar/modules/LazaroActualizaciones.qml b/quickshell/sway-bar/modules/LazaroActualizaciones.qml
--- a/.config/quickshell/sway-bar/modules/LazaroActualizaciones.qml	1970-01-01 00:00:00.000000000 +0000
+++ b/.config/quickshell/sway-bar/modules/LazaroActualizaciones.qml	2026-11-24 02:42:36.880120340 +0000
@@ -0,0 +1,54 @@
+import QtQuick
+import Quickshell
+import Quickshell.Io
+
+// Lázaro Linux: aviso de actualizaciones del sistema, como el que tenía
+// waybar. Cuántas hay lo cuenta cada hora la tarea alpine-update-revisar
+// (desktop-postinstall.sh) en /var/lib/alpine-update/pendientes. Sin
+// actualizaciones el botón no se muestra; con un clic abre "Actualizar el
+// sistema".
+Rectangle {
+    id: root
+    property string screenName: ""
+    property int pendientes: 0
+    readonly property bool present: root.pendientes > 0
+    implicitWidth: label.implicitWidth + 14
+    implicitHeight: Scaling.pxFor(screenName, 22)
+    radius: Scaling.pxFor(screenName, 4)
+    color: mouseArea.containsMouse ? Theme.outline : Theme.surfaceContainerHigh
+
+    Process {
+        id: leer
+        command: ["sh", "-c", "cat /var/lib/alpine-update/pendientes 2>/dev/null || echo 0"]
+        stdout: StdioCollector {
+            onStreamFinished: {
+                const n = parseInt(text.trim())
+                root.pendientes = isNaN(n) ? 0 : n
+            }
+        }
+    }
+
+    Timer {
+        interval: 60000
+        running: true
+        repeat: true
+        triggeredOnStart: true
+        onTriggered: leer.running = true
+    }
+
+    Text {
+        id: label
+        anchors.centerIn: parent
+        text: " " + root.pendientes
+        font.family: "JetBrainsMono Nerd Font"
+        font.pixelSize: Scaling.pxFor(screenName, 13)
+        color: Theme.accent
+    }
+
+    MouseArea {
+        id: mouseArea
+        anchors.fill: parent
+        hoverEnabled: true
+        onClicked: Quickshell.execDetached(["sh", "-c", "exec /usr/local/bin/alpine-update-launcher.sh"])
+    }
+}
diff -ruN a/.config/quickshell/sway-bar/modules/KeybindsPopup.qml b/.config/quickshell/sway-bar/modules/KeybindsPopup.qml
--- a/.config/quickshell/sway-bar/modules/KeybindsPopup.qml	2026-11-24 09:53:36.374777324 +0000
+++ b/.config/quickshell/sway-bar/modules/KeybindsPopup.qml	2026-11-24 09:53:36.401265255 +0000
@@ -63,7 +63,18 @@
         root.loadError = ""
         root.includePaths = []
         reader.buffer = []
-        reader.command = ["sh", "-c", "cat \"" + root.configPath.replace(/"/g, "\\\"") + "\" 2>/dev/null"]
+        // Lázaro Linux: sin configuración propia en ~/.config/sway/config
+        // se lee la del sistema (/etc/sway/config), y también los archivos
+        // de sus "include" (/etc/sway/config.d/*), donde están los atajos
+        // de Lázaro y de Claudito.
+        reader.command = ["sh", "-c",
+            "f=\"$HOME/.config/sway/config\"; [ -r \"$f\" ] || f=/etc/sway/config\n" +
+            "grep -v '^[[:space:]]*include[[:space:]]' \"$f\"\n" +
+            "sed -n 's/^[[:space:]]*include[[:space:]][[:space:]]*//p' \"$f\" | while IFS= read -r g; do\n" +
+            "  eval \"set -- $g\"\n" +
+            "  for x in \"$@\"; do [ -f \"$x\" ] && grep -v '^[[:space:]]*include[[:space:]]' \"$x\"; done\n" +
+            "done\n" +
+            "true"]
         reader.running = true
     }
 
