#!/bin/sh
# Lo mismo que al instalar (post-install): una versión nueva puede traer
# arreglos en los servicios. El afinador solo se aplica si nunca corrió.
S=/usr/share/lazaro
# Con un archivo nuevo y mv: un programa que está corriendo (por ejemplo
# lazaro-repositorio, que llamó a apk) sigue leyendo su versión vieja.
mkdir -p /usr/local/sbin
for p in "$S"/programas/lazaro-*; do
	[ -f "$p" ] || continue
	n="/usr/local/sbin/${p##*/}"
	install -m755 "$p" "$n.nuevo" && mv -f "$n.nuevo" "$n"
done
for s in lazaro-controladores lazaro-afinador; do
	install -Dm755 "$S/$s.initd" "/etc/init.d/$s"
	[ -e "/etc/runlevels/default/$s" ] || ln -s "/etc/init.d/$s" "/etc/runlevels/default/$s" 2>/dev/null
done
[ ! -e /etc/init.d/lazaro-repositorio ] || [ -e /etc/runlevels/default/lazaro-repositorio ] ||
	ln -s /etc/init.d/lazaro-repositorio /etc/runlevels/default/lazaro-repositorio 2>/dev/null
install -Dm644 "$S/lazaro.rsa.pub" /etc/apk/keys/lazaro.rsa.pub
[ -e /etc/lazaro/sin-escritorio ] ||
	install -Dm644 "$S/lazaro-controladores-sesion.desktop" /etc/xdg/autostart/lazaro-controladores.desktop
# La Bienvenida se abre al iniciar sesión hasta que la persona desmarca
# la casilla (eso queda en su carpeta, no aquí).
[ -e /etc/lazaro/sin-escritorio ] ||
	install -Dm644 "$S/lazaro-bienvenida-sesion.desktop" /etc/xdg/autostart/lazaro-bienvenida.desktop
if [ ! -e /etc/lazaro/afinador.conf ] && [ -x /usr/local/sbin/lazaro-afinador ]; then
	/usr/local/sbin/lazaro-afinador --aplicar >/dev/null 2>&1 || true
fi
exit 0
